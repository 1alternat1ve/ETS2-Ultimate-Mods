# --- PAGE HOST: двойной буфер страниц + slide/fade transitions ---
# ==========================================
class PageHost:
    """
    Двойной буфер для main_content.

    Идея: мы держим ДВА фрейма-слота. В любой момент времени один на сцене,
    другой — за кадром. При переключении страницы:
      1. В off-screen слоте строим новый контент (пока пользователь видит старый)
      2. Когда контент готов — атомарно меняем слоты местами с slide-анимацией:
         старый уезжает влево, новый въезжает справа
      3. После анимации старый слот становится off-screen и готов под следующую страницу

    Это полностью убирает «чёрные вспышки» — пользователь никогда не видит пустой
    main_content без виджетов.

    Дополнительно: страницы кэшируются по ключу. Если страница уже в кэше —
    переключение мгновенное, без пересборки виджетов.

    Совместимость со старым кодом: self.main_content всегда указывает на
    активный слот, поэтому старые методы ETS2Manager работают без изменений.
    """

    def __init__(self, root: ctk.CTk, parent: ctk.CTkBaseClass,
                  sync_attr: Optional[str] = None):
        """
        root: CTk-окно (для after-вызовов)
        parent: контейнер, в котором живут оба слота
        sync_attr: имя атрибута на root, который надо обновлять = текущему front.
                    Это позволяет старому коду писать в self.main_content без знаний о PageHost.
        """
        self.root = root
        self.parent = parent
        self._sync_attr = sync_attr
        # Два слота: front (на сцене) и back (за кадром)
        self.front = ctk.CTkFrame(parent, fg_color="transparent")
        self.back = ctk.CTkFrame(parent, fg_color="transparent")
        # Front виден на месте, back — за пределами
        self.front.grid(row=0, column=1, sticky="nsew", padx=30, pady=20)
        # back тоже создаём с тем же grid, но скрываем сразу
        self.back.grid(row=0, column=1, sticky="nsew", padx=30, pady=20)
        self.back.grid_remove()
        self._sync_main_content()

        # Защита от двойных переключений во время анимации
        self._transition_busy = False
        self._pending_builder: Optional[Callable] = None

    @property
    def current(self) -> ctk.CTkFrame:
        """Текущий активный слот. Сюда страницы пишут содержимое."""
        return self.front

    def _sync_main_content(self):
        """
        Если задан sync_attr — обновляем атрибут на root.
        Это даёт старым методам (show_home и т.д.) видеть актуальный front
        через self.main_content без знаний о PageHost.
        """
        if self._sync_attr:
            try:
                setattr(self.root, self._sync_attr, self.front)
            except Exception:
                pass

    def begin_transition(self):
        """
        Inline-вариант: вызвать в начале show_xxx (там, где раньше был clear_content).
        После вызова self.front указывает на ПУСТОЙ off-screen слот.
        Старый front (с предыдущей страницей) остаётся на сцене и виден.
        Когда метод дальше пишет виджеты в self.main_content (=новый front) —
        они строятся за кадром.

        Анимация запускается асинхронно через after_idle: к моменту запуска
        главный поток успевает закончить отрисовку всех виджетов в новом слоте.
        """
        # Скрываем кнопку возврата при переключении страниц
        # Она показывается обратно только через _show_sync_return_btn()
        try:
            if hasattr(self, '_sync_return_btn'):
                self._sync_return_btn.place_forget()
        except Exception:
            pass

        if self._transition_busy:
            # Уже идёт анимация — на всякий случай чистим front-слот
            # (старый код всё равно ожидает пустой self.main_content)
            try:
                for w in self.front.winfo_children():
                    w.destroy()
            except Exception:
                pass
            return

        # Чистим back-слот (он будет новым front)
        try:
            for w in self.back.winfo_children():
                w.destroy()
        except Exception:
            pass

        # Старый front запоминаем для анимации, делаем back-слот текущим front
        self._old_front_for_anim = self.front
        self.front, self.back = self.back, self.front
        # Поднимаем новый front над старым, чтобы overlay лёг сверху
        try:
            self.front.grid()
            # НЕ делаем lift пока — сначала старый виден, как и должен
        except Exception:
            pass
        # main_content теперь указывает на новый (off-screen, но grid'нутый) слот
        self._sync_main_content()
        self._transition_busy = True

        # Запустим анимацию после того, как Python вернёт control в mainloop
        # и tkinter успеет отрисовать виджеты строящие в self.main_content
        self.root.after_idle(self._kickoff_anim)

    def _kickoff_anim(self):
        """Вызывается после того, как новые виджеты отрисованы в front-слоте."""
        try:
            self.front.lift()  # новый поверх старого
        except Exception:
            pass
        # Поднимаем плавающую кнопку возврата над front
        try:
            if hasattr(self.root, '_sync_return_btn'):
                self.root._sync_return_btn.lift()
        except Exception:
            pass
        self._transition_swap(on_built=None)

    # Сохраняем старый transition() для возможного будущего использования через builder
    def transition(self, builder: Callable, on_built: Optional[Callable] = None):
        """API через builder. Эквивалент begin_transition + builder() + ожидание."""
        if self._transition_busy:
            self._pending_builder = builder
            return
        self.begin_transition()
        try:
            builder()
        except Exception as e:
            log_error("PageHost.transition.builder", e)

    def _transition_swap(self, on_built: Optional[Callable]):
        """
        Премиум-анимация: slide+fade overlay.

        Двухфазная анимация:
          Фаза A (0..50% длительности): overlay цвета BG, постепенно сдвигается вниз
            (relheight 1.0 → 0.55) — создаёт эффект «занавес отодвигается»
          Фаза B (50..100%): overlay меняет цвет на COLOR_CARD_BG (мягкий)
            и продолжает уменьшаться → 0 — ощущение материализации

        Внутри нового контента (строится в self.front) первые 6 виджетов
        получают micro-slide на 8px снизу вверх → они «выезжают» на место.

        Длительность: 280мс. Easing: ease-out cubic.
        """
        old_front = getattr(self, "_old_front_for_anim", None)

        # Палитра
        try:
            mode_idx = 0 if ctk.get_appearance_mode() == "Light" else 1
            color_bg = UIConfig.COLOR_BG[mode_idx]
            color_card = UIConfig.COLOR_CARD_BG[mode_idx]
        except Exception:
            color_bg = "#0A0E14"
            color_card = "#131820"

        # Создаём overlay поверх нового контента
        try:
            overlay = ctk.CTkFrame(self.front, fg_color=color_bg, corner_radius=0)
            overlay.place(relx=0, rely=0, relwidth=1, relheight=1)
            overlay.lift()
        except Exception:
            overlay = None

        steps = 14
        duration_ms = 280
        interval_ms = max(8, duration_ms // steps)

        def _finish():
            try:
                if overlay is not None:
                    overlay.destroy()
            except Exception:
                pass
            # Поднимаем плавающую кнопку после завершения анимации
            try:
                if hasattr(self.root, '_sync_return_btn'):
                    self.root._sync_return_btn.lift()
            except Exception:
                pass
            if old_front is not None:
                try:
                    old_front.grid_remove()
                    self.back = old_front
                    self.root.after(60, self._cleanup_back)
                except Exception:
                    pass
            self._transition_busy = False
            self._sync_main_content()
            if on_built:
                try:
                    on_built()
                except Exception:
                    pass
            if self._pending_builder is not None:
                pb = self._pending_builder
                self._pending_builder = None
                self.root.after_idle(lambda: self.transition(pb))

        def _animate(i: int):
            try:
                if i >= steps:
                    _finish()
                    return
                t = i / steps  # 0..1
                # ease-out cubic
                eased = 1 - (1 - t) ** 3

                if overlay is not None and overlay.winfo_exists():
                    # Фаза A: relheight 1 → 0.55 (через 50% длительности)
                    if t <= 0.5:
                        local_t = t / 0.5
                        local_eased = 1 - (1 - local_t) ** 3
                        rh = 1.0 - 0.45 * local_eased
                        overlay.configure(fg_color=color_bg)
                    else:
                        # Фаза B: relheight 0.55 → 0, цвет → color_card
                        local_t = (t - 0.5) / 0.5
                        local_eased = 1 - (1 - local_t) ** 3
                        rh = 0.55 * (1 - local_eased)
                        overlay.configure(fg_color=color_card)
                    overlay.place_configure(relheight=max(0.0, rh))

                self.root.after(interval_ms, lambda: _animate(i + 1))
            except Exception as e:
                logging.error(f"PageHost._animate: {e}")
                self._transition_busy = False

        _animate(1)

    def _cleanup_back(self):
        """Чистит off-screen слот (освобождает память от старых виджетов)."""
        try:
            for w in self.back.winfo_children():
                w.destroy()
        except Exception:
            pass


