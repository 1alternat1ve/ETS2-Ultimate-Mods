    def _apply_pending_update_if_any(self):
        """
        При запуске проверяем, нет ли скачанного обновления (pending_update.exe + .update_pending).
        Если есть — запускаем его в режиме --apply-update и завершаемся.
        Это заменяет проблемный .bat-обновлятор, который ломал антивирус.
        """
        is_compiled = "__compiled__" in globals() or getattr(sys, 'frozen', False)
        if not is_compiled:
            return
        current_exe = Path(sys.executable)
        pending = current_exe.parent / "pending_update.exe"
        marker = current_exe.parent / ".update_pending"
        if not (pending.exists() and marker.exists()):
            return
        try:
            data = json.loads(marker.read_text(encoding="utf-8"))
            # Проверяем SHA-256 уже скачанного файла
            expected = data.get("sha256", "")
            if expected:
                actual = sha256_streaming(pending)
                if actual.lower() != expected.lower():
                    logging.error("Pending update SHA-256 mismatch — отказ от применения")
                    pending.unlink(missing_ok=True)
                    marker.unlink(missing_ok=True)
                    return
            subprocess.Popen(
                [str(pending), "--apply-update", "--target", str(current_exe)],
                creationflags=subprocess.DETACHED_PROCESS | subprocess.CREATE_NO_WINDOW
            )
            marker.unlink(missing_ok=True)
            sys.exit(0)
        except Exception as e:
            logging.error(f"_apply_pending_update_if_any inner: {e}")

