    def _test_keep(self):
        """Оставляет тестовый мод в постоянной сборке."""
        sess = self._test_session
        if not sess:
            return
        if hasattr(self, "toast"):
            self.toast.show(
                f"✓ Мод {sess['test_mod_name']} остаётся в сборке",
                "success")
        SoundFX.play("success")
        self._test_session = None
        self.show_test_mode()

    def _test_rollback(self):
        """Откатывает: удаляет тестовый мод из папки."""
        sess = self._test_session
        if not sess:
            return
        if is_game_running():
            messagebox.showerror(
                "Игра запущена",
                "Закройте игру перед откатом.")
            return
        try:
            target = sess["test_mod_path"]
            if target.exists():
                target.unlink()
            if hasattr(self, "toast"):
                self.toast.show(
                    f"↶ Откат выполнен · {sess['test_mod_name']} удалён",
                    "info")
            SoundFX.play("info")
        except Exception as e:
            log_error("_test_rollback", e)
            messagebox.showerror("Ошибка отката", str(e))
            return
        self._test_session = None
        self.show_test_mode()

