    def _find_python311(self) -> Optional[Path]:
        """Ищет Python 3.11 на системе."""
        candidates = [
            Path(os.environ.get("ProgramFiles", "C:/Program Files")) / "Python311" / "python.exe",
            Path(os.environ.get("LocalAppData", "C:/Users") ) / "Programs" / "Python" / "Python311" / "python.exe",
            Path("C:/Python311/python.exe"),
            Path("C:/Program Files/Python311/python.exe"),
        ]
        for c in candidates:
            if c.exists():
                return c
        # Поиск через where
        try:
            result = subprocess.run(["where", "python3.11"], capture_output=True, text=True, creationflags=subprocess.CREATE_NO_WINDOW)
            if result.returncode == 0:
                path = Path(result.stdout.strip().split("\r\n")[0])
                if path.exists():
                    return path
        except Exception:
            pass
        return None

    def _get_pip_for_python(self, python_path: Path) -> Optional[Path]:
        """Получает путь к pip для указанного Python."""
        pip_paths = [
            python_path.parent / "Scripts" / "pip.exe",
            python_path.parent / "Scripts" / "pip3.exe",
            python_path.parent / "pip.exe",
        ]
        for p in pip_paths:
            if p.exists():
                return p
        return None

    def _ensure_py311_deps(self, py_path: Path, deps: List[str]):
        """Устанавливает зависимости через pip для выбранного Python."""
        pip = self._get_pip_for_python(py_path)
        if not pip:
            return False
        for dep in deps:
            subprocess.run([str(py_path), "-m", "pip", "install", dep, "-q"],
                           capture_output=True, creationflags=subprocess.CREATE_NO_WINDOW)
        return True

    def _run_pyinstaller_build(self, src: str, icon: str, outname: str, python_path: Path):
        """Запускает PyInstaller сборку с указанным Python."""
        out_dir = str(Path(src).parent)

        # Сначала устанавливаем зависимости в этот Python
        deps = ["pyinstaller", "customtkinter", "requests", "py7zr"]
        if _PSUTIL_OK:
            deps.append("psutil")
        self._build_log_append(f"[PyInstaller] Установка зависимостей в {python_path}...\n")
        self._ensure_py311_deps(python_path, deps)

        pyi_path = python_path.parent / "Scripts" / "pyinstaller.exe"
        if not pyi_path.exists():
            pyi_path = python_path.parent / "Scripts" / "pyinstaller"
        pyi_cmd = str(pyi_path) if pyi_path.exists() else str(python_path) + " -m PyInstaller"

        cmd = [
            pyi_cmd,
            "--onefile",
            "--noconsole",
            "--clean",
            f"--distpath", out_dir,
            f"--workpath", str(Path(out_dir) / ".build"),
            f"--specpath", out_dir,
            f"--name", outname,
        ]
        if icon and Path(icon).exists():
            cmd += ["--icon", icon]
        cmd.append(src)

        self._build_log_append(f"[PyInstaller] Команда: {' '.join(cmd)}\n\n")

        try:
            proc = subprocess.Popen(
                cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, encoding="utf-8", errors="replace", cwd=out_dir,
            )
            for line in proc.stdout:
                self._build_log_append(line)
            proc.wait()

            result_exe = Path(out_dir) / f"{outname}.exe"
            if proc.returncode == 0 and result_exe.exists():
                self._build_log_append(f"\n✅ PyInstaller: сборка завершена!\nФайл: {result_exe}\n")
                self.after(0, lambda: messagebox.showinfo("Готово", f"EXE собран через PyInstaller!\n\n{result_exe}"))
            else:
                self._build_log_append(f"\n❌ PyInstaller: ошибка сборки (код {proc.returncode})\n")
        except FileNotFoundError:
            self._build_log_append("❌ PyInstaller не найден. Установите: pip install pyinstaller\n")
        except Exception as e:
            self._build_log_append(f"❌ Ошибка: {e}\n")
            log_error("_run_pyinstaller_build", e)
        finally:
            self.after(0, lambda: self._build_btn.configure(state="normal", text="🔨  Собрать EXE"))

    def _start_build(self):
        src = self._build_src.get().strip()
        icon = self._build_icon.get().strip()
        outname = self._build_outname.get().strip() or "ETS2Nexus"

        if not src or not Path(src).exists():
            messagebox.showerror("Ошибка", "Исходный .py файл не найден.\nПроверьте путь.")
            return
        if icon and not Path(icon).exists():
            messagebox.showerror("Ошибка", "Файл иконки не найден.\nПроверьте путь или оставьте поле пустым.")
            return

        self._build_btn.configure(state="disabled", text="⏳ Сборка...")
        self._build_log.configure(state="normal")
        self._build_log.delete("1.0", "end")
