    def _finish_sync_ui(self):
        self.is_syncing = False
        self.active_task_panel.grid_forget()
        self._hide_sync_return_btn()

        if hasattr(self, 'progress') and self.progress.winfo_exists():
            self.progress_var.set(1.0)
            self.progress.configure(progress_color=UIConfig.COLOR_SUCCESS)
            self.progress_text.configure(text="Установка завершена успешно!", text_color=UIConfig.COLOR_SUCCESS)
            
            summary = f"📊 Сводка: Скачано/Установлено: {self.sync_stats['installed']} | Ошибок: {self.sync_stats['errors']} | Пропущено (Кэш): {self.sync_stats['skipped']}"
            self.current_file_label.configure(text=summary, text_color=UIConfig.COLOR_TEXT_MAIN, font=("Segoe UI", 13, "bold"))

            self.finish_btn.configure(text="▶ ЗАПУСТИТЬ ИГРУ", state="normal", fg_color=UIConfig.COLOR_SUCCESS, hover_color=UIConfig.COLOR_SUCCESS_HOVER, text_color="white", command=self.launch_game)
        
        self.set_status("Система готова к запуску")
        messagebox.showinfo("Готово", "Все файлы успешно скачаны и установлены!")

    def _error_sync_ui(self, cancelled=False):
        self.is_syncing = False
        self.active_task_panel.grid_forget()
        self._hide_sync_return_btn()

        if hasattr(self, 'progress') and self.progress.winfo_exists():
            self.progress.configure(progress_color=UIConfig.COLOR_DANGER)
            
            if cancelled:
                self.progress_text.configure(text="Установка отменена пользователем.", text_color=UIConfig.COLOR_WARNING)
                self.set_status("Установка отменена")
            else:
                self.progress_text.configure(text="Процесс прерван. Произошла ошибка.", text_color=UIConfig.COLOR_DANGER)
                self.set_status("Ошибка во время установки")
            
            self.finish_btn.configure(text="Вернуться на Главную", state="normal", fg_color=UIConfig.COLOR_DANGER, hover_color=UIConfig.COLOR_DANGER_HOVER, text_color="white", command=self.show_home)

    def download_asset_chunked(self, asset_dict, target_path):
        """Интеллектуальная загрузка с поддержкой прогресса, паузы и отмены."""
        asset_size = asset_dict['size']
        asset_name = asset_dict['name']
        download_url = asset_dict['browser_download_url']

        if target_path.exists() and target_path.stat().st_size == asset_size:
            self.safe_log_colored(f"⏭ [КЭШ] {asset_name} совпадает по весу, пропускаем.", "muted")
            self.sync_stats['skipped'] += 1
            return True

        self.safe_log_colored(f"⬇️ [ЗАГРУЗКА] {asset_name} ({(asset_size/(1024*1024)):.1f} MB)...", "warn")
        try:
            with requests.get(download_url, stream=True, timeout=10) as r:
                r.raise_for_status()
                downloaded = 0
                start_time = time.time()
                with open(target_path, 'wb') as f:
                    for chunk in r.iter_content(chunk_size=65536): # 64KB чанки
                        if self.sync_cancel_flag:
                            raise Exception("Отменено пользователем")
                        
                        while self.sync_pause_flag:
                            time.sleep(0.5)
                            if self.sync_cancel_flag:
                                raise Exception("Отменено пользователем")
                                
                        if chunk:
                            f.write(chunk)
                            downloaded += len(chunk)
                            elapsed = time.time() - start_time
                            speed = (downloaded / 1024 / 1024) / elapsed if elapsed > 0 else 0
                            progress = downloaded / asset_size if asset_size > 0 else 0
                            
                            self.after(0, self._update_task_ui, asset_name, progress, speed)

            self.sync_stats['installed'] += 1
            return True
        except Exception as e:
            if "Отменено пользователем" in str(e):
                raise e # Пробрасываем наверх для остановки всего движка
            
            self.safe_log_colored(f"⚠️ [ОШИБКА ЗАГРУЗКИ] {asset_name}: {e}", "error")
            self.sync_stats['errors'] += 1
            if target_path.exists(): target_path.unlink()
            return False

    def _ensure_sii_decrypt(self):
        sii_path = AppConfig.TEMP_SYNC_DIR / "SII_Decrypt.exe"
        if sii_path.exists():
            return sii_path

        self.safe_log_colored("🌐 Скачивание системной утилиты SII_Decrypt...", "muted")
        AppConfig.TEMP_SYNC_DIR.mkdir(parents=True, exist_ok=True)
        session = requests.Session()
        session.headers.update({"User-Agent": "ETS2-Nexus/1.0"})
        try:
            api_url = AppConfig.GITHUB_API_URL.replace("/latest", "")
            resp = session.get(api_url, timeout=8)
            resp.raise_for_status()

            releases = resp.json()
            if isinstance(releases, dict):
                releases = [releases]

            download_url = None
            for release in releases:
                for asset in release.get('assets', []):
                    if asset['name'] == "SII_Decrypt.exe":
                        download_url = asset['browser_download_url']
                        break
                if download_url: break

            if not download_url:
                raise Exception("Файл не найден ни в одном релизе API.")

            with session.get(download_url, stream=True, timeout=15) as r:
                r.raise_for_status()
                with open(sii_path, 'wb') as f:
                    for chunk in r.iter_content(chunk_size=8192):
                        f.write(chunk)
            return sii_path
        except requests.exceptions.RequestException as api_err:
            log_error("_ensure_sii_decrypt_api_fail", api_err)
            self.safe_log_colored(f"⚠️ Сбой API ({api_err}). Переход на прямую ссылку-фоллбэк...", "warn")

            try:
                with session.get(AppConfig.FALLBACK_DECRYPT_URL, stream=True, timeout=15) as r:
                    r.raise_for_status()
                    with open(sii_path, 'wb') as f:
                        for chunk in r.iter_content(chunk_size=8192):
                            f.write(chunk)
                return sii_path
            except Exception as direct_err:
                log_error("_ensure_sii_decrypt_direct_fail", direct_err)
                self.safe_log_colored("❌ Полный сбой загрузки компонента.", "error")
                return None
        except Exception as api_err:
            log_error("_ensure_sii_decrypt_api_fail", api_err)
            self.safe_log_colored(f"⚠️ Сбой API ({api_err}). Переход на прямую ссылку-фоллбэк...", "warn")
            try:
                with session.get(AppConfig.FALLBACK_DECRYPT_URL, stream=True, timeout=15) as r:
                    r.raise_for_status()
                    with open(sii_path, 'wb') as f:
                        for chunk in r.iter_content(chunk_size=8192):
                            f.write(chunk)
                return sii_path
            except Exception as direct_err:
                log_error("_ensure_sii_decrypt_direct_fail", direct_err)
                self.safe_log_colored("❌ Полный сбой загрузки компонента.", "error")
                return None

    def _cleanup_sii_decrypt(self):
        sii_path = AppConfig.TEMP_SYNC_DIR / "SII_Decrypt.exe"
        try:
            if sii_path.exists():
                sii_path.unlink()
        except Exception:
            pass

