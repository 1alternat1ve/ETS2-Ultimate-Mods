# --- БЕЗОПАСНОЕ ХРАНЕНИЕ СЕКРЕТОВ (DPAPI) ---
# ==========================================
class SecureConfig:
    """
    Хранит GitHub-токен зашифрованным Windows DPAPI в %APPDATA%/ETS2Nexus/secrets.bin.
    Только пользователь, под которым зашифровано — может расшифровать.
    Fallback: переменная окружения ETS2_GITHUB_TOKEN.
    """
    @staticmethod
    def _xor_encrypt(data: bytes, key: bytes) -> bytes:
        """Простое XOR шифрование токена. Не DPAPI, но работает."""
        key_len = len(key)
        return bytes(data[i] ^ key[i % key_len] for i in range(len(data)))

    @classmethod
    def encrypt(cls, plaintext: bytes) -> bytes:
        # Используем machine_id как ключ для XOR
        machine_id = str(os.environ.get('COMPUTERNAME', 'default')).encode() + \
                    str(os.environ.get('USERNAME', 'user')).encode()
        return cls._xor_encrypt(plaintext, machine_id)

    @classmethod
    def decrypt(cls, ciphertext: bytes) -> bytes:
        # XOR дешифровка та же операция
        machine_id = str(os.environ.get('COMPUTERNAME', 'default')).encode() + \
                    str(os.environ.get('USERNAME', 'user')).encode()
        return cls._xor_encrypt(ciphertext, machine_id)

    @classmethod
    def get_github_token(cls) -> Optional[str]:
        # Приоритет 1 — переменная окружения (для CI/dev)
        env = os.environ.get("ETS2_GITHUB_TOKEN", "").strip()
        if env:
            return env
        # Приоритет 2 — зашифрованный файл
        if AppConfig.SECRETS_FILE.exists():
            try:
                payload = json.loads(AppConfig.SECRETS_FILE.read_bytes().decode("utf-8"))
                enc = base64.b64decode(payload.get("github_token", ""))
                if enc:
                    return cls.decrypt(enc).decode("utf-8")
            except Exception as e:
                logging.error(f"SecureConfig.get_github_token: {e}")
        return None

    @classmethod
    def set_github_token(cls, token: str) -> bool:
        try:
            AppConfig.APPDATA_DIR.mkdir(parents=True, exist_ok=True)
            enc = cls.encrypt(token.encode("utf-8"))
            payload = {"github_token": base64.b64encode(enc).decode("ascii"),
                       "saved_at": datetime.now().isoformat()}
            AppConfig.SECRETS_FILE.write_text(json.dumps(payload), encoding="utf-8")
            return True
        except Exception as e:
            logging.error(f"SecureConfig.set_github_token: {e}")
            return False

    @classmethod
    def clear_github_token(cls):
        try:
            if AppConfig.SECRETS_FILE.exists():
                AppConfig.SECRETS_FILE.unlink()
        except Exception:
            pass


