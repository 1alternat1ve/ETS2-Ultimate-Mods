    # Кэш на 8 секунд — список профилей дёргается из 5+ мест UI
    _profiles_cache: Tuple[float, List[Dict]] = (0.0, [])
    _PROFILES_TTL = 8.0

    def _invalidate_profiles_cache(self):
        ETS2Manager._profiles_cache = (0.0, [])

    def _get_all_profiles(self, force: bool = False) -> List[Dict]:
        now = time.time()
        if not force and (now - ETS2Manager._profiles_cache[0]) < ETS2Manager._PROFILES_TTL:
            return ETS2Manager._profiles_cache[1]

        profiles: List[Dict] = []
        try:
            with winreg.OpenKey(winreg.HKEY_CURRENT_USER, r"Software\Valve\Steam") as key:
                s_path = Path(winreg.QueryValueEx(key, "SteamPath")[0])
                p_dir = s_path / "userdata"
                if p_dir.exists():
                    for uid in os.listdir(p_dir):
                        remote = p_dir / uid / AppConfig.STEAM_APP_ID / "remote" / "profiles"
                        if remote.exists():
                            for pr in os.listdir(remote):
                                sii = remote / pr / "profile.sii"
                                if sii.exists():
                                    profiles.append({
                                        'name': hex_to_nickname(pr),
                                        'path': sii,
                                        'type': 'Steam Cloud',
                                        'time': os.path.getmtime(sii)
                                    })
        except OSError:
            pass

        loc_dir = get_profiles_dir()
        if loc_dir.exists():
            for pr in os.listdir(loc_dir):
                sii = loc_dir / pr / "profile.sii"
                if sii.exists():
                    profiles.append({
                        'name': hex_to_nickname(pr),
                        'path': sii,
                        'type': 'Локальный',
                        'time': os.path.getmtime(sii)
                    })

        profiles.sort(key=lambda x: x['time'], reverse=True)
        ETS2Manager._profiles_cache = (now, profiles)
        return profiles

    def return_to_sync_page(self):
        """
        Возврат на экран установки БЕЗ пересоздания виджетов.
        Раньше тут пересоздавался весь UI с надписью «Восстановление вида...»
        и при этом фоновый поток продолжал писать в УНИЧТОЖЕННЫЕ виджеты —
        что приводило к рассинхронизации.

        Теперь мы просто прячем main_content (где сейчас другая страница)
        и показываем сохранённый sync-контейнер с актуальным состоянием.
        """
        if not self.is_syncing:
            self._sync_return_btn.pack_forget()
            self._sync_progress_lbl.pack_forget()
            return
        if not getattr(self, "_sync_screen_container", None):
            return

        # Прячем активную PageHost-страницу (через grid_remove, без destroy)
        try:
            if hasattr(self, "page_host"):
                self.page_host.front.grid_remove()
                self.page_host.back.grid_remove()
        except Exception:
            pass

        # Показываем сохранённый sync-контейнер с актуальным состоянием
        try:
            self._sync_screen_container.grid(
                row=0, column=1, sticky="nsew", padx=30, pady=20)
            self._sync_screen_container.lift()
            self._active_page_kind = "sync"
            self.set_status("Установка модов — продолжается")
        except Exception as e:
            log_error("return_to_sync_page", e)

