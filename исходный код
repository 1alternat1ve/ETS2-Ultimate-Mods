    def close_game_safely(self):
        self.set_status("Выполняется принудительное завершение...")
        try:
            hwnd = ctypes.windll.user32.FindWindowW("prism3d", None)
            if hwnd:
                ctypes.windll.user32.PostMessageW(hwnd, 0x0010, 0, 0) 
                time.sleep(1.5) 
            
            run_hidden_process(["taskkill", "/f", "/im", "eurotrucks2.exe"])
            time.sleep(1)
            self.set_status("Процесс успешно убит.")
        except Exception as e:
            log_error("close_game_safely", e)
            run_hidden_process(["taskkill", "/f", "/im", "eurotrucks2.exe"])

    def get_dir_size(self, path: Path) -> int:
        if not path.exists(): return 0
        return sum(f.stat().st_size for f in path.rglob('*') if f.is_file())

    def check_disk_space(self, target_path: Path, required_bytes: int) -> bool:
        try:
            drive = target_path.anchor
            usage = shutil.disk_usage(drive)
            buffer = 500 * 1024 * 1024
            if usage.free < (required_bytes + buffer):
                return False
            return True
        except Exception as e:
            log_error("check_disk_space", e)
            return True

    def get_free_space_gb(self) -> float:
        try:
            drive = Path(os.environ.get("SystemDrive", "C:") + "\\").anchor
            usage = shutil.disk_usage(drive)
            return usage.free / (1024**3)
        except Exception:
            return 999.0
            
