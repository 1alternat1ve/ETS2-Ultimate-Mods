    def get_steam_game_path(self) -> Optional[Path]:
        try:
            with winreg.OpenKey(winreg.HKEY_CURRENT_USER, r"Software\Valve\Steam") as key:
                steam_path = Path(winreg.QueryValueEx(key, "SteamPath")[0])
                apps_path = steam_path / "steamapps" / "common" / "Euro Truck Simulator 2"
                if apps_path.exists(): 
                    return apps_path
        except OSError:
            pass

        for drive in string.ascii_uppercase:
            if os.path.exists(f"{drive}:\\"):
                paths = [
                    Path(f"{drive}:/Program Files (x86)/Steam/steamapps/common/Euro Truck Simulator 2"),
                    Path(f"{drive}:/SteamLibrary/steamapps/common/Euro Truck Simulator 2")
                ]
                for p in paths:
                    if p.exists(): 
                        return p
        return None

    def launch_game(self, extra_args=""):
        if not is_steam_running():
            msg = "⚠️ Клиент Steam не запущен!\n\nДля корректного старта игры и работы синхронизации профилей необходимо запустить Steam. Открыть Steam сейчас?"
            if messagebox.askyesno("Steam не найден", msg):
                webbrowser.open("steam://open/main")
                self.set_status("Ожидание запуска Steam...")
                return
                
        self.set_status("Запуск игры...")
        args = self.settings.get("launch_args", "").strip()
        if extra_args:
            args += f" {extra_args}"
            
        launch_url = f"steam://rungameid/{AppConfig.STEAM_APP_ID}"
        if args:
            launch_url += f"//{args}"
            
        try:
            webbrowser.open(launch_url)
        except Exception as e:
            log_error("launch_game", e)
            messagebox.showerror("Ошибка", f"Сбой при взаимодействии со Steam API.\n{e}")
            
    def launch_game_safe_mode(self):
        if messagebox.askyesno("Безопасный режим (Safe Mode)", "Запустить игру в безопасном режиме?\n\nЭто временно отключит проблемные настройки графики и плагины. Используйте это, если игра вылетает при запуске."):
            self.launch_game("-safe")

    def close_game_safely(self):
        self.set_status("Выполняется принудительное завершение...")
        try:
            hwnd = ctypes.windll.user32.FindWindowW("prism3d", None)
            if hwnd:
                ctypes.windll.user32.PostMessageW(hwnd, 0x0010, 0, 0) 
                time.sleep(1.5) 
            
            run_hidden_process(["taskkill", "/f", "/im", "eurotrucks2.exe"])
            time.sleep(1)
            self.set_status("Процесс успешно убит.")
        except Exception as e:
            log_error("close_game_safely", e)
            run_hidden_process(["taskkill", "/f", "/im", "eurotrucks2.exe"])

    def get_dir_size(self, path: Path) -> int:
        if not path.exists(): return 0
        return sum(f.stat().st_size for f in path.rglob('*') if f.is_file())

    def check_disk_space(self, target_path: Path, required_bytes: int) -> bool:
        try:
            drive = target_path.anchor
            usage = shutil.disk_usage(drive)
            buffer = 500 * 1024 * 1024
            if usage.free < (required_bytes + buffer):
                return False
            return True
        except Exception as e:
            log_error("check_disk_space", e)
            return True

    def get_free_space_gb(self) -> float:
        try:
            drive = Path(os.environ.get("SystemDrive", "C:") + "\\").anchor
            usage = shutil.disk_usage(drive)
            return usage.free / (1024**3)
        except Exception:
            return 999.0
            
    def check_broken_mods(self) -> List[str]:
        broken_mods = []
        user_mods_dir = get_my_documents() / "Euro Truck Simulator 2" / "mod"
        if user_mods_dir.exists():
            for f in user_mods_dir.rglob('*.scs'):
                if f.is_file() and f.stat().st_size == 0:
                    broken_mods.append(f.name)
        return broken_mods

    def get_missing_dlcs(self) -> List[str]:
        if not self.game_path: return []
        missing = []
        for dlc_file, dlc_name in AppConfig.REQUIRED_DLCS.items():
            if not (self.game_path / dlc_file).exists():
                missing.append(dlc_name)
        return missing

    def get_game_config_path(self) -> Path:
        return get_my_documents() / "Euro Truck Simulator 2" / "config.cfg"

    def read_game_config(self) -> dict:
        cfg_path = self.get_game_config_path()
        settings = {}
        if cfg_path.exists():
            with open(cfg_path, "r", encoding="utf-8") as f:
                for line in f:
                    match = re.match(r'^\s*uset\s+([a-zA-Z0-9_]+)\s+"([^"]*)"', line)
                    if match:
                        settings[match.group(1)] = match.group(2)
        return settings

    def save_game_config(self, updates: dict):
        cfg_path = self.get_game_config_path()
        if not cfg_path.exists():
            messagebox.showerror("Системная ошибка", "Файл настроек не найден. Запустите игру один раз, чтобы он создался.")
            return

        try:
            shutil.copy2(cfg_path, cfg_path.with_suffix('.cfg.bak'))
        except Exception as e:
            log_error("backup_game_config", e)

        try:
            with open(cfg_path, "r", encoding="utf-8") as f:
                lines = f.readlines()

            with open(cfg_path, "w", encoding="utf-8") as f:
                for line in lines:
                    match = re.match(r'^\s*uset\s+([a-zA-Z0-9_]+)\s+"([^"]*)"', line)
                    if match and match.group(1) in updates:
                        f.write(f'uset {match.group(1)} "{updates[match.group(1)]}"\n')
                    else:
                        f.write(line)
            messagebox.showinfo("Готово", "Новые параметры успешно применены. Бэкап сохранен как config.cfg.bak.\nОни вступят в силу при следующем запуске игры.")
            self.show_graphics_settings()
        except Exception as e:
            log_error("save_game_config", e)
            messagebox.showerror("Ошибка записи", f"Не удалось обновить файл: {e}")

