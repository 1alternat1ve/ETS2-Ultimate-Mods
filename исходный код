# --- MOD GROUPS: категоризация модов и тоглы ---
# ==========================================
class ModGroups:
    """
    Группы модов для UI с возможностью включения/выключения целиком.

    Категоризация по эвристике имени файла (поиск ключевых слов).
    Включение/выключение через ПЕРЕИМЕНОВАНИЕ:
      mod.scs       → активен (игра загружает)
      mod.scs.off   → выключен (игра не видит)

    Это безопасно: не правим profile.sii, моды физически на диске.
    Включение обратно за 1 клик и без скачивания.
    """

    GROUPS = {
        "maps": {
            "name": "🗺  Карты",
            "description": "ProMods, RusMap, Roex, расширения дорог",
            "keywords": ["map", "promods", "rusmap", "roex", "scandinavia",
