# --- COMMUNITY METRICS: счётчик пользователей ---
# ==========================================
class CommunityMetrics:
    """
    Подсчёт пользователей программы через GitHub Releases API.

    GitHub отдаёт `download_count` для каждого ассета в релизе.
    Суммируем по всем релизам — получаем общее число загрузок программы.

    Кэшируется на 30 минут. Бесплатно, без backend.
    """

    _cache_total: Optional[int] = None
    _cache_ts: float = 0.0
    TTL = 1800.0  # 30 минут

    @classmethod
    def get_total_downloads(cls, session: requests.Session,
                              repo: str = None) -> Optional[int]:
        """
        Возвращает суммарное число скачиваний ТОЛЬКО .exe-файлов.
        Это и есть «количество установок программы».

        ВАЖНО: .zip / .7z из релизов — это сами моды, которые программа
        качает у каждого пользователя при синхронизации (часто несколько
        раз). Их считать НЕЛЬЗЯ — счётчик будет искусственно завышен.
        Только .exe = установка Nexus.
        """
        now = time.time()
        if (cls._cache_total is not None
                and (now - cls._cache_ts) < cls.TTL):
            return cls._cache_total

        repo = repo or AppConfig.PROGRAM_REPO
        try:
            url = f"https://api.github.com/repos/{repo}/releases"
            resp = session.get(url, timeout=8)
            resp.raise_for_status()
            releases = resp.json()
            if not isinstance(releases, list):
                return None
            total = 0
            for release in releases:
                for asset in release.get("assets", []):
                    name = asset.get("name", "").lower()
                    # Считаем ТОЛЬКО .exe — это и есть «установки программы»
                    if name.endswith(".exe"):
                        total += int(asset.get("download_count", 0) or 0)
            cls._cache_total = total
            cls._cache_ts = now
            return total
        except Exception as e:
            logging.error(f"CommunityMetrics.get_total_downloads: {e}")
            return None


