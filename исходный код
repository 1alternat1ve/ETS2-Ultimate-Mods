                     text_color=UIConfig.COLOR_TEXT_MUTED).pack(anchor="w", pady=(5, 5))

        self._build_log = ctk.CTkTextbox(self.main_content, font=UIConfig.FONT_LOG,
                                         fg_color=UIConfig.COLOR_LOG_BG, state="disabled")
        self._build_log.pack(fill="both", expand=True)

        self._build_log_append("✅ Готов к сборке. Выберите интерпретатор и нажмите «Собрать EXE».\n\n")
        self._build_log_append(
            "ℹ️  Поддерживаемые компиляторы:\n"
            "   • PyInstaller (рекомендуется)\n"
            "   • Nuitka (если установлен)\n\n"
            "ℹ️  Рекомендуемый процесс сборки:\n"
            "   1. Выбрать Python 3.11\n"
            "   2. Нажать «Собрать EXE»\n"
            "   3. Дождаться завершения (5-15 мин)\n\n"
        )

    def _build_log_append(self, text: str):
        """Добавляет текст в лог сборки (thread-safe через after)."""
        def _do():
            self._build_log.configure(state="normal")
            self._build_log.insert("end", text)
            self._build_log.see("end")
            self._build_log.configure(state="disabled")
        self.after(0, _do)

    def _run_build(self, src: str, icon: str, outname: str):
        src_path = Path(src)
        out_dir = src_path.parent

        # ── Определяем какой Python использовать ──
        py_choice = getattr(self, '_py_version_var', ctk.StringVar()).get()

        if py_choice == "3.11" and self._py311_path:
            python_exe = str(self._py311_path)
            self._build_log_append(f"[INFO] Используем Python 3.11: {python_exe}\n")
            threading.Thread(target=self._run_pyinstaller_build,
                           args=(src, icon, outname, self._py311_path), daemon=True).start()
            return
        else:
            # Nuitka с текущим Python
            python_exe = shutil.which("python") or shutil.which("python3") or sys.executable
            self._build_log_append(f"[INFO] Используем текущий Python: {python_exe}\n")

        # Ищем nuitka
        nuitka_cmd = shutil.which("nuitka")
        if not nuitka_cmd:
            python_exe_path = Path(python_exe)
            scripts_dir = python_exe_path.parent / "Scripts"
            for name in ("nuitka.cmd", "nuitka.exe", "nuitka"):
                candidate = scripts_dir / name
                if candidate.exists():
                    nuitka_cmd = str(candidate)
                    break

        if nuitka_cmd:
            cmd = [nuitka_cmd]
        else:
            cmd = [python_exe, "-m", "nuitka"]

        # Базовые пакеты которые всегда нужны
        packages = [
            "customtkinter", "requests", "py7zr", "certifi",
        ]
        if _PSUTIL_OK:
            packages.append("psutil")

        cmd += [
            "--onefile",
            "--windows-disable-console",
            "--windows-uac-admin",
            "--enable-plugin=tk-inter",
            f"--output-filename={outname}.exe",
            f"--output-dir={out_dir}",
        ]
        for pkg in packages:
            cmd.append(f"--include-package={pkg}")
        cmd.append("--include-package-data=customtkinter")
        cmd.append("--include-package-data=certifi")

        if icon:
            cmd.append(f"--windows-icon-from-ico={icon}")

        cmd.append(str(src_path))

        self._build_log_append(f"▶ Запуск команды:\n{' '.join(cmd)}\n\n")
        self.after(0, lambda: self.set_status("🔨 Идёт компиляция Nuitka..."))

        try:
            proc = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                encoding="utf-8",
                errors="replace",
                cwd=str(out_dir),
            )

            for line in proc.stdout:
                self._build_log_append(line)

            proc.wait()

            if proc.returncode == 0:
                result_path = out_dir / (outname + '.exe')
                self._build_log_append(f"\n✅ Сборка завершена успешно!\nФайл: {result_path}\n")
                self.after(0, lambda: self.set_status("✅ Сборка завершена"))
                self.after(0, lambda: messagebox.showinfo("Готово", f"EXE успешно собран!\n\n{result_path}"))
            else:
                self._build_log_append(f"\n❌ Сборка завершилась с ошибкой (код {proc.returncode}).\nСм. лог выше.\n")
                self.after(0, lambda: self.set_status("❌ Ошибка сборки"))
                self.after(0, lambda: messagebox.showerror("Ошибка сборки", f"Nuitka завершился с кодом {proc.returncode}.\nПодробности в логе."))

        except FileNotFoundError:
            self._build_log_append(
                "\n❌ Nuitka не найдена!\n\n"
                "Решения:\n"
                "  1. pip install nuitka\n"
                f"  2. Убедитесь что папка Scripts добавлена в PATH:\n"
                f"     {Path(shutil.which('python') or sys.executable).parent / 'Scripts'}\n"
                "  3. Перезапустите программу после установки Nuitka.\n"
            )
            self.after(0, lambda: messagebox.showerror(
                "Nuitka не найдена",
                "Nuitka не установлена или не в PATH.\n\n"
                "Установите:\n  pip install nuitka\n\n"
                f"Папка Scripts Python:\n{Path(shutil.which('python') or sys.executable).parent / 'Scripts'}"))
        except Exception as e:
            self._build_log_append(f"\n❌ Неожиданная ошибка: {e}\n")
            log_error("_run_build", e)
        finally:
            self.after(0, lambda: self._build_btn.configure(state="normal", text="🔨  Собрать EXE"))


def _self_replace_mode() -> bool:
    """
    Спецрежим: программа запущена как `pending_update.exe --apply-update --target <старый.exe>`.
    Заменяет старый exe на себя, стартует его и самоудаляется через MoveFileEx (DELAY_UNTIL_REBOOT).

    Возвращает True если режим был активирован — тогда основной запуск отменяется.
    """
    if "--apply-update" not in sys.argv:
        return False
    try:
        target_idx = sys.argv.index("--target") + 1
        target = Path(sys.argv[target_idx])
    except (ValueError, IndexError):
        return True  # некорректные аргументы — выходим без действия

    new_self = Path(sys.executable)

    # Ждём, пока старый процесс не отпустит файл (до 10 сек)
    for _ in range(40):
        try:
            if target.exists():
                target.unlink()
            break
        except (PermissionError, FileNotFoundError, OSError):
            time.sleep(0.25)

    # Копируем себя на место старого
    try:
        shutil.copy2(new_self, target)
    except Exception:
        return True

    # Запускаем свежий exe
    try:
        subprocess.Popen([str(target)],
                         creationflags=subprocess.DETACHED_PROCESS | subprocess.CREATE_NO_WINDOW)
    except Exception:
        pass

    # Помечаем pending_update.exe на удаление при следующей перезагрузке
    try:
        MOVEFILE_DELAY_UNTIL_REBOOT = 0x4
        ctypes.windll.kernel32.MoveFileExW(str(new_self), None, MOVEFILE_DELAY_UNTIL_REBOOT)
    except Exception:
        pass

    sys.exit(0)
    return True


if __name__ == "__main__":
    # Если запущены в режиме self-replace — выходим до создания GUI
    if _self_replace_mode():
        sys.exit(0)

    # === РАННЯЯ ДИАГНОСТИКА: пишем в файл ДО любого GUI ===
    # Файл в AppData. Если EXE не открывается — смотреть его первым делом.
    _early_log_path = AppConfig.APPDATA_DIR / "startup_debug.txt"
    def _early_log(msg: str):
        try:
            with open(_early_log_path, 'a', encoding='utf-8') as _f:
                _f.write(f"[{datetime.now().strftime('%H:%M:%S.%f')}] {msg}\n")
        except Exception:
            pass

    _early_log("=== СТАРТ EXE ===")
    _early_log(f"sys.executable = {sys.executable}")
    _early_log(f"frozen = {getattr(sys, 'frozen', False)}, compiled = {'__compiled__' in globals()}")
    _early_log(f"is_admin = {is_admin()}")

    if sys.stdout is None:
        sys.stdout = open(os.devnull, 'w')
    if sys.stderr is None:
        sys.stderr = open(os.devnull, 'w')

    try:
        _early_log("setup_logging()...")
        setup_logging()
        _early_log("Создаём ETS2Manager()...")
        app = ETS2Manager()
        _early_log("mainloop()...")
        app.mainloop()
        _early_log("mainloop() завершён нормально.")
    except Exception as _fatal_exc:
        _tb = traceback.format_exc()
        _early_log(f"FATAL EXCEPTION: {_fatal_exc}\n{_tb}")
        try:
            with open(AppConfig.CRASH_LOG_FILE, 'a', encoding='utf-8') as _f:
                _f.write(f"\n[FATAL] {datetime.now()}\n{_tb}\n")
        except Exception:
            pass
        try:
            import tkinter as _tk
            from tkinter import messagebox as _mb
            _r = _tk.Tk(); _r.withdraw()
            _mb.showerror("Критическая ошибка",
                f"Программа аварийно завершилась:\n\n{str(_fatal_exc)}\n\n"
                f"Подробности сохранены в startup_debug.txt\n\n{_tb[-800:]}")
            _r.destroy()
        except Exception as _gui_exc:
            _early_log(f"Не удалось показать GUI-ошибку: {_gui_exc}")
            pass
