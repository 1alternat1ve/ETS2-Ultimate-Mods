    def safe_log_colored(self, msg: str, tag: str = "muted"):
        timestamp = datetime.now().strftime("%H:%M:%S")
        self.after(0, self._insert_log_colored, f"[{timestamp}] {msg}", tag)

    def _insert_log_colored(self, text: str, tag: str):
        # Защита: пишем в лог, только если мы не ушли со вкладки
        if hasattr(self, 'log_box') and self.log_box.winfo_exists():
            self.log_box.configure(state="normal")
            self.log_box.insert("end", f"{text}\n", tag)
            self.log_box.see("end")
            self.log_box.configure(state="disabled")

