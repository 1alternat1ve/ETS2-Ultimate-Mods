    def _build_mod_group_card(self, parent, group_id: str,
                                group_def: dict, mods: List[Dict]):
        """Карточка одной группы модов с раскрытием списка."""
        enabled_count = sum(1 for m in mods if m["enabled"])
        total_size_mb = sum(m["size_mb"] for m in mods)
        all_enabled = enabled_count == len(mods)
        all_disabled = enabled_count == 0

        # Цвет границы зависит от состояния
        if all_enabled:
            border = UIConfig.COLOR_SUCCESS
        elif all_disabled:
            border = UIConfig.COLOR_TEXT_GHOST
        else:
            border = UIConfig.COLOR_WARNING

        card = ctk.CTkFrame(
            parent,
            fg_color=UIConfig.COLOR_CARD_BG,
            corner_radius=UIConfig.CORNER_RADIUS_CARD,
            border_width=1,
            border_color=border)
        card.pack(fill="x", padx=4, pady=(0, 10))

        # Хедер карточки
        head = ctk.CTkFrame(card, fg_color="transparent")
        head.pack(fill="x", padx=20, pady=(16, 10))

        title_col = ctk.CTkFrame(head, fg_color="transparent")
        title_col.pack(side="left", fill="x", expand=True)
        ctk.CTkLabel(title_col, text=group_def["name"],
                     font=("Segoe UI Semibold", 16),
                     text_color=UIConfig.COLOR_TEXT_MAIN,
                     anchor="w").pack(anchor="w")
        ctk.CTkLabel(title_col, text=group_def["description"],
                     font=UIConfig.FONT_TINY,
                     text_color=UIConfig.COLOR_TEXT_GHOST,
                     anchor="w").pack(anchor="w")

        # Метрики
        meta_col = ctk.CTkFrame(head, fg_color="transparent")
        meta_col.pack(side="right", padx=(0, 12))
        status_text = f"{enabled_count} / {len(mods)} включено"
        status_color = (UIConfig.COLOR_SUCCESS if all_enabled
                          else UIConfig.COLOR_DANGER if all_disabled
                          else UIConfig.COLOR_WARNING)
        ctk.CTkLabel(meta_col, text=status_text,
                     font=("Segoe UI Semibold", 13),
                     text_color=status_color,
                     anchor="e").pack(anchor="e")
        ctk.CTkLabel(meta_col, text=f"{total_size_mb:.1f} МБ",
                     font=UIConfig.FONT_TINY,
                     text_color=UIConfig.COLOR_TEXT_GHOST,
                     anchor="e").pack(anchor="e")

        # Кнопки управления группой
        btn_row = ctk.CTkFrame(card, fg_color="transparent")
        btn_row.pack(fill="x", padx=20, pady=(0, 14))

        def _toggle_group(target_enabled: bool, gid=group_id, mds=mods):
            ok, total = ModGroups.set_group_enabled(mds, target_enabled)
            if hasattr(self, "toast"):
                action = "включена" if target_enabled else "выключена"
                self.toast.show(
                    f"Группа «{group_def['name']}» {action} ({ok}/{total})",
                    "success" if ok == total else "warn")
            SoundFX.play("info")
            # Перерисуем страницу чтобы обновить статусы
            self.show_mod_groups()

        ctk.CTkButton(btn_row,
                      text="✓  Включить все",
                      fg_color=UIConfig.COLOR_SUCCESS,
                      hover_color=UIConfig.COLOR_SUCCESS_HOVER,
                      corner_radius=UIConfig.CORNER_RADIUS_BTN,
                      height=34, width=140,
                      font=("Segoe UI Semibold", 12),
                      state="disabled" if all_enabled else "normal",
                      command=lambda: _toggle_group(True)
                      ).pack(side="left", padx=(0, 8))

        ctk.CTkButton(btn_row,
                      text="○  Выключить все",
                      fg_color="transparent",
                      border_width=1, border_color=UIConfig.COLOR_BORDER,
                      hover_color=UIConfig.COLOR_BTN_GRAY,
                      text_color=UIConfig.COLOR_TEXT_MAIN,
                      corner_radius=UIConfig.CORNER_RADIUS_BTN,
                      height=34, width=140,
                      font=("Segoe UI Semibold", 12),
                      state="disabled" if all_disabled else "normal",
                      command=lambda: _toggle_group(False)
                      ).pack(side="left", padx=(0, 8))

        # Кнопка раскрытия списка модов внутри группы
        is_expanded = getattr(self, f"_modg_exp_{group_id}", False)
        toggle_text = ("⌃  Скрыть список" if is_expanded
                       else f"⌄  Показать {len(mods)} модов")

        def _toggle_expand(gid=group_id):
            cur = getattr(self, f"_modg_exp_{gid}", False)
            setattr(self, f"_modg_exp_{gid}", not cur)
            self.show_mod_groups()

        ctk.CTkButton(btn_row,
                      text=toggle_text,
                      fg_color="transparent",
                      hover_color=UIConfig.COLOR_BTN_GRAY,
                      text_color=UIConfig.COLOR_TEXT_MUTED,
                      corner_radius=UIConfig.CORNER_RADIUS_BTN,
                      height=34,
                      font=("Segoe UI", 12),
                      command=_toggle_expand
                      ).pack(side="right")

        # Раскрытый список модов
        if is_expanded:
            list_frame = ctk.CTkFrame(card, fg_color=UIConfig.COLOR_CARD_BG_ALT,
                                       corner_radius=10)
            list_frame.pack(fill="x", padx=20, pady=(0, 14))

            for mod in mods:
                row = ctk.CTkFrame(list_frame, fg_color="transparent")
                row.pack(fill="x", padx=12, pady=2)

                # Иконка статуса
                status_icon = "✓" if mod["enabled"] else "○"
                status_clr = (UIConfig.COLOR_SUCCESS if mod["enabled"]
                              else UIConfig.COLOR_TEXT_GHOST)
                ctk.CTkLabel(row, text=status_icon,
                             font=("Segoe UI Semibold", 12),
                             text_color=status_clr,
                             width=20).pack(side="left")
                # Имя файла
                ctk.CTkLabel(row, text=mod["name"],
                             font=("Segoe UI", 11),
                             text_color=UIConfig.COLOR_TEXT_MAIN
                             if mod["enabled"]
                             else UIConfig.COLOR_TEXT_GHOST,
                             anchor="w").pack(side="left", fill="x",
                                               expand=True, padx=(8, 0))
                # Размер
                ctk.CTkLabel(row,
                             text=f"{mod['size_mb']:.1f} МБ",
                             font=UIConfig.FONT_TINY,
                             text_color=UIConfig.COLOR_TEXT_GHOST,
                             anchor="e").pack(side="right", padx=(8, 12))

                # Тогл индивидуального мода
                def _toggle_one(m=mod):
                    new_state = not m["enabled"]
                    ModGroups.set_mod_enabled(m["path"], new_state)
                    SoundFX.play("info")
                    self.show_mod_groups()

                ctk.CTkButton(row,
                              text="●" if mod["enabled"] else "○",
                              fg_color="transparent",
                              hover_color=UIConfig.COLOR_BTN_GRAY,
                              text_color=status_clr,
                              corner_radius=UIConfig.CORNER_RADIUS_PILL,
                              width=28, height=22,
                              font=("Segoe UI", 12),
                              command=_toggle_one
                              ).pack(side="right")

