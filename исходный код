        ctk.CTkLabel(card, text="МОНИТОР СИСТЕМЫ",
                     font=UIConfig.FONT_TINY,
                     text_color=UIConfig.COLOR_TEXT_GHOST,
                     anchor="w").pack(anchor="w", padx=18, pady=(14, 8))

        row = ctk.CTkFrame(card, fg_color="transparent")
        row.pack(fill="x", padx=18, pady=(0, 14))

        # Диск
        free_gb = self.get_free_space_gb()
        disk_color = (UIConfig.COLOR_SUCCESS if free_gb >= 15
                      else UIConfig.COLOR_WARNING if free_gb >= AppConfig.MIN_DISK_SPACE_GB
                      else UIConfig.COLOR_DANGER)
        self._mini_metric(row, "🖴 Диск", f"{free_gb:.1f} ГБ", disk_color)

        if _PSUTIL_OK:
            mem = psutil.virtual_memory()
            ram_total_gb = mem.total / (1024**3)
            ram_used_gb = mem.used / (1024**3)
            ram_color = (UIConfig.COLOR_SUCCESS if ram_total_gb >= 16
                         else UIConfig.COLOR_WARNING)
            self._mini_metric(row, "🧠 RAM",
                              f"{ram_used_gb:.1f} / {ram_total_gb:.0f} ГБ",
                              ram_color)
            try:
                cpu = psutil.cpu_percent(interval=None)
                cpu_color = (UIConfig.COLOR_SUCCESS if cpu < 60
                             else UIConfig.COLOR_WARNING if cpu < 85
                             else UIConfig.COLOR_DANGER)
                self._mini_metric(row, "⚙ CPU", f"{cpu:.0f} %", cpu_color)
            except Exception:
                pass

        # Бэкап
        backup_folder = get_my_documents() / "Euro Truck Simulator 2" / "Backups_Manager"
        if backup_folder.exists():
            backups = sorted(backup_folder.glob("*.zip"),
                             key=os.path.getmtime, reverse=True)
            if backups:
                last_dt = datetime.fromtimestamp(backups[0].stat().st_mtime)
                days_ago = (datetime.now() - last_dt).days
                bk_color = (UIConfig.COLOR_SUCCESS if days_ago <= 3
                            else UIConfig.COLOR_WARNING if days_ago <= 7
                            else UIConfig.COLOR_DANGER)
                ago_text = ("сегодня" if days_ago == 0
                            else "вчера" if days_ago == 1
                            else f"{days_ago} дн. назад")
                self._mini_metric(row, "📦 Бэкап", ago_text, bk_color)

