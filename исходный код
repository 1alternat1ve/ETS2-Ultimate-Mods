            text="Моды, профили, графика и логи — в одном окне.",
            font=("Segoe UI", 14),
            text_color=UIConfig.COLOR_TEXT_MUTED, anchor="w",
            justify="left").pack(anchor="w", pady=(4, 22))

        # Главные CTA
        cta = ctk.CTkFrame(inner, fg_color="transparent")
        cta.pack(anchor="w", fill="x")

