# --- CONFETTI: праздничная частицы при success-событиях ---
# ==========================================
class Confetti:
    """
    Конфетти-эффект через временный canvas поверх окна.
    60 частиц падают сверху с gravity, вращаются (через width/height),
    исчезают через ~2.5 секунды.
    """
    PARTICLES = 60
    DURATION_MS = 2500
    FPS = 30

    @classmethod
    def burst(cls, root: ctk.CTk):
        """Запускает конфетти на 2.5 секунды поверх root."""
        try:
            import tkinter as tk
            import random as _r
            w = root.winfo_width()
            h = root.winfo_height()
            if w < 100 or h < 100:
                return

            canvas = tk.Canvas(root, width=w, height=h,
                                bg="", highlightthickness=0,
                                bd=0)
            # На place поверх всего
            canvas.place(x=0, y=0, width=w, height=h)
            # ВАЖНО: на Canvas в Python 3.14+ метод lift() перегружен на
            # tag_raise() и требует аргументы. Используем Misc.lift через
            # unbound-вызов — это поднимает виджет в стек как мы хотим.
            try:
                tk.Misc.lift(canvas)
            except Exception:
                pass

            # Сделаем canvas «прозрачным» для кликов — он не должен блокировать
            # окно. tkinter не позволяет полностью игнорировать события, но мы
            # пробросим их на нижележащий виджет через bind.
            try:
                canvas.bind("<Button-1>",
                             lambda e: cls._cleanup_canvas(canvas))
            except Exception:
                pass

            # Палитра ярких цветов
            colors = ["#FF6B6B", "#FFD93D", "#6BCB77", "#4D96FF",
                       "#C77DFF", "#FF6FB5", "#FFA94D", "#74C0FC"]

            particles = []
            for _ in range(cls.PARTICLES):
                x = _r.uniform(0.2, 0.8) * w
                y = _r.uniform(-50, -10)
                size = _r.randint(6, 12)
                vx = _r.uniform(-2, 2)
                vy = _r.uniform(-1, 3)
                color = _r.choice(colors)
                rect_id = canvas.create_rectangle(
                    x, y, x + size, y + size,
                    fill=color, outline="")
                particles.append({
                    "id": rect_id, "x": x, "y": y,
                    "vx": vx, "vy": vy, "size": size,
                    "rotation_phase": _r.uniform(0, 6.28),
                })

            steps_total = cls.DURATION_MS // (1000 // cls.FPS)
            interval = 1000 // cls.FPS

            def _step(i: int):
                try:
                    if i > steps_total or not canvas.winfo_exists():
                        cls._cleanup_canvas(canvas)
                        return
                    import math
                    for p in particles:
                        p["vy"] += 0.18  # gravity
                        p["x"] += p["vx"]
                        p["y"] += p["vy"]
                        # «Вращение» через осциллирующую ширину
                        p["rotation_phase"] += 0.18
                        wobble = math.sin(p["rotation_phase"]) * p["size"] * 0.5
                        try:
                            canvas.coords(
                                p["id"],
                                p["x"] - wobble,
                                p["y"],
                                p["x"] + p["size"] + wobble,
                                p["y"] + p["size"])
                        except Exception:
                            pass
                    # Затухание в последние 30%
                    if i > steps_total * 0.7:
                        try:
                            # Tk не умеет alpha — просто перекрашиваем в более тёмные
                            pass
                        except Exception:
                            pass
                    root.after(interval, lambda: _step(i + 1))
                except Exception as e:
                    logging.error(f"Confetti._step: {e}")
                    cls._cleanup_canvas(canvas)

            _step(1)
        except Exception as e:
            logging.error(f"Confetti.burst: {e}")

    @classmethod
    def _cleanup_canvas(cls, canvas):
        try:
            canvas.destroy()
        except Exception:
            pass


