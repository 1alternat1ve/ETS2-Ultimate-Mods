                next_btn.configure(text="Начать ✓")
            else:
                next_btn.configure(text="Дальше →")

        def go_next():
            if state["idx"] < len(slides) - 1:
                state["idx"] += 1
                render()
            else:
                finish()

        def finish():
            self.settings["first_launch"] = False
            self.save_settings()
            try:
                wiz.destroy()
            except Exception:
                pass

        next_btn.configure(command=go_next)
        wiz.bind("<Escape>", lambda e: finish())
        wiz.bind("<Return>", lambda e: go_next())

        render()

