# --- КОМАНДНАЯ ПАЛИТРА Ctrl+K (как VS Code) ---
# ==========================================
class CommandPalette:
    """
    Поиск-палитра по всем действиям программы.
    Открывается по Ctrl+K. Поиск с дребезгом.
    """
    def __init__(self, root: ctk.CTk):
        self.root = root
        self.window: Optional[ctk.CTkToplevel] = None
        self.commands: List[Tuple[str, str, Callable]] = []
        # Привязываем глобальный shortcut
        try:
            self.root.bind_all("<Control-k>", lambda e: self.open())
            self.root.bind_all("<Control-K>", lambda e: self.open())
        except Exception:
            pass

    def register(self, label: str, group: str, action: Callable):
        """Зарегистрировать команду. Может вызываться много раз."""
        self.commands.append((label, group, action))

    def open(self):
        if self.window and self.window.winfo_exists():
            self.window.lift()
            self.window.focus_force()
            return
        self.window = ctk.CTkToplevel(self.root)
        self.window.title("Команды")
        self.window.geometry("640x420")
        self.window.transient(self.root)
        # Центрируем относительно главного окна
        try:
            x = self.root.winfo_rootx() + self.root.winfo_width() // 2 - 320
            y = self.root.winfo_rooty() + 140
            self.window.geometry(f"+{x}+{y}")
        except Exception:
            pass
        self.window.configure(fg_color=UIConfig.COLOR_CARD_BG)

        # Поле поиска
        self.entry = ctk.CTkEntry(
            self.window, placeholder_text="🔍   Поиск действия…  (Esc — закрыть)",
            font=("Segoe UI", 14), height=46,
            fg_color=UIConfig.COLOR_CARD_BG_ALT,
            border_color=UIConfig.COLOR_BORDER_FOCUS,
            border_width=1,
            corner_radius=10)
        self.entry.pack(fill="x", padx=14, pady=(14, 8))
        self.entry.focus_set()
        self.entry.bind("<KeyRelease>", lambda e: self._refresh())
        self.entry.bind("<Escape>", lambda e: self.close())
        self.entry.bind("<Return>", lambda e: self._activate_first())
        self.entry.bind("<Down>", lambda e: self._move_focus(1))

        # Список результатов
        self.results = ctk.CTkScrollableFrame(
            self.window, fg_color="transparent")
        self.results.pack(fill="both", expand=True, padx=14, pady=(0, 14))

        self._refresh()

    def close(self):
        if self.window:
            self.window.destroy()
            self.window = None

    def _refresh(self):
        if not self.window:
            return
        for w in self.results.winfo_children():
            w.destroy()
        query = self.entry.get().lower().strip()

        # Фильтр + сортировка по релевантности
        items = []
        for label, group, action in self.commands:
            score = 0
            ll = label.lower()
            if not query:
                score = 1
            elif ll.startswith(query):
                score = 100
            elif query in ll:
                score = 50
            elif all(ch in ll for ch in query.split()):
                score = 10
            if score:
                items.append((score, label, group, action))
        items.sort(key=lambda x: -x[0])

        for _, label, group, action in items[:18]:
            self._render_row(label, group, action)

    def _render_row(self, label: str, group: str, action: Callable):
        row = ctk.CTkButton(
            self.results, text="", height=42,
            fg_color="transparent",
            hover_color=UIConfig.COLOR_BTN_GRAY,
            corner_radius=8,
            command=lambda: self._run(action))
        row.pack(fill="x", pady=2)

        # Содержимое: левый-большой текст + правый группа
        inner = ctk.CTkFrame(row, fg_color="transparent")
        inner.place(relx=0, rely=0.5, anchor="w", x=14)
        ctk.CTkLabel(inner, text=label,
                     font=("Segoe UI", 13),
                     text_color=UIConfig.COLOR_TEXT_MAIN,
                     anchor="w").pack(side="left")

        right = ctk.CTkLabel(
            row, text=group,
            font=UIConfig.FONT_TINY,
            text_color=UIConfig.COLOR_TEXT_GHOST,
            fg_color=UIConfig.COLOR_CARD_BG_ALT,
            corner_radius=UIConfig.CORNER_RADIUS_PILL,
            padx=8, pady=2)
        right.place(relx=1, rely=0.5, anchor="e", x=-14)

    def _activate_first(self):
        for w in self.results.winfo_children():
            if isinstance(w, ctk.CTkButton):
                w.invoke()
                return

    def _move_focus(self, _):
        for w in self.results.winfo_children():
            if isinstance(w, ctk.CTkButton):
                w.focus_set()
                return

    def _run(self, action: Callable):
        self.close()
        try:
            action()
        except Exception as e:
            logging.error(f"CommandPalette action: {e}")


