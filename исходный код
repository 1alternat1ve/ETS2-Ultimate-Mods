# --- SOUND FX: короткие звуки через winsound stdlib ---
# ==========================================
class SoundFX:
    """
    Короткие звуковые эффекты без внешних .wav файлов.

    Использует winsound.MessageBeep с разными типами:
      - SUCCESS  → MB_OK (приятный «дзынь»)
      - INFO     → MB_ICONASTERISK
      - WARN     → MB_ICONEXCLAMATION
      - ERROR    → MB_ICONHAND
      - CLICK    → SND_ALIAS «MenuPopup»

    Воспроизведение асинхронное (SND_ASYNC) — не блокирует UI.
    Включается/выключается через settings["sounds_enabled"].
    """
    _enabled = True

    @classmethod
    def set_enabled(cls, on: bool):
        cls._enabled = bool(on)

    @classmethod
    def play(cls, kind: str = "success"):
        if not cls._enabled or not _WINSOUND_OK:
            return
        try:
            mapping = {
                "success": winsound.MB_OK,
                "info":    winsound.MB_ICONASTERISK,
                "warn":    winsound.MB_ICONEXCLAMATION,
                "error":   winsound.MB_ICONHAND,
            }
            beep_type = mapping.get(kind, winsound.MB_OK)
            winsound.MessageBeep(beep_type)
        except Exception:
            pass

    @classmethod
    def click(cls):
        """Тихий «клик» — для кнопок (опционально)."""
        if not cls._enabled or not _WINSOUND_OK:
            return
        try:
            winsound.PlaySound("MenuPopup",
                                winsound.SND_ALIAS | winsound.SND_ASYNC | winsound.SND_NODEFAULT)
        except Exception:
            pass


