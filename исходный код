                messagebox.showerror("Ошибка", f"Не удалось очистить папку: {e}")

    def clean_plugins(self):
        if not self.game_path:
            messagebox.showerror("Ошибка", "Путь к игре не найден. Укажите его в левом нижнем углу меню.")
            return
            
        plugins_dir = self.game_path / "bin" / "win_x64" / "plugins"
        if not plugins_dir.exists() or not any(plugins_dir.iterdir()):
            messagebox.showinfo("Чисто", "У вас не установлены сторонние плагины. Очистка не требуется.")
            return
            
        if messagebox.askyesno("Удаление плагинов", "Это удалит все сторонние .dll файлы (например, телеметрию или TruckersMP) из игры.\nВы уверены?"):
            try:
                desktop = Path(os.path.expanduser("~")) / "Desktop"
                backup_dir = desktop / "ETS2_Plugins_Backup"
                shutil.copytree(plugins_dir, backup_dir, dirs_exist_ok=True)
                
