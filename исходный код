    def _fetch_community_count(self):
        """Загружает в фоне общее число установок Nexus и обновляет лейбл.

        Источник: GitHub Releases API → суммарный download_count
        всех .exe и .zip ассетов из всех релизов.
        Это «общее число скачиваний программы за всё время существования».
        В первые дни релиза цифра маленькая — это нормально.
        """
        def _worker():
            try:
                session = self._get_gh_session()
                total = CommunityMetrics.get_total_downloads(session)
                # Формирование текста с правильными окончаниями
                if total is None:
                    text = "🌐  Сообщество Nexus"
                elif total == 0:
                    text = "🌐  Будь первым в сообществе Nexus"
                elif total == 1:
                    text = "🌐  1 установка · вы здесь первый"
                elif 2 <= total <= 4:
                    text = f"🌐  {total} установки за всё время"
                elif 5 <= total <= 99:
                    text = f"🌐  {total} установок за всё время"
                else:
                    formatted = f"{total:,}".replace(",", " ")
                    # Падежи русского языка
                    last_two = total % 100
                    last = total % 10
                    if 11 <= last_two <= 14:
                        word = "установок"
                    elif last == 1:
                        word = "установка"
                    elif 2 <= last <= 4:
                        word = "установки"
                    else:
                        word = "установок"
                    text = f"🌐  {formatted} {word}  ·  присоединяйся"
                try:
                    self.after(0, lambda t=text: self._community_lbl.configure(
                        text=t, text_color=UIConfig.COLOR_INFO_TEXT))
                except Exception:
                    pass
            except Exception as e:
                logging.error(f"_fetch_community_count: {e}")
                try:
                    self.after(0, lambda: self._community_lbl.configure(
                        text="🌐  Сообщество Nexus",
                        text_color=UIConfig.COLOR_TEXT_GHOST))
                except Exception:
                    pass

        threading.Thread(target=_worker, daemon=True).start()

    def _glass_mix_color(self) -> tuple:
        """
        Возвращает «glass» цвет — лёгкая прозрачная подложка для Hero-карточки.
        В tkinter нет настоящей прозрачности, поэтому мы возвращаем mix
        между COLOR_BG и COLOR_CARD_BG_ALT — он будет выглядеть как «полу-стекло»
        поверх анимированного фона.

        Используем Anim._lerp_color для плавного смешивания.
        """
        try:
            light = Anim._lerp_color(UIConfig.COLOR_BG[0],
                                      UIConfig.COLOR_CARD_BG_ALT[0], 0.55)
            dark = Anim._lerp_color(UIConfig.COLOR_BG[1],
                                     UIConfig.COLOR_CARD_BG_ALT[1], 0.55)
            return (light, dark)
        except Exception:
            return UIConfig.COLOR_CARD_BG

    def _build_home_stats_grid(self, parent):
        """Сетка из 4 stat-карточек (CSS-grid аналог через 4 колонки)."""
        mod_dir = get_my_documents() / "Euro Truck Simulator 2" / "mod"
        if mod_dir.exists():
            mod_count = sum(1 for _ in mod_dir.glob("*.scs")) + sum(1 for _ in mod_dir.glob("*.zip"))
        else:
            mod_count = 0
        dlc_total = len(AppConfig.REQUIRED_DLCS)
        dlc_installed = dlc_total - len(self.get_missing_dlcs())
        backup_folder = get_my_documents() / "Euro Truck Simulator 2" / "Backups_Manager"
        backup_count = sum(1 for _ in backup_folder.glob("*.zip")) if backup_folder.exists() else 0
        free_gb = self.get_free_space_gb()

        grid = ctk.CTkFrame(parent, fg_color="transparent")
        grid.pack(fill="x", padx=8, pady=(0, 18))
        for i in range(4):
            grid.grid_columnconfigure(i, weight=1, uniform="stat")

        cards = [
            ("Модов установлено", str(mod_count) if mod_count else "—",
             "📦", UIConfig.COLOR_ACCENT),
            ("DLC активно", f"{dlc_installed}/{dlc_total}",
             "🗃", UIConfig.COLOR_SUCCESS if dlc_installed == dlc_total
                  else UIConfig.COLOR_WARNING),
            ("Бэкапов", str(backup_count),
             "💾", UIConfig.COLOR_PURPLE),
            ("Свободно на диске", f"{free_gb:.0f} ГБ",
             "🖴", UIConfig.COLOR_DANGER if free_gb < AppConfig.MIN_DISK_SPACE_GB
                  else UIConfig.COLOR_SUCCESS),
        ]
        created_cards = []
        for col, (label, value, icon, color) in enumerate(cards):
            card_widget = self._stat_card(grid, label, value, icon, color, col)
            if card_widget is not None:
                created_cards.append(card_widget)

        # Stagger-эффект: карточки последовательно «пыхают» border'ом
        if created_cards:
            self.after(120, lambda: Anim.stagger_fade_in(
                created_cards, delay_ms=60, root=self))

