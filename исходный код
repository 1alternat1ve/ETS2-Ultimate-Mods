    def clean_crash_dumps(self):
        doc_dir = get_my_documents() / "Euro Truck Simulator 2"
        files_to_remove = ["game.crash.txt", "game.log.bak"]
        removed = 0
        
        for f in files_to_remove:
            target = doc_dir / f
            if target.exists():
                try:
                    os.remove(target)
                    removed += 1
                except Exception as e:
                    log_error("clean_crash_dumps", e)
        
        if removed > 0:
            messagebox.showinfo("Готово", f"Успешно удалено {removed} файлов старых логов/дампов.")
        else:
            messagebox.showinfo("Чисто", "Критических дампов памяти не найдено. Удалять нечего.")

    def clean_screenshots(self):
        screen_dir = get_my_documents() / "Euro Truck Simulator 2" / "screenshot"
        if not screen_dir.exists() or not any(screen_dir.iterdir()):
            messagebox.showinfo("Чисто", "Папка со скриншотами уже пуста!")
            return
            
        if messagebox.askyesno("Очистка", "Вы уверены, что хотите удалить ВСЕ скриншоты? Это действие нельзя отменить."):
            try:
                shutil.rmtree(screen_dir)
