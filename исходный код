        """Переключение паузы через новый UI."""
        if not self.is_syncing:
            return
        self.sync_pause_flag = not self.sync_pause_flag
        if self.sync_pause_flag:
            self._sync_pause_btn.configure(text="▶ Продолжить", fg_color=UIConfig.COLOR_SUCCESS,
                                           hover_color=UIConfig.COLOR_SUCCESS_HOVER, text_color="white")
        else:
            self._sync_pause_btn.configure(text="⏸ Пауза", fg_color=UIConfig.COLOR_WARNING,
