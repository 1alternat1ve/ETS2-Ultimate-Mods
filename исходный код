    def _ui_update_main_progress(self, current: int, total: int, file_name: str = "", speed: float = 0):
        """
        Mission Control: обновление всех виджетов экрана установки.
          • большой % слева
          • общий прогресс-бар (плавно)
          • текущий файл
          • метрики справа: ETA, скорость, файлы, сводка

        Троттлинг: не чаще раза в 120мс (чтобы не нагружать tkinter
        при каждом chunk'е загрузки). Финальное значение всегда проходит.
        """
        try:
            now = time.time()
            last = getattr(self, "_last_progress_ui_tick", 0.0)
            if (now - last) < 0.12 and current < total:
                return
            self._last_progress_ui_tick = now

            if not hasattr(self, '_sync_main_prog') or not self._sync_main_prog.winfo_exists():
                return
            pct = current / total if total > 0 else 0
            pct_int = int(pct * 100)

            # Большой процент слева
            if hasattr(self, "_sync_pct_lbl"):
                self._sync_pct_lbl.configure(text=f"{pct_int}%")
            # Общий прогресс-бар (плавно)
            Anim.smooth_progress_to(self._sync_main_prog, pct,
                                      duration_ms=240, root=self)
            # Сброс файлового прогресса при переходе к новому файлу
            prev_file = getattr(self, "_last_file_name", None)
            if file_name and file_name != prev_file:
                self._last_file_name = file_name
                if hasattr(self, "_sync_file_prog"):
                    self._sync_file_prog.set(0)
            # Текущий файл
            self._sync_sub_lbl.configure(text=file_name if file_name else "Инициализация…")
            # Скорость
            if speed > 0:
                self._sync_speed_lbl.configure(text=f"{speed:.1f} MB/s")
            # ETA
            if total > 0 and pct > 0.001:
                eta_sec = int((time.time() - getattr(self, '_sync_start_time', time.time()))
                              / max(pct, 0.01) * (1 - pct))
                if eta_sec > 0:
                    mins, secs = divmod(eta_sec, 60)
                    if mins > 0:
                        self.sync_eta_lbl.configure(text=f"{mins} мин {secs:02d} сек")
                    else:
                        self.sync_eta_lbl.configure(text=f"{secs} сек")
            # Счётчик файлов
            if hasattr(self, "_files_count_lbl"):
                self._files_count_lbl.configure(text=f"{current} / {total}")
            # Заголовок
            if hasattr(self, "sync_step_lbl"):
                self.sync_step_lbl.configure(
                    text=f"Загрузка пакетов · {current} из {total}")
        except Exception:
            pass

