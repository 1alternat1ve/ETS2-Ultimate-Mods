    def get_steam_game_path(self) -> Optional[Path]:
        try:
            with winreg.OpenKey(winreg.HKEY_CURRENT_USER, r"Software\Valve\Steam") as key:
                steam_path = Path(winreg.QueryValueEx(key, "SteamPath")[0])
                apps_path = steam_path / "steamapps" / "common" / "Euro Truck Simulator 2"
                if apps_path.exists():
                    return apps_path
        except OSError:
            pass

        for drive in string.ascii_uppercase:
            if os.path.exists(f"{drive}:\\"):
                paths = [
                    Path(f"{drive}:/Program Files (x86)/Steam/steamapps/common/Euro Truck Simulator 2"),
                    Path(f"{drive}:/SteamLibrary/steamapps/common/Euro Truck Simulator 2")
                ]
                for p in paths:
                    if p.exists():
                        return p
        return None

    def find_all_game_paths(self) -> List[Path]:
        """Находит все возможные пути к игре (Steam + пиратские)."""
        paths = []

        # Steam
        steam_path = self.get_steam_game_path()
        if steam_path:
            paths.append(steam_path)

        # Поиск по дискам (пиратские копии)
        for drive in string.ascii_uppercase:
            if not os.path.exists(f"{drive}:\\"):
                continue
            for search_path in [
                Path(f"{drive}:/Euro Truck Simulator 2"),
                Path(f"{drive}:/Games/Euro Truck Simulator 2"),
                Path(f"{drive}:/Program Files/Euro Truck Simulator 2"),
                Path(f"{drive}:/Program Files (x86)/Euro Truck Simulator 2"),
                Path(f"{drive}:/ETS2"),
            ]:
                exe = search_path / "bin" / "win_x64" / "eurotrucks2.exe"
                if exe.exists() and search_path not in paths:
                    paths.append(search_path)

        return paths

    def detect_game_type(self, path: Path) -> str:
        """Определяет тип игры: Лицензия (Steam) или Portable/Пиратка."""
        steampath_marker = path / "steamsrc"
        if steampath_marker.exists():
            return "Portable"

        # Проверяем наличие файлов Steam
        if (path / "steam_api64.dll").exists() or (path / "steam_api.dll").exists():
            return "Steam"

        return "Unknown"

