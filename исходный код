    def apply_buffer_page_fix(self):
        cfg_path = self.get_game_config_path()
        if not cfg_path.exists():
            messagebox.showerror("Ошибка доступа", "Файл конфигурации игры не найден. Запустите игру хотя бы один раз.")
            return

        # Атомарная запись: пишем в .tmp, при успехе делаем os.replace.
        # Если упадёт по дороге — оригинал config.cfg останется цел.
        backup_path = cfg_path.with_suffix(".cfg.bak_buffix")
        tmp_path = cfg_path.with_suffix(".cfg.tmp")
        try:
            shutil.copy2(cfg_path, backup_path)  # бэкап ДО изменений
            with open(cfg_path, "r", encoding="utf-8") as f:
                lines = f.readlines()

            found = False
            with open(tmp_path, "w", encoding="utf-8") as f:
                for line in lines:
                    if re.match(r'^\s*uset\s+r_buffer_page_size\s+', line):
                        f.write('uset r_buffer_page_size "100"\n')
                        found = True
                    else:
                        f.write(line)
                if not found:
                    f.write('uset r_buffer_page_size "100"\n')

            os.replace(tmp_path, cfg_path)  # атомарная замена

            if hasattr(self, 'toast'):
                self.toast.show("Патч памяти применён. Бэкап в .cfg.bak_buffix", "success")
            else:
                messagebox.showinfo("Готово", "Патч памяти применен успешно!")
        except Exception as e:
            log_error("apply_buffer_page_fix", e)
            try:
                if tmp_path.exists():
                    tmp_path.unlink()
            except Exception:
                pass
            messagebox.showerror("Ошибка сохранения", f"Не удалось записать файл: {e}")

