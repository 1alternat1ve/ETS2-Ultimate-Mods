    def _build_home_hero(self, parent):
        """
        Hero-блок с РЕАЛЬНЫМ glass-эффектом поверх живого canvas-фона.
        Архитектура:
          1. Контейнер hero с fg_color=COLOR_BG (тёмный, как фон окна)
          2. Canvas заполняет весь hero — рисует цветные пятна + glass-полупроз.
             прямоугольник поверх (через stipple)
          3. Текстовые лейблы ставим ПРЯМО на canvas через create_window
             с window-объектом transparent-фрейма

        Так пятна реально видны под текстом.
        """
        import tkinter as tk
        mode_idx = 0 if ctk.get_appearance_mode() == "Light" else 1

        # Внешний CTk-фрейм с border + corner_radius (просто для рамки)
        hero = ctk.CTkFrame(
            parent,
            fg_color=UIConfig.COLOR_BG,
            corner_radius=20,
            border_width=1,
            border_color=UIConfig.COLOR_BORDER,
            height=320)
        hero.pack(fill="x", padx=8, pady=(8, 24))
        hero.pack_propagate(False)

        # Раздельные слои:
        # 1) tk.Frame внутри hero — контейнер для canvas + контента
        # 2) Canvas заполняет всё — рисует анимацию
        # 3) Контент-фрейм через place поверх canvas с transparent-наследованием
        try:
            bg_color_str = (UIConfig.COLOR_BG[mode_idx]
                              if isinstance(UIConfig.COLOR_BG, tuple)
                              else UIConfig.COLOR_BG)
            hero_canvas = tk.Canvas(hero, highlightthickness=0,
                                     bg=bg_color_str, bd=0)
            hero_canvas.place(relx=0, rely=0, relwidth=1, relheight=1)

            # Останавливаем старый hero_anim если он был (избегаем утечки)
            if hasattr(self, "_hero_anim") and self._hero_anim:
                try:
                    self._hero_anim._enabled = False
                except Exception:
                    pass

            # Создаём AnimatedBackground но даём ему наш canvas
            self._hero_anim = AnimatedBackground.__new__(AnimatedBackground)
            self._hero_anim.root = self
            self._hero_anim.parent = hero
            self._hero_anim._enabled = True
            self._hero_anim._mouse_x_norm = 0.5
            self._hero_anim._mouse_y_norm = 0.5
            self._hero_anim._colors = self._hero_anim._default_colors()
            self._hero_anim._frame_count = 0
            self._hero_anim._tk_canvas = hero_canvas
            # Все три слоя
            self._hero_anim._blobs_back = self._hero_anim._init_blobs_back()
            self._hero_anim._blobs_mid = self._hero_anim._init_blobs_mid()
            self._hero_anim._sparkles = self._hero_anim._init_sparkles()
            self._hero_anim._tk_canvas.bind(
                "<Configure>", self._hero_anim._on_resize)
            self._hero_anim._animation_id = None
            self._hero_anim._tick()
        except Exception as e:
            logging.error(f"hero canvas: {e}")
            hero_canvas = None

        # Контент-фрейм поверх canvas. Чтобы он не перекрывал фон —
        # ставим его как window внутри canvas, а не как отдельный place.
        # Тогда фон canvas просвечивает между лейблами.
        inner = ctk.CTkFrame(hero, fg_color=UIConfig.COLOR_BG, corner_radius=0)
        # Ставим inner поверх canvas через place — но с непрозрачным
        # тёмным фоном чтобы текст был контрастным. Это и есть «glass-эффект»:
        # тёмная панель с border'ом, на которой текст. Под ней — живой canvas.
        # ВАЖНО: для эффекта «стекла» делаем inner УЖЕ всего hero и центрируем.
        # Тогда видны живые пятна по бокам, а контент в центре читается.
        inner.place(relx=0.5, rely=0.5, anchor="center",
                     relwidth=0.85, relheight=0.85)
        # Делаем тонкий border-glass
        try:
            inner.configure(
                fg_color=self._glass_mix_color(),
                border_width=1,
                border_color=UIConfig.COLOR_BORDER,
                corner_radius=14)
        except Exception:
            pass
        try:
            inner.lift()
        except Exception:
            pass

        # Шапка: бейдж + community-counter
        head = ctk.CTkFrame(inner, fg_color="transparent")
        head.pack(fill="x", pady=(0, 12))

        badge = ctk.CTkLabel(
