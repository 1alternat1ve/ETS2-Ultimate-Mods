    def _render_log_issues(self, parent, issues: List[LogIssue]):
        """Рисует карточки обнаруженных проблем с пошаговыми решениями."""
        # Сводка
        sev_counts = {"critical": 0, "high": 0, "medium": 0, "low": 0}
        for issue in issues:
            sev_counts[issue.severity] = sev_counts.get(issue.severity, 0) + 1

        summary = ctk.CTkFrame(parent, fg_color="transparent")
        summary.pack(fill="x", padx=20, pady=(0, 8))
        for sev, label, color in [
            ("critical", "Критичных", UIConfig.COLOR_DANGER),
            ("high",     "Серьёзных", UIConfig.COLOR_WARNING),
            ("medium",   "Средних",   UIConfig.COLOR_ACCENT),
            ("low",      "Информации",UIConfig.COLOR_TEXT_MUTED),
        ]:
            count = sev_counts.get(sev, 0)
            if count == 0:
                continue
            ctk.CTkLabel(
                summary, text=f"  {label}: {count}  ",
                font=("Segoe UI Semibold", 11),
                text_color=color,
                fg_color=UIConfig.COLOR_CARD_BG_ALT,
                corner_radius=UIConfig.CORNER_RADIUS_PILL,
                padx=8, pady=2).pack(side="left", padx=(0, 6))

        # Карточки проблем
        for issue in issues:
            self._render_one_issue(parent, issue)

    def _render_one_issue(self, parent, issue: LogIssue):
        """Карточка одной проблемы со всеми решениями."""
        sev_color = {
            "critical": UIConfig.COLOR_DANGER,
            "high":     UIConfig.COLOR_WARNING,
            "medium":   UIConfig.COLOR_ACCENT,
            "low":      UIConfig.COLOR_TEXT_MUTED,
        }.get(issue.severity, UIConfig.COLOR_TEXT_MUTED)

        sev_icon = {
            "critical": "🛑", "high": "⚠️",
            "medium": "ℹ️", "low": "💡",
        }.get(issue.severity, "·")

        sev_label = {
            "critical": "КРИТИЧНО", "high": "СЕРЬЁЗНО",
            "medium": "СРЕДНЕЕ",   "low": "ИНФО",
        }.get(issue.severity, "")

        card = ctk.CTkFrame(
            parent, fg_color=UIConfig.COLOR_CARD_BG,
            corner_radius=UIConfig.CORNER_RADIUS_CARD,
            border_width=1, border_color=sev_color)
        card.pack(fill="x", padx=20, pady=(0, 10))

        inner = ctk.CTkFrame(card, fg_color="transparent")
        inner.pack(fill="x", padx=18, pady=14)

        # Header: severity icon + title + matched_lines
        head = ctk.CTkFrame(inner, fg_color="transparent")
        head.pack(fill="x")
        ctk.CTkLabel(head, text=sev_icon, font=("Segoe UI", 18),
                     text_color=sev_color).pack(side="left", padx=(0, 8))
        ctk.CTkLabel(
            head, text=f"  {sev_label}  ",
            font=UIConfig.FONT_TINY,
            text_color="white",
            fg_color=sev_color,
            corner_radius=UIConfig.CORNER_RADIUS_PILL,
            padx=8, pady=2).pack(side="left", padx=(0, 8))
        ctk.CTkLabel(head, text=issue.title,
                     font=("Segoe UI Semibold", 14),
                     text_color=UIConfig.COLOR_TEXT_MAIN,
                     anchor="w").pack(side="left")
        if issue.matched_lines > 0:
            ctk.CTkLabel(head,
                          text=f"× {issue.matched_lines}",
                          font=UIConfig.FONT_TINY,
                          text_color=UIConfig.COLOR_TEXT_GHOST).pack(side="right")

        # Описание
        ctk.CTkLabel(inner, text=issue.description,
                     font=("Segoe UI", 12),
                     text_color=UIConfig.COLOR_TEXT_MUTED,
                     wraplength=900, justify="left",
                     anchor="w").pack(anchor="w", pady=(8, 0))

        # Stats hint
        if issue.stats_hint:
            ctk.CTkLabel(inner, text=f"📊  {issue.stats_hint}",
                         font=UIConfig.FONT_TINY,
                         text_color=UIConfig.COLOR_INFO_TEXT,
                         anchor="w").pack(anchor="w", pady=(6, 0))

        # Список решений
        if issue.solutions:
            ctk.CTkLabel(inner, text="ШАГИ ДЛЯ РЕШЕНИЯ",
                         font=UIConfig.FONT_TINY,
                         text_color=UIConfig.COLOR_TEXT_GHOST,
                         anchor="w").pack(anchor="w", pady=(12, 4))
            for i, sol in enumerate(issue.solutions, 1):
                row = ctk.CTkFrame(inner, fg_color="transparent")
                row.pack(fill="x", pady=2)
                ctk.CTkLabel(row, text=f"{i}.",
                             font=("Segoe UI Semibold", 12),
                             text_color=sev_color, width=24,
                             anchor="w").pack(side="left")
                ctk.CTkLabel(row, text=sol,
                             font=("Segoe UI", 12),
                             text_color=UIConfig.COLOR_TEXT_MAIN,
                             anchor="w", wraplength=860,
                             justify="left").pack(side="left", fill="x",
                                                   expand=True)

        # Кнопка «Искать в Google» если есть смысл
        ctk.CTkButton(
            inner, text=f"🔍  Искать «{issue.title}» в Google",
            fg_color="transparent",
            border_width=1, border_color=UIConfig.COLOR_BORDER,
            hover_color=UIConfig.COLOR_BTN_GRAY,
            text_color=UIConfig.COLOR_TEXT_MUTED,
            corner_radius=UIConfig.CORNER_RADIUS_BTN,
            height=32, font=("Segoe UI", 11),
            command=lambda t=issue.title: webbrowser.open(
                f"https://www.google.com/search?q="
                f"{urllib.parse.quote(f'ETS2 {t}')}")
        ).pack(anchor="w", pady=(10, 0))

    def _on_log_filter_change(self, key: str, var: ctk.BooleanVar):
        """Изменилась галочка фильтра логов — перерисовываем."""
        self._log_filter_state[key] = bool(var.get())
        # Перерисовка через перерендер страницы
        self.show_log_viewer()

    def show_log_viewer(self):
        self.clear_content()
        self.set_status("ИИ-Анализ состояния движка")
        ctk.CTkLabel(self.main_content, text="📄 Умный анализ логов (game.log)", font=UIConfig.FONT_TITLE, text_color=UIConfig.COLOR_TEXT_MAIN).pack(pady=(10, 5), anchor="w")
