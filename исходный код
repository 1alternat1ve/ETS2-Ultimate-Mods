    def _render_auto_tune_result(self, info: HardwareInfo):
        """Отрисовывает карточки с детектом + рекомендуемый пресет."""
        # Защита: если пользователь ушёл со страницы до завершения детекта,
        # фрейм уничтожен — выходим тихо
        if not hasattr(self, "_auto_tune_result_frame"):
            return
        try:
            if not self._auto_tune_result_frame.winfo_exists():
                return
        except Exception:
            return

        try:
            self._auto_tune_status.configure(
                text="✓ Сканирование завершено",
                text_color=UIConfig.COLOR_SUCCESS)
        except Exception:
            pass

        # Очищаем предыдущий результат если есть
        try:
            for w in self._auto_tune_result_frame.winfo_children():
                w.destroy()
        except Exception:
            return

        # ─── Карточки с деталями железа ──
        details = ctk.CTkFrame(self._auto_tune_result_frame, fg_color="transparent")
        details.pack(fill="x", pady=(0, 14))
        for i in range(3):
            details.grid_columnconfigure(i, weight=1, uniform="hw")

        cards = [
            ("⚙ CPU",
             info.cpu_name or "Неизвестно",
             f"{info.cpu_cores} ядер" if info.cpu_cores else "—",
             UIConfig.COLOR_ACCENT),
            ("🎮 GPU",
             info.gpu_name or "Неизвестно",
             f"{info.gpu_vram_mb} МБ VRAM" if info.gpu_vram_mb else "VRAM не определён",
             UIConfig.COLOR_PURPLE),
            ("🧠 RAM",
             f"{info.ram_total_gb:.0f} ГБ",
             "хорошо" if info.ram_total_gb >= 16
             else "достаточно" if info.ram_total_gb >= 8 else "мало",
             UIConfig.COLOR_SUCCESS if info.ram_total_gb >= 16
             else UIConfig.COLOR_WARNING),
