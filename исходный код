    def setup_ui(self):
        # Сетка: сайдбар | контент | статусбар
        self.grid_columnconfigure(1, weight=1)
        self.grid_rowconfigure(0, weight=1)   # контент
        self.grid_rowconfigure(1, weight=0)   # панель активной задачи
        self.grid_rowconfigure(2, weight=0)   # статус-бар
        self.configure(fg_color=UIConfig.COLOR_BG)

        # ──────────────────────────────────────────────
        # АНИМИРОВАННЫЙ ФОН (плавающие градиентные пятна)
        #
        # ВАЖНО: tkinter не поддерживает настоящую прозрачность фреймов.
        # Поэтому мы НЕ кладём Canvas ПОД main_content (он бы всё равно
        # был перекрыт). Вместо этого Canvas виден:
        #  - по краям окна (padding 30px вокруг main_content)
        #  - в статус-баре снизу (там пусто)
        #  - в специальной зоне Hero-блока на главной (через place поверх)
        #
        # Сейчас просто подкладываем Canvas как самый низкий слой —
        # он создаст «свечение» на доступных участках окна.
        # ──────────────────────────────────────────────
