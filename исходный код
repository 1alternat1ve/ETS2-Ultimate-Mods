    def _test_pick_file(self):
        """Открывает file picker, валидирует .scs файл, запускает тест."""
        path = filedialog.askopenfilename(
            title="Выбор .scs мода для тестирования",
            filetypes=[("ETS2 Mod", "*.scs"), ("Все файлы", "*.*")])
        if not path:
            return
        path = Path(path)
        if path.suffix.lower() != ".scs":
            messagebox.showerror(
                "Не .scs файл",
                "Тестовый режим работает только с файлами .scs.\n"
                "Если у вас архив (.zip, .7z) — распакуйте его сначала.")
            return

        if is_game_running():
            messagebox.showerror(
                "Игра запущена",
                "Закройте игру перед тестовым запуском.")
            return

        # Проверим — может уже есть мод с таким именем
        mod_dir = get_my_documents() / "Euro Truck Simulator 2" / "mod"
        target = mod_dir / path.name
        if target.exists():
            if not messagebox.askyesno(
                    "Файл уже есть",
                    f"Мод {path.name} уже установлен.\n\n"
                    "Тестовый режим не нужен — он уже в вашей сборке. "
                    "Запустить игру обычным способом?"):
                return
            self.launch_game()
            return

        # Подтверждение
        size_mb = path.stat().st_size / (1024 * 1024)
        if not messagebox.askyesno(
                "Тестовый запуск",
                f"Запустить ETS2 с временным модом?\n\n"
                f"Мод: {path.name}\n"
                f"Размер: {size_mb:.1f} МБ\n\n"
                "После закрытия игры программа предложит оставить или откатить."):
            return

        # Создаём snapshot
        try:
            mod_dir.mkdir(parents=True, exist_ok=True)
            snapshot = set(f.name for f in mod_dir.iterdir() if f.is_file())
            shutil.copy2(path, target)
        except Exception as e:
            log_error("_test_pick_file copy", e)
            messagebox.showerror("Ошибка копирования", str(e))
            return

        self._test_session = {
            "started_at": datetime.now().isoformat(),
            "test_mod_name": path.name,
            "test_mod_path": target,
            "test_mod_size": size_mb,
            "snapshot": snapshot,
            "source_path": str(path),
        }

        if hasattr(self, "toast"):
            self.toast.show(
                f"🧪 Тестовый мод установлен: {path.name}",
                "success", duration_ms=5000)
        SoundFX.play("success")

        # Запускаем игру
        self.launch_game()

        # Перерисуем страницу чтобы показать активную сессию
        self.show_test_mode()

