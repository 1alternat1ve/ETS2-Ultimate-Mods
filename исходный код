        ref_dir = AppConfig.TEMP_SYNC_DIR / "reference_profile_ext"
        if ref_dir.exists() and any(ref_dir.rglob("profile.sii")):
            return ref_dir

        self.safe_log_colored("🌐 Скачивание эталонного профиля (для синхронизации)...", "muted")
        session = requests.Session()
        session.headers.update({"User-Agent": "ETS2-Nexus/1.0"})
        try:
            api_url = AppConfig.GITHUB_API_URL.replace("/latest", "")
            resp = session.get(api_url, timeout=10)
            resp.raise_for_status()

            releases = resp.json()
            if isinstance(releases, dict):
                releases = [releases]

            download_asset = None
            for release in releases:
                for asset in release.get('assets', []):
                    if asset['name'] == "reference_profile.7z":
                        download_asset = asset
                        break
                if download_asset: break

            if not download_asset:
