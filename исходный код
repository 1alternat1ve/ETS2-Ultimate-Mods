# --- ВСТРОЕННЫЙ ДЕШИФРАТОР SII (без внешнего EXE) ---
# ==========================================
class SiiDecryptor:
    """
    Дешифрует SII-файлы ETS2 (формат ScsC) средствами Python.
    Заменяет внешний SII_Decrypt.exe, на который ругаются антивирусы.

    Алгоритм публичен: AES-256-CBC, ключ зашит в исходнике (открыт сообществом).
    После дешифрации применяется zlib.decompress.

    Поддерживаемые форматы:
      - SiiNunit (текст) — пропускает, файл уже читаемый
      - ScsC      — AES-256-CBC + zlib (поддерживается)
      - BSII      — бинарный, fallback к SII_Decrypt.exe (редкий формат)
    """
    SCSC_MAGIC = b"ScsC"
    SIIN_MAGIC = b"SiiNunit"
    BSII_MAGIC = b"BSII"

    # AES-256 ключ ETS2 (публичный, опубликован в сообществе моддеров)
    ETS2_AES_KEY = bytes.fromhex(
        "2A5FCB17919D8CDFC53C7DDA0B36DBA73B70A0BBE6F2A2BFCFA1DDB73A40C7E1"
    )

    @classmethod
    def is_available(cls) -> bool:
        """True если ЛЮБОЙ способ AES доступен (pycryptodome ИЛИ BCrypt API)."""
        return _PYCRYPTODOME_OK or cls._is_bcrypt_available()

    @staticmethod
    def _is_bcrypt_available() -> bool:
        """Проверяет наличие Windows BCrypt API (есть в любой Windows 7+)."""
        try:
            ctypes.windll.bcrypt
            return True
        except Exception:
            return False

    @classmethod
    def _aes_cbc_decrypt_bcrypt(cls, key: bytes, iv: bytes,
                                  ciphertext: bytes) -> bytes:
        """
        AES-256-CBC расшифровка через Windows BCrypt API (нативный,
        без зависимостей). Работает на Windows 7+.

        Ссылка: https://learn.microsoft.com/en-us/windows/win32/api/bcrypt/
        """
        from ctypes import wintypes, byref, create_string_buffer, c_void_p

        bcrypt = ctypes.windll.bcrypt
        BCRYPT_SUCCESS = 0
        BCRYPT_AES_ALGORITHM = "AES"
        BCRYPT_CHAIN_MODE_CBC = "ChainingModeCBC"
        BCRYPT_CHAINING_MODE = "ChainingMode"

        # 1. Открыть провайдер AES
        h_alg = c_void_p()
        status = bcrypt.BCryptOpenAlgorithmProvider(
            byref(h_alg),
            ctypes.c_wchar_p(BCRYPT_AES_ALGORITHM),
            None, 0)
        if status != BCRYPT_SUCCESS:
            raise OSError(f"BCryptOpenAlgorithmProvider: 0x{status:08X}")

        try:
            # 2. Установить режим CBC
            mode_bytes = (BCRYPT_CHAIN_MODE_CBC + "\x00").encode("utf-16-le")
            status = bcrypt.BCryptSetProperty(
                h_alg,
                ctypes.c_wchar_p(BCRYPT_CHAINING_MODE),
                mode_bytes, len(mode_bytes), 0)
            if status != BCRYPT_SUCCESS:
                raise OSError(f"BCryptSetProperty: 0x{status:08X}")

            # 3. Создать ключ
            h_key = c_void_p()
            status = bcrypt.BCryptGenerateSymmetricKey(
                h_alg, byref(h_key), None, 0,
                key, len(key), 0)
            if status != BCRYPT_SUCCESS:
                raise OSError(f"BCryptGenerateSymmetricKey: 0x{status:08X}")

            try:
                # 4. Расшифровать (без padding — мы сами знаем длину)
                BCRYPT_BLOCK_PADDING = 0x01
                output = create_string_buffer(len(ciphertext))
                output_size = wintypes.ULONG(0)
                # IV копируем в mutable buffer т.к. BCrypt модифицирует его
                iv_buf = create_string_buffer(iv, len(iv))
                status = bcrypt.BCryptDecrypt(
                    h_key,
                    ciphertext, len(ciphertext),
                    None,                         # padding info
                    iv_buf, len(iv),
                    output, len(output),
                    byref(output_size),
                    0)                            # без padding flag — raw CBC
                if status != BCRYPT_SUCCESS:
                    raise OSError(f"BCryptDecrypt: 0x{status:08X}")
                return output.raw[:output_size.value]
            finally:
                bcrypt.BCryptDestroyKey(h_key)
        finally:
            bcrypt.BCryptCloseAlgorithmProvider(h_alg, 0)

    @classmethod
    def detect_format(cls, path: Path) -> str:
        """Возвращает 'siinunit' | 'scsc' | 'bsii' | 'unknown'."""
        try:
            with open(path, "rb") as f:
                head = f.read(8)
            if head.startswith(cls.SIIN_MAGIC):
                return "siinunit"
            if head.startswith(cls.SCSC_MAGIC):
                return "scsc"
            if head.startswith(cls.BSII_MAGIC):
                return "bsii"
            return "unknown"
        except OSError:
            return "unknown"

    @classmethod
    def decrypt_file(cls, path: Path, make_backup: bool = True) -> bool:
        """
        Дешифрует файл инплейс. Делает .bak если make_backup=True.

        Стратегия (несколько fallback'ов):
          1. pycryptodome (быстрее, лучше)
          2. Windows BCrypt API (нативный, есть в Windows 7+)
          3. Если оба недоступны — возвращает False
        """
        if not path.exists():
            return False

        fmt = cls.detect_format(path)
        if fmt == "siinunit":
            return True  # уже текстовый
        if fmt != "scsc":
            return False  # BSII / unknown

        try:
            data = path.read_bytes()
            # Структура ScsC: 4 байта magic + 32 байта HMAC + 16 байт IV + payload
            iv = data[36:52]
            payload = data[56:]

            # === Способ 1: pycryptodome ===
            plaintext = None
            if _PYCRYPTODOME_OK:
                try:
                    cipher = _AES.new(cls.ETS2_AES_KEY, _AES.MODE_CBC, iv)
                    plaintext = cipher.decrypt(payload)
                except Exception as e:
                    logging.error(f"SiiDecryptor pycryptodome failed: {e}")

            # === Способ 2: Windows BCrypt API (fallback) ===
            if plaintext is None and cls._is_bcrypt_available():
                try:
                    plaintext = cls._aes_cbc_decrypt_bcrypt(
                        cls.ETS2_AES_KEY, iv, payload)
                    logging.info("SiiDecryptor: расшифровано через BCrypt API")
                except Exception as e:
                    logging.error(f"SiiDecryptor BCrypt failed: {e}")

            if plaintext is None:
                logging.error("SiiDecryptor: ни один AES-провайдер недоступен")
                return False

            # zlib decompress (payload SCS-сохранения ВСЕГДА сжат zlib).
            # Если zlib не справился — это значит ключ/IV/payload неверны
            # ИЛИ формат файла не наш. Лучше НЕ ПИСАТЬ ничего, чем
            # испортить профиль мусором.
            import zlib
            try:
                decompressed = zlib.decompress(plaintext)
            except zlib.error as e:
                logging.error(
                    f"SiiDecryptor: zlib не смог разжать (неверный ключ/IV "
                    f"или нестандартный формат): {e}")
                return False

            # Дополнительная проверка: расшифрованный текст ДОЛЖЕН начинаться
            # с "SiiNunit" — magic текстового SII. Если нет — это битый
            # результат, не пишем.
            if not decompressed.startswith(b"SiiNunit"):
                logging.error(
                    "SiiDecryptor: результат не похож на SiiNunit — "
                    "файл оставлен без изменений для безопасности.")
                return False

            if make_backup:
                bak = path.with_suffix(path.suffix + ".bak")
                if not bak.exists():
                    shutil.copy2(path, bak)

            # Атомарная запись результата
            tmp = path.with_suffix(path.suffix + ".dec.tmp")
            tmp.write_bytes(decompressed)
            os.replace(tmp, path)
            return True
        except Exception as e:
            logging.error(f"SiiDecryptor.decrypt_file({path}): {e}")
            return False


