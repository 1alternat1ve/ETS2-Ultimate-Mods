        self.finish_btn = ctk.CTkButton(self.main_content, text="Выполняется загрузка...", state="disabled", fg_color=UIConfig.COLOR_BTN_GRAY, text_color="gray", corner_radius=UIConfig.CORNER_RADIUS_BTN, height=45, font=UIConfig.FONT_BOLD)
        self.finish_btn.pack(pady=15, side="right")
        
        threading.Thread(target=self.sync_engine, daemon=True).start()

    def safe_log_colored(self, msg: str, tag: str = "muted"):
        timestamp = datetime.now().strftime("%H:%M:%S")
        self.after(0, self._insert_log_colored, f"[{timestamp}] {msg}", tag)

    def _insert_log_colored(self, text: str, tag: str):
        self.log_box.configure(state="normal")
        self.log_box.insert("end", f"{text}\n", tag)
        self.log_box.see("end")
        self.log_box.configure(state="disabled")

    def _update_sync_ui_current(self, file_name: str, current: int, total: int):
        percent = current / total if total > 0 else 1
        self.progress_var.set(percent)
        self.progress_text.configure(text=f"Обработка файлов: {current} из {total} ({int(percent * 100)}%)")
        self.current_file_label.configure(text=f"Файл: {file_name}")

    def _finish_sync_ui(self):
        self.progress_var.set(1.0)
        self.progress.configure(progress_color=UIConfig.COLOR_SUCCESS)
        self.progress_text.configure(text="Установка завершена успешно!", text_color=UIConfig.COLOR_SUCCESS)
        
        summary = f"📊 Сводка: Скачано/Установлено: {self.sync_stats['installed']} | Ошибок: {self.sync_stats['errors']} | Пропущено (Кэш): {self.sync_stats['skipped']}"
        self.current_file_label.configure(text=summary, text_color=UIConfig.COLOR_TEXT_MAIN, font=("Segoe UI", 13, "bold"))

        self.finish_btn.configure(text="▶ ЗАПУСТИТЬ ИГРУ", state="normal", fg_color=UIConfig.COLOR_SUCCESS, hover_color=UIConfig.COLOR_SUCCESS_HOVER, text_color="white", command=self.launch_game)
        self.set_status("Система готова к запуску")

    def _error_sync_ui(self):
        self.progress.configure(progress_color=UIConfig.COLOR_DANGER)
        self.progress_text.configure(text="Процесс прерван. Произошла ошибка.", text_color=UIConfig.COLOR_DANGER)
        self.set_status("Ошибка во время установки")
        
        self.finish_btn.configure(text="Вернуться на Главную", state="normal", fg_color=UIConfig.COLOR_DANGER, hover_color=UIConfig.COLOR_DANGER_HOVER, text_color="white", command=self.show_home)

    def _ensure_sii_decrypt(self):
        """Интеллектуальная загрузка дешифратора с защитой от лимитов API и проверкой."""
        sii_path = AppConfig.TEMP_SYNC_DIR / "SII_Decrypt.exe"
        if sii_path.exists():
            return sii_path

        self.safe_log_colored("🌐 Скачивание системной утилиты SII_Decrypt...", "muted")
        AppConfig.TEMP_SYNC_DIR.mkdir(parents=True, exist_ok=True)
        try:
            # 1. Попытка через основной API
            api_url = AppConfig.GITHUB_API_URL.replace("/latest", "")
            resp = requests.get(api_url, timeout=5)
            resp.raise_for_status()
            
            releases = resp.json()
            if isinstance(releases, dict): 
                releases = [releases]
                
            download_url = None
            for release in releases:
                for asset in release.get('assets', []):
                    if asset['name'] == "SII_Decrypt.exe":
                        download_url = asset['browser_download_url']
                        break
                if download_url: break
                
            if not download_url:
                raise Exception("Файл не найден ни в одном релизе API.")
                
            with requests.get(download_url, stream=True, timeout=10) as r:
                r.raise_for_status()
                with open(sii_path, 'wb') as f:
                    for chunk in r.iter_content(chunk_size=8192):
                        f.write(chunk)
            return sii_path
        except Exception as api_err:
            log_error("_ensure_sii_decrypt_api_fail", api_err)
            self.safe_log_colored(f"⚠️ Сбой API ({api_err}). Переход на прямую ссылку-фоллбэк...", "warn")
            
            # 2. Фоллбэк: прямая загрузка
            try:
                with requests.get(AppConfig.FALLBACK_DECRYPT_URL, stream=True, timeout=10) as r:
                    r.raise_for_status()
                    with open(sii_path, 'wb') as f:
                        for chunk in r.iter_content(chunk_size=8192):
                            f.write(chunk)
                return sii_path
            except Exception as direct_err:
                log_error("_ensure_sii_decrypt_direct_fail", direct_err)
                self.safe_log_colored("❌ Полный сбой загрузки компонента.", "error")
                return None

    def _cleanup_sii_decrypt(self):
        sii_path = AppConfig.TEMP_SYNC_DIR / "SII_Decrypt.exe"
        try:
            if sii_path.exists():
                sii_path.unlink()
        except Exception:
            pass

    def _ensure_reference_profile(self):
        ref_dir = AppConfig.TEMP_SYNC_DIR / "reference_profile_ext"
        if ref_dir.exists() and any(ref_dir.rglob("profile.sii")):
            return ref_dir

        self.safe_log_colored("🌐 Скачивание эталонного профиля (для синхронизации)...", "muted")
        try:
            api_url = AppConfig.GITHUB_API_URL.replace("/latest", "")
            resp = requests.get(api_url)
            resp.raise_for_status()
            
            releases = resp.json()
            if isinstance(releases, dict):
                releases = [releases]
                
            download_asset = None
            for release in releases:
                for asset in release.get('assets', []):
                    if asset['name'] == "reference_profile.7z":
                        download_asset = asset
                        break
                if download_asset: break
                
            if not download_asset:
                return None
                
            target = AppConfig.TEMP_SYNC_DIR / download_asset['name']
            with requests.get(download_asset['browser_download_url'], stream=True) as r:
                r.raise_for_status()
                with open(target, 'wb') as f:
                    for chunk in r.iter_content(chunk_size=8192):
                        f.write(chunk)
                        
            with py7zr.SevenZipFile(target, mode='r') as z:
                z.extractall(path=ref_dir)
            if self.settings.get("direct_unpack_mode", False):
                target.unlink()
            return ref_dir
        except Exception as e:
            log_error("_ensure_reference_profile", e)
            return None

    def sync_engine(self):
        self.after(0, self.set_status, "Соединение с облачным хранилищем...")
        try:
            self.safe_log_colored("[СИСТЕМА] Запуск сетевого установщика...", "info")
            self.safe_log_colored("💾 [БЭКАП] Создание резервной копии перед установкой...", "muted")
            self.create_backup(silent=True)

            ets_folder = get_my_documents() / "Euro Truck Simulator 2"
            mod_dir = ets_folder / "mod"
            mod_dir.mkdir(parents=True, exist_ok=True)
            AppConfig.TEMP_SYNC_DIR.mkdir(parents=True, exist_ok=True)

            self.safe_log_colored("🌐 [СЕТЬ] Получение списка файлов со всех релизов...", "muted")
            api_url_all = AppConfig.GITHUB_API_URL.replace("/latest", "")
            resp = requests.get(api_url_all)
            resp.raise_for_status()
            
            releases = resp.json()
            if isinstance(releases, dict):
                releases = [releases]

            # Собираем актуальные версии файлов со всех последних релизов
            assets_dict = {}
            for release in releases:
                for asset in release.get('assets', []):
                    name = asset['name']
                    # Игнорируем .exe файлы (саму программу-обновление), чтобы не качать их как моды
                    if name.endswith('.exe') and name != "SII_Decrypt.exe":
                        continue
                        
                    # Сохраняем только самую новую найденную версию каждого файла 
                    # (так как API выдает релизы от новых к старым)
                    if name not in assets_dict:
                        assets_dict[name] = asset
                        
            assets = list(assets_dict.values())

            self.sync_stats = {'total': len(assets), 'current': 0, 'installed': 0, 'updated': 0, 'errors': 0, 'skipped': 0}
            direct_unpack = self.settings.get("direct_unpack_mode", False)

            def download_asset(asset_dict, target_path):
                asset_size = asset_dict['size']
                asset_name = asset_dict['name']
                download_url = asset_dict['browser_download_url']

                if target_path.exists() and target_path.stat().st_size == asset_size:
                    self.safe_log_colored(f"⏭ [КЭШ] {asset_name} совпадает по весу, пропускаем скачивание.", "muted")
                    self.sync_stats['skipped'] += 1
                    return True

                self.safe_log_colored(f"⬇️ [ЗАГРУЗКА] {asset_name} ({(asset_size/(1024*1024)):.1f} MB)...", "warn")
                try:
                    with requests.get(download_url, stream=True) as r:
                        r.raise_for_status()
                        with open(target_path, 'wb') as f:
                            for chunk in r.iter_content(chunk_size=8192):
                                if chunk: f.write(chunk)
                    self.sync_stats['installed'] += 1
                    return True
                except Exception as e:
                    self.safe_log_colored(f"⚠️ [ОШИБКА ЗАГРУЗКИ] {asset_name}: {e}", "error")
                    self.sync_stats['errors'] += 1
                    if target_path.exists(): target_path.unlink()
                    return False

            self.safe_log_colored("\n[1/4] ОБРАБОТКА И УСТАНОВКА МОДОВ / DLC", "info")
            for asset in assets:
                self.sync_stats['current'] += 1
                self.after(0, self._update_sync_ui_current, asset['name'], self.sync_stats['current'], self.sync_stats['total'])
                name = asset['name']

                if name == "SII_Decrypt.exe":
                    continue 

                elif name.startswith("dlc") and name.endswith(".scs"):
                    if self.game_path:
                        target = self.game_path / name
                        download_asset(asset, target)
                    else:
                        self.safe_log_colored(f"⚠️ [ВНИМАНИЕ] Путь к игре не найден. Пропуск DLC: {name}", "warn")

                elif name == "bin.7z":
                    if self.game_path:
                        target = AppConfig.TEMP_SYNC_DIR / name
                        if download_asset(asset, target):
                            self.safe_log_colored(f"📦 [РАСПАКОВКА] Интеграция {name} в bin/win_x64...", "info")
                            with py7zr.SevenZipFile(target, mode='r') as z:
                                z.extractall(path=self.game_path)
                            if direct_unpack: target.unlink(missing_ok=True)

                elif name == "reference_profile.7z":
                    target = AppConfig.TEMP_SYNC_DIR / name
                    if download_asset(asset, target):
                        if self.mode == 'ready':
                            self.safe_log_colored(f"📦 [РАСПАКОВКА] Прямая установка готового профиля...", "info")
                            self.install_ready_profile(target)
                        else:
                            self.safe_log_colored(f"📦 [РАСПАКОВКА] Подготовка базы профилей...", "info")
                            ref_dir = AppConfig.TEMP_SYNC_DIR / "reference_profile_ext"
                            ref_dir.mkdir(exist_ok=True)
                            with py7zr.SevenZipFile(target, mode='r') as z:
                                z.extractall(path=ref_dir)
                        if direct_unpack: target.unlink(missing_ok=True)

                elif name.endswith(".zip") and "dlcsupport" in name.lower():
                    target = mod_dir / name
                    self.safe_log_colored(f"🚚 [ПЕРЕНОС] {name} в папку mod...", "info")
                    download_asset(asset, target)
                    
                # ИНТЕГРАЦИЯ ПОДДЕРЖКИ ПОЛНОЦЕННЫХ ПОДПАПОК ZIP
                elif name.endswith(".zip"):
                    target = AppConfig.TEMP_SYNC_DIR / name
                    if download_asset(asset, target):
                        self.safe_log_colored(f"📁 [СТРУКТУРА ПАПОК] Рекурсивная распаковка {name}...", "info")
                        try:
                            # Библиотека zipfile нативно поддерживает и сохраняет структуру вложенных папок
                            with zipfile.ZipFile(target, 'r') as z:
                                z.extractall(path=mod_dir)
                            if direct_unpack: target.unlink(missing_ok=True)
                        except Exception as e:
                            self.safe_log_colored(f"⚠️ [ОШИБКА РАСПАКОВКИ] Не удалось извлечь подпапки: {e}", "error")

                elif name.endswith(".7z"):
                    target = AppConfig.TEMP_SYNC_DIR / name
                    if download_asset(asset, target):
                        self.safe_log_colored(f"📦 [РАСПАКОВКА] {name} в папку mod...", "info")
                        with py7zr.SevenZipFile(target, mode='r') as z:
                            z.extractall(path=mod_dir)
                        if direct_unpack: target.unlink(missing_ok=True)
                else:
                    target = mod_dir / name
                    download_asset(asset, target)

            self.safe_log_colored("\n[2/4] НАСТРОЙКА: ФАЙЛЫ ПРОФИЛЯ", "info")
            if self.mode == 'new' and self.selected_profile_sii:
                self.apply_mod_order()

            self.safe_log_colored("\n🧹 [ОЧИСТКА] Удаление временных файлов...", "info")
            try:
                if AppConfig.TEMP_SYNC_DIR.exists():
                    shutil.rmtree(AppConfig.TEMP_SYNC_DIR, ignore_errors=True)
                    self.safe_log_colored("✅ [ОЧИСТКА] Папка temp_sync успешно удалена", "success")
            except Exception as clean_e:
                self.safe_log_colored(f"⚠️ [ВНИМАНИЕ] Не удалось удалить temp_sync: {clean_e}", "warn")

            self.safe_log_colored("\n✅ ВСЕ ЗАДАЧИ ВЫПОЛНЕНЫ", "success")
            self.after(0, self._finish_sync_ui)

        except Exception as e:
            log_error("sync_engine", e)
            self.safe_log_colored(f"❌ [КРИТИЧЕСКАЯ ОШИБКА] {str(e)}", "error")
            self.safe_log_colored("Перейдите в раздел техподдержки и сохраните лог.", "muted")
            
            try:
                if AppConfig.TEMP_SYNC_DIR.exists():
                    shutil.rmtree(AppConfig.TEMP_SYNC_DIR, ignore_errors=True)
            except Exception:
                pass
            
            self.after(0, self._error_sync_ui)

    def install_ready_profile(self, archive_path: Path):
        dest_base = get_profiles_dir()
        dest_base.mkdir(parents=True, exist_ok=True)
        try:
            with py7zr.SevenZipFile(archive_path, mode='r') as z:
                z.extractall(path=dest_base)
            self.safe_log_colored(f"✅ [ПРОФИЛЬ] Готовый профиль успешно распакован напрямую в папку profiles", "success")
        except Exception as e:
            log_error("install_ready_profile", e)
            self.safe_log_colored(f"⚠️ [ОШИБКА] Не удалось распаковать профиль: {e}", "error")

    def apply_mod_order_to_path(self, target_sii: Path, standalone=False):
        sii_decrypt_exe = self._ensure_sii_decrypt()
        if not sii_decrypt_exe:
            msg = "❌ [ОШИБКА] Компонент дешифратора был заблокирован или недоступен для скачивания."
            if not standalone: 
                self.safe_log_colored(msg, "error")
            else: 
                messagebox.showerror("Ошибка Антивируса", "Системный компонент SII_Decrypt.exe удален вашим антивирусом или недоступен.\n\nДобавьте папку в исключения Defender и повторите попытку.")
            return False

        backup_path = target_sii.with_suffix('.sii.bak')
        try:
            shutil.copy2(target_sii, backup_path)
            if not standalone: self.safe_log_colored(f"💾 [БЭКАП] Локальная копия профиля сохранена ({backup_path.name})", "info")
        except Exception as e:
            log_error("apply_mod_order - backup", e)
            if not standalone: self.safe_log_colored(f"⚠️ [ОШИБКА] Не удалось сделать бэкап profile.sii: {e}", "error")

        if not standalone: self.safe_log_colored("🔓 [ДЕШИФРОВКА] Чтение файла профиля...", "muted")
        run_hidden_process([str(sii_decrypt_exe), str(target_sii)])
        
        ref_dir = self._ensure_reference_profile()
        if not ref_dir:
            msg = "❌ [ОШИБКА] Эталонный профиль недоступен"
            if not standalone: self.safe_log_colored(msg, "error")
            else: messagebox.showerror("Ошибка", msg)
            return False

        try:
            ref_path = next(ref_dir.rglob("profile.sii"))
        except StopIteration:
            msg = "❌ [ОШИБКА] Эталонный файл порядка модов не найден в скачанном архиве"
            if not standalone: self.safe_log_colored(msg, "error")
            else: messagebox.showwarning("Предупреждение", msg)
            return False
        
        run_hidden_process([str(sii_decrypt_exe), str(ref_path)])
        time.sleep(1.5)
        
        self._cleanup_sii_decrypt()
        
        u_lines = read_sii_safe(target_sii)
        r_lines = read_sii_safe(ref_path)
        
        if not u_lines or not r_lines:
            msg = "❌ [ОШИБКА] Невозможно прочитать файлы профиля"
            if not standalone: self.safe_log_colored(msg, "error")
            else: messagebox.showerror("Ошибка", "Чтение файлов конфигурации не удалось.")
            return False

        r_mods = [l for l in r_lines if "active_mods[" in l or "active_mods:" in l]
        
        final = []
        skip = False
        for line in u_lines:
            if "active_mods[" in line or "active_mods:" in line:
                if not skip:
                    final.extend(r_mods)
                    skip = True
                continue
            if skip and "active_mods" not in line: skip = False
            if not skip: final.append(line)
                
        try:
            with open(target_sii, 'w', encoding='utf-8') as f:
                f.writelines(final)
            if not standalone: 
                self.safe_log_colored("✅ [СИНХРОНИЗАЦИЯ] Порядок модов успешно применен!", "success")
            else:
                messagebox.showinfo("Готово", "Правильный порядок модов применен к профилю.")
            return True
        except IOError as e:
            log_error("apply_mod_order - write", e)
            msg = f"❌ [ОШИБКА ЗАПИСИ]: {e}"
            if not standalone: self.safe_log_colored(msg, "error")
            else: messagebox.showerror("Сбой записи", "Не удалось сохранить файл профиля.")
            return False

    def apply_mod_order(self):
        self.apply_mod_order_to_path(self.selected_profile_sii, standalone=False)


