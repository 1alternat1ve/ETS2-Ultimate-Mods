    def _update_process_status(self):
        try:
            # Оптимизация: проверяем только через Win32 API без subprocess
            if is_game_running():
                self.process_status_label.configure(text="🟢 Игра активна", text_color=UIConfig.COLOR_SUCCESS)
                if not self.force_quit_btn:
                    self.force_quit_btn = ctk.CTkButton(self.dynamic_btn_frame, text="🛑 Убить процесс",
                                                        fg_color=UIConfig.COLOR_DANGER, hover_color=UIConfig.COLOR_DANGER_HOVER,
                                                        height=28, font=("Segoe UI", 11, "bold"),
                                                        command=self.close_game_safely)
                    self.force_quit_btn.pack(fill="x", pady=2)
            else:
                self.process_status_label.configure(text="🔴 Игра закрыта", text_color=UIConfig.COLOR_TEXT_MUTED)
                if self.force_quit_btn:
                    self.force_quit_btn.destroy()
                    self.force_quit_btn = None
        except Exception:
            pass
        finally:
            self.after(4000, self._update_process_status)  # Увеличен интервал до 4 сек для экономии CPU 

    def _check_network_health(self):
        def check():
            try:
                resp = requests.get("https://api.github.com", timeout=5, headers={"User-Agent": "ETS2-Nexus/1.0"})
                if resp.status_code == 200:
                    self.after(0, lambda: self.network_status_label.configure(text="🌐 Сеть: Подключено", text_color=UIConfig.COLOR_SUCCESS))
                else:
                    self.after(0, lambda: self.network_status_label.configure(text=f"🌐 Сеть: Код {resp.status_code}", text_color=UIConfig.COLOR_WARNING))
            except requests.exceptions.Timeout:
                self.after(0, lambda: self.network_status_label.configure(text="🌐 Сеть: Таймаут", text_color=UIConfig.COLOR_DANGER))
            except requests.exceptions.RequestException as e:
                self.after(0, lambda: self.network_status_label.configure(text="🌐 Сеть: Сбой", text_color=UIConfig.COLOR_DANGER))
            except Exception:
                self.after(0, lambda: self.network_status_label.configure(text="🌐 Сеть: Сбой", text_color=UIConfig.COLOR_DANGER))
        try:
            threading.Thread(target=check, daemon=True).start()
        except Exception:
            pass
        self.after(90000, self._check_network_health)  # Увеличен интервал: проверка раз в 1.5 мин

