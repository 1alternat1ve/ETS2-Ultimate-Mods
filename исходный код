    def read_game_config(self) -> dict:
        cfg_path = self.get_game_config_path()
        settings = {}
        if cfg_path.exists():
            with open(cfg_path, "r", encoding="utf-8") as f:
                for line in f:
                    match = re.match(r'^\s*uset\s+([a-zA-Z0-9_]+)\s+"([^"]*)"', line)
                    if match:
                        settings[match.group(1)] = match.group(2)
        return settings

    def save_game_config(self, updates: dict):
        cfg_path = self.get_game_config_path()
        if not cfg_path.exists():
            messagebox.showerror("Системная ошибка", "Файл настроек не найден. Запустите игру один раз, чтобы он создался.")
            return

        try:
            shutil.copy2(cfg_path, cfg_path.with_suffix('.cfg.bak'))
        except Exception as e:
            log_error("backup_game_config", e)

        try:
            with open(cfg_path, "r", encoding="utf-8") as f:
                lines = f.readlines()

            with open(cfg_path, "w", encoding="utf-8") as f:
                for line in lines:
                    match = re.match(r'^\s*uset\s+([a-zA-Z0-9_]+)\s+"([^"]*)"', line)
                    if match and match.group(1) in updates:
                        f.write(f'uset {match.group(1)} "{updates[match.group(1)]}"\n')
                    else:
                        f.write(line)
            messagebox.showinfo("Готово", "Новые параметры успешно применены. Бэкап сохранен как config.cfg.bak.\nОни вступят в силу при следующем запуске игры.")
            self.show_graphics_settings()
        except Exception as e:
            log_error("save_game_config", e)
            messagebox.showerror("Ошибка записи", f"Не удалось обновить файл: {e}")

