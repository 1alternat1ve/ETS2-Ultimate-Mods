# --- ПОДСВЕТКА СИНТАКСИСА SII ---
# ==========================================
class SiiSyntaxHighlighter:
    """
    Лёгкий highlighter SII-формата для CTkTextbox.
    Подсвечивает: строки, числа, комментарии, ключевые слова, литералы.
    Реагирует на KeyRelease с дебаунсом 200 мс — не тормозит на больших файлах.
    """
    KEYWORDS = {
        "SiiNunit", "_nameless", "owner", "vehicle", "trailer",
        "company", "garage", "economy", "user_data", "active_mods",
        "money_account", "experience_points", "fuel_relative", "wear",
    }
    PATTERNS = [
        (r'"([^"\\]|\\.)*"',                       "string"),
        (r'\b(0x[0-9a-fA-F]+|\d+(\.\d+)?)\b',       "number"),
        (r'#.*$',                                    "comment"),
        (r'\b(true|false|null|nil)\b',               "literal"),
    ]

    def __init__(self, ctk_textbox: ctk.CTkTextbox, dark: bool = True):
        # CTkTextbox оборачивает tk.Text — обращаемся к нему напрямую для tag_config
        self.tb = ctk_textbox._textbox if hasattr(ctk_textbox, "_textbox") else ctk_textbox
        palette = {
            "string":  "#A5D6A7" if dark else "#2E7D32",
            "number":  "#FFB74D" if dark else "#E65100",
            "comment": "#90A4AE" if dark else "#546E7A",
            "literal": "#B39DDB" if dark else "#4527A0",
            "keyword": "#64B5F6" if dark else "#0D47A1",
        }
        for tag, col in palette.items():
            try:
                self.tb.tag_configure(tag, foreground=col)
            except Exception:
                pass
        self._after_id = None
        try:
            self.tb.bind("<KeyRelease>", self._schedule, add="+")
        except Exception:
            pass
        # Первичный прогон (на отрисованной области)
        self._highlight_visible()

    def _schedule(self, _evt=None):
        if self._after_id is not None:
            try:
                self.tb.after_cancel(self._after_id)
            except Exception:
                pass
        self._after_id = self.tb.after(200, self._highlight_visible)

    def _highlight_visible(self):
        try:
            # Подсвечиваем только видимую область — экономит CPU на огромных файлах
            first = self.tb.index("@0,0")
            last_y = self.tb.winfo_height()
            last = self.tb.index(f"@0,{last_y}")
            for tag in ("string", "number", "comment", "literal", "keyword"):
                self.tb.tag_remove(tag, first, last)
            text = self.tb.get(first, last)
            for pat, tag in self.PATTERNS:
                for m in re.finditer(pat, text, re.MULTILINE):
                    start = f"{first}+{m.start()}c"
                    end = f"{first}+{m.end()}c"
                    self.tb.tag_add(tag, start, end)
            for kw in self.KEYWORDS:
                for m in re.finditer(rf"\b{re.escape(kw)}\b", text):
                    start = f"{first}+{m.start()}c"
                    end = f"{first}+{m.end()}c"
                    self.tb.tag_add("keyword", start, end)
        except Exception:
            pass


