    def delete_selected_mods(self):
        to_delete = [path for path, var in self.mod_checkboxes if var.get()]
        if not to_delete: return messagebox.showinfo("Ожидание", "Вы не выбрали ни одного файла галочкой.")

        msg = f"Архивировать и удалить выбранные моды ({len(to_delete)} шт.)?\n\nФайлы будут сохранены в папке бэкапов перед удалением."
        if messagebox.askyesno("Подтверждение", msg):
            backup_folder = get_my_documents() / "Euro Truck Simulator 2" / "Backups_Manager"
            backup_folder.mkdir(exist_ok=True)
            timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
            zip_path = backup_folder / f"DeletedMods_{timestamp}.zip"

            errors = 0
            try:
                with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED) as zipf:
                    for path in to_delete:
                        if path.is_file():
                            zipf.write(path, path.name)
                        elif path.is_dir():
                            for root, _, files in os.walk(path):
                                for file in files:
                                    file_path = Path(root) / file
                                    zipf.write(file_path, file_path.relative_to(path.parent))
            except Exception as e:
                log_error("archive_deleted_mods", e)
                messagebox.showwarning("Внимание", "Не удалось создать бэкап модов. Удаление отменено.")
                return

            for path in to_delete:
                try:
                    if path.is_file(): path.unlink()
                    elif path.is_dir(): shutil.rmtree(path)
                except Exception as e:
                    log_error("delete_selected_mods", e)
                    errors += 1
            if errors: messagebox.showwarning("Внимание", f"Не удалось удалить {errors} файлов. Возможно, они заняты игрой.")
            else: messagebox.showinfo("Готово", f"Выбранные моды удалены.\nРезервная копия сохранена в:\n{zip_path}")
            self.show_clean()

    def create_backup(self, silent=False):
        profiles_dir = get_profiles_dir()
        if not profiles_dir.exists() or not any(profiles_dir.iterdir()):
            if not silent: messagebox.showwarning("Отмена", "У вас пока нет локальных профилей, бэкапить нечего.")
            return False

        backup_folder = get_my_documents() / "Euro Truck Simulator 2" / "Backups_Manager"
        backup_folder.mkdir(exist_ok=True)
        timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
        prefix = "AutoBackup" if silent else "ManualBackup"
        zip_path = backup_folder / f"{prefix}_{timestamp}.zip"

        if not silent: self.set_status("Создание резервной копии...")
        try:
            with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED) as zipf:
                for root, _, files in os.walk(profiles_dir):
                    for file in files:
                        file_path = Path(root) / file
                        arcname = file_path.relative_to(profiles_dir.parent)
                        zipf.write(file_path, arcname)
                        
            all_backups = sorted(backup_folder.glob("*.zip"), key=os.path.getmtime)
            if len(all_backups) > AppConfig.MAX_BACKUPS:
                for old_backup in all_backups[:-AppConfig.MAX_BACKUPS]:
                    try: old_backup.unlink()
                    except Exception as e: log_error("rotate_backup", e)

            if not silent: messagebox.showinfo("Готово", f"Резервная копия создана и сохранена:\n{zip_path}")
            return True
        except Exception as e:
            log_error("create_backup", e)
            if not silent: messagebox.showerror("Ошибка", f"Не удалось создать бэкап: {e}")
            return False
        finally:
            if not silent: self.set_status("Ожидание действий")

