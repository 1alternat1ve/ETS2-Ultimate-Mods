                      ).pack(side="right")

        self._news_label = ctk.CTkLabel(news_card, text="⏳ Загрузка информации о релизе...",
                                        font=("Segoe UI", 13), text_color=UIConfig.COLOR_TEXT_MUTED,
                                        justify="left", wraplength=900)
        self._news_label.pack(anchor="w", padx=15, pady=(5, 10))

        def _fetch_news():
            try:
                session = requests.Session()
                session.headers.update({"User-Agent": "ETS2-Nexus/1.0"})
                resp = session.get(f"https://api.github.com/repos/{AppConfig.PROGRAM_REPO}/releases/latest", timeout=8)
                resp.raise_for_status()
                data = resp.json()
                tag = data.get("tag_name", "?")
                date_raw = data.get("published_at", "")
                date_str = ""
                if date_raw:
                    try:
                        dt = datetime.strptime(date_raw, "%Y-%m-%dT%H:%M:%SZ")
                        date_str = f"  •  {dt.strftime('%d.%m.%Y')}"
                    except Exception:
                        pass
                body = data.get("body", "Нет описания.") or "Нет описания."
                body_short = body[:200].strip().replace("\r\n", " ").replace("\n", " ")
                if len(body) > 200:
                    body_short += "..."
                text = f"🟢 [{tag}{date_str}]: {body_short}"
                self.after(0, lambda: self._news_label.configure(text=text, text_color=UIConfig.COLOR_TEXT_MAIN))
            except requests.exceptions.Timeout:
                self.after(0, lambda: self._news_label.configure(
                    text="🔴 Нет ответа от GitHub (таймаут). Проверьте интернет.",
                    text_color=UIConfig.COLOR_TEXT_MUTED))
            except requests.exceptions.RequestException:
                self.after(0, lambda: self._news_label.configure(
                    text="🔴 Нет подключения к GitHub. Проверьте интернет или попробуйте позже.",
                    text_color=UIConfig.COLOR_TEXT_MUTED))
