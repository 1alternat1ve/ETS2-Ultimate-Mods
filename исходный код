    def quarantine_mods(self):
        mod_dir = get_my_documents() / "Euro Truck Simulator 2" / "mod"
        quarantine_dir = get_my_documents() / "Euro Truck Simulator 2" / "mod_quarantine"
        
        if quarantine_dir.exists() and not mod_dir.exists():
            messagebox.showinfo("Инфо", "Моды уже находятся в карантине.\nЧтобы вернуть их, переименуйте 'mod_quarantine' обратно в 'mod' вручную.")
            return

        if not mod_dir.exists():
            messagebox.showinfo("Инфо", "Папка 'mod' не найдена. У вас нет установленных модов.")
            return

        if messagebox.askyesno("Карантин", "Вы уверены? Папка 'mod' будет переименована в 'mod_quarantine'. Игра запустится абсолютно чистой, без модов."):
            try:
                if quarantine_dir.exists():
                    shutil.rmtree(quarantine_dir)
                # shutil.move работает между разными дисками/файловыми системами,
                # в отличие от os.rename, который падает с OSError
                shutil.move(str(mod_dir), str(quarantine_dir))
                messagebox.showinfo("Успех", "Моды помещены в карантин.\nПопробуйте запустить игру. Если она работает, значит проблема была в одном из файлов мода.")
                self.show_tools()
            except Exception as e:
                log_error("quarantine_mods", e)
                messagebox.showerror("Ошибка", f"Не удалось изолировать моды: {e}")

    def fix_trailer_stutter(self):
        def _task():
            self.after(0, lambda: self.set_status("Скачивание фикса CargoMarketStutterFix..."))
            try:
                mod_dir = get_my_documents() / "Euro Truck Simulator 2" / "mod"
                mod_dir.mkdir(parents=True, exist_ok=True)
                fix_path = mod_dir / "CargoMarketStutterFix.scs"

                # Используем сессию с токеном
                session = self._get_gh_session()
                api_url = AppConfig.GITHUB_API_URL.replace("/latest", "")
                resp = session.get(api_url, timeout=5)
                resp.raise_for_status()
                releases = resp.json()
                if isinstance(releases, dict):
                    releases = [releases]

                dl_url = None
                asset_data = None
                for release in releases:
                    for asset in release.get('assets', []):
                        if asset['name'] == "CargoMarketStutterFix.scs":
                            dl_url = asset['browser_download_url']
                            asset_data = asset
                            break
                    if dl_url: break

                if dl_url:
                    # Умная проверка: не качаем если уже актуально
                    manifest = self._load_manifest()
                    if fix_path.exists() and asset_data and self._is_asset_current(asset_data, manifest, fix_path):
                        self.after(0, lambda: messagebox.showinfo("Актуально", "CargoMarketStutterFix.scs уже установлен и актуален."))
                        return
                    with session.get(dl_url, stream=True, timeout=10) as r:
                        r.raise_for_status()
                        with open(fix_path, 'wb') as f:
                            for chunk in r.iter_content(chunk_size=8192):
                                if chunk: f.write(chunk)
                    if asset_data:
                        self._mark_asset_installed(manifest, asset_data)
                        self._save_manifest(manifest)
                else:
                    raise Exception("CargoMarketStutterFix.scs не найден в релизах на GitHub.")

                # Прописываем сброс экономики в конфиг
                updates = {"g_force_economy_reset": "1"}
                self.save_game_config(updates)
                
                self.after(0, lambda: messagebox.showinfo("Успех", "Мод CargoMarketStutterFix.scs установлен, и экономика сброшена (g_force_economy_reset 1). Можете запускать игру!"))
            except Exception as e:
                log_error("fix_trailer_stutter", e)
                self.after(0, lambda: messagebox.showerror("Ошибка", f"Не удалось скачать фикс: {e}"))
            finally:
                self.after(0, lambda: self.set_status("Ожидание действий"))

        threading.Thread(target=_task, daemon=True).start()

    def reset_global_config(self):
        cfg_path = self.get_game_config_path()
        if not cfg_path.exists():
            messagebox.showinfo("Чисто", "Файл config.cfg не найден. Возможно, игра еще ни разу не запускалась.")
            return
            
        if messagebox.askyesno("Сброс", "Вы уверены? Это сбросит все настройки графики, геймплея и управления в игре к заводским."):
            try:
                backup_path = cfg_path.with_suffix('.cfg.panic_backup')
                shutil.copy2(cfg_path, backup_path)
                cfg_path.unlink()
                messagebox.showinfo("Готово", "Конфиг сброшен.\n\nСтарый файл сохранен как config.cfg.panic_backup. При следующем запуске игра создаст чистый профиль настроек.")
