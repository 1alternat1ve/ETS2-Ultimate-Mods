    # ═══════════════════════════════════════════════════════════════════
    # MISSION CONTROL — премиум-экран установки модов
    #
    # Двухколоночная сетка:
    #   ┌────────────────────────────────────────────────────────────────┐
    #   │ HEADER: заголовок · ⏸ ⏹                                        │
    #   ├──────────────────────────────────┬─────────────────────────────┤
    #   │ LEFT (главный поток):            │ RIGHT (метрики + контекст): │
    #   │  ▸ Большой % + общий прогресс    │  ⏱  ETA: 2 мин 14 сек      │
    #   │  ▸ Текущий файл + его прогресс   │  ⬇  4.2 MB/s                │
    #   │  ▸ Степпер 6 этапов (компактно)  │  📦  47/64 файлов           │
    #   │                                  │  ✓ 41 ─ ↷ 3 ─ ✗ 0           │
    #   │                                  │  💡 Совет дня…              │
    #   ├──────────────────────────────────┴─────────────────────────────┤
    #   │ CAROUSEL (горизонтальная лента файлов внизу)                   │
    #   │ ◀ ◯ promods   ⚡ definition   ✓ rusmap   ✓ skybox   ▶          │
    #   └────────────────────────────────────────────────────────────────┘
    #
    # Mission Control сделан по принципу «всё нужное на одном экране»:
    # − главный поток слева (что происходит)
    # − метрики и контекст справа (как идёт)
    # − история внизу как лента (кто сделан)
    # ═══════════════════════════════════════════════════════════════════
    def start_sync_ui(self):
        if is_game_running():
            messagebox.showerror("Игра запущена",
                                  "Для синхронизации файлов игра должна быть закрыта.")
            return
        if self.is_syncing:
            messagebox.showwarning("Уже в процессе",
                                    "Установка уже выполняется в фоновом режиме.")
            return

        path_str = getattr(self, 'radio_var', ctk.StringVar()).get()
        if self.mode != 'ready' and not path_str:
            return messagebox.showwarning("Ожидание",
                                            "Сначала выберите профиль из списка.")

        self.selected_profile_sii = Path(path_str) if path_str else None

        # Уничтожаем предыдущий sync-контейнер если был
        if getattr(self, "_sync_screen_container", None):
            try:
                self._sync_screen_container.destroy()
            except Exception:
                pass
            self._sync_screen_container = None

        # Прячем (НЕ уничтожаем) обычные PageHost-слоты
        try:
            if hasattr(self, "page_host"):
                self.page_host.front.grid_remove()
                self.page_host.back.grid_remove()
        except Exception:
            pass
        self.set_status("Установка модов")

        # Корневой контейнер sync-экрана
        self._sync_screen_container = ctk.CTkFrame(self, fg_color="transparent")
        self._sync_screen_container.grid(row=0, column=1, sticky="nsew", padx=30, pady=20)
        self._active_page_kind = "sync"
        sync_root = self._sync_screen_container

        # Хранилище ленты файлов
        self._file_rows: Dict[str, dict] = {}
        self._first_active_shown = False

        # ╔══════════════════════════════════════════════════════════════╗
        # ║ HEADER: заголовок + контролы справа                          ║
        # ╚══════════════════════════════════════════════════════════════╝
        header = ctk.CTkFrame(sync_root, fg_color="transparent")
        header.pack(fill="x", padx=4, pady=(0, 16))

        h_left = ctk.CTkFrame(header, fg_color="transparent")
        h_left.pack(side="left", fill="x", expand=True)

        # «Live» индикатор
        live_pill = ctk.CTkFrame(h_left, fg_color="transparent")
        live_pill.pack(anchor="w", pady=(0, 6))
        ctk.CTkLabel(live_pill, text="●",
                     font=("Segoe UI", 12),
                     text_color=UIConfig.COLOR_DANGER).pack(side="left", padx=(0, 6))
        ctk.CTkLabel(live_pill, text="MISSION CONTROL  ·  УСТАНОВКА",
                     font=UIConfig.FONT_TINY,
                     text_color=UIConfig.COLOR_TEXT_GHOST).pack(side="left")

        self.sync_step_lbl = ctk.CTkLabel(
            h_left, text="Подключение к серверу…",
            font=("Segoe UI Black", 26),
            text_color=UIConfig.COLOR_TEXT_MAIN, anchor="w")
        self.sync_step_lbl.pack(anchor="w")

        # Контролы справа в шапке
        h_right = ctk.CTkFrame(header, fg_color="transparent")
        h_right.pack(side="right")

        # Pause
        self._sync_pause_btn = ctk.CTkButton(
            h_right, text="⏸  Пауза", width=110, height=40,
            fg_color="transparent",
            border_width=1, border_color=UIConfig.COLOR_BORDER,
            hover_color=UIConfig.COLOR_BTN_GRAY,
            text_color=UIConfig.COLOR_TEXT_MAIN,
            corner_radius=UIConfig.CORNER_RADIUS_BTN,
            font=("Segoe UI Semibold", 13),
            command=self._ui_toggle_pause)
        self._sync_pause_btn.pack(side="left", padx=(0, 6))

        # Skip current file
        self._sync_skip_btn = ctk.CTkButton(
            h_right, text="⏭  Пропустить", width=130, height=40,
            fg_color="transparent",
            border_width=1, border_color=UIConfig.COLOR_BORDER,
            hover_color=UIConfig.COLOR_BTN_GRAY,
            text_color=UIConfig.COLOR_TEXT_MAIN,
            corner_radius=UIConfig.CORNER_RADIUS_BTN,
            font=("Segoe UI Semibold", 13),
            command=self._ui_skip_current_file)
        self._sync_skip_btn.pack(side="left", padx=(0, 6))

        # Cancel
        self._sync_cancel_btn = ctk.CTkButton(
            h_right, text="⏹  Отмена", width=110, height=40,
            fg_color="transparent",
            border_width=1, border_color=UIConfig.COLOR_DANGER,
            hover_color=UIConfig.COLOR_BTN_GRAY,
            text_color=UIConfig.COLOR_DANGER,
            corner_radius=UIConfig.CORNER_RADIUS_BTN,
            font=("Segoe UI Semibold", 13),
            command=self._ui_cancel_sync)
        self._sync_cancel_btn.pack(side="left")

        # ╔══════════════════════════════════════════════════════════════╗
        # ║ MAIN BODY: 2 колонки (LEFT поток + RIGHT метрики)            ║
        # ╚══════════════════════════════════════════════════════════════╝
        # ВАЖНО: body создаём СЕЙЧАС, но pack откладываем до конца —
        # сначала разместим карусель и финальную кнопку через side="bottom",
        # тогда они займут гарантированное место внизу, а body — остаток сверху.
        body = ctk.CTkFrame(sync_root, fg_color="transparent")
        body.grid_columnconfigure(0, weight=3)
        body.grid_columnconfigure(1, weight=2)
        body.grid_rowconfigure(0, weight=1)

        # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        # LEFT — главная карточка: % + общий прогресс + текущий файл + степпер
