        )
        messagebox.showinfo("Удаленный доступ", msg)
        self.set_status("Поиск клиента удаленного доступа...")
        
        def process():
            paths = [
                Path(os.environ.get("ProgramFiles(x86)", "C:/Program Files (x86)")) / "AnyDesk" / "AnyDesk.exe",
                Path(os.environ.get("ProgramFiles", "C:/Program Files")) / "AnyDesk" / "AnyDesk.exe",
                Path(os.environ.get("LOCALAPPDATA", "C:/")) / "AnyDesk" / "AnyDesk.exe",
                Path(os.environ.get("ProgramFiles", "C:/Program Files")) / "RustDesk" / "rustdesk.exe"
            ]
            
            target_exe = None
            for p in paths:
                if p.exists():
                    target_exe = p
                    break
                    
            if not target_exe:
                self.after(0, lambda: self.set_status("Загрузка портативного клиента..."))
                temp_dir = Path(tempfile.gettempdir())
                target_exe = temp_dir / "AnyDeskPortable.exe"
                try:
                    if not target_exe.exists():
                        urllib.request.urlretrieve("https://download.anydesk.com/AnyDesk.exe", target_exe)
                except Exception as e:
                    log_error("download_anydesk", e)
                    self.after(0, lambda: messagebox.showerror("Сбой сети", "Не удалось скачать программу, перенаправляю на сайт."))
                    webbrowser.open("https://anydesk.com/ru/downloads")
                    self.after(0, lambda: self.set_status("Ожидание действий"))
                    return

            try:
                subprocess.Popen([str(target_exe)])
                self.after(0, lambda: self.set_status("Клиент успешно запущен"))
            except Exception as e:
                log_error("launch_remote_help", e)
                self.after(0, lambda: messagebox.showerror("Ошибка", f"Не удалось запустить программу: {e}"))
                
        threading.Thread(target=process, daemon=True).start()

