    }

    _backup: Optional[Dict[str, Any]] = None

    @classmethod
    def list_themes(cls) -> List[Dict[str, str]]:
        """Возвращает [{key, name, description}, ...] для UI."""
        return [{"key": k, "name": v["name"], "description": v["description"]}
                for k, v in cls.THEMES.items()]

    @classmethod
    def _backup_defaults(cls):
        """Один раз сохраняет дефолтные цвета UIConfig."""
        if cls._backup is not None:
            return
        cls._backup = {}
        for field in cls._color_fields():
            try:
                cls._backup[field] = getattr(UIConfig, field)
            except AttributeError:
                pass

    @classmethod
    def _color_fields(cls) -> List[str]:
        """Список цветовых полей UIConfig, которые мы можем переопределить."""
        return [
            "COLOR_BG", "COLOR_SIDEBAR_BG", "COLOR_STATUS_BG",
            "COLOR_CARD_BG", "COLOR_CARD_BG_ALT", "COLOR_PRO_BG",
            "COLOR_LOG_BG",
            "COLOR_ACCENT", "COLOR_ACCENT_HOVER", "COLOR_ACCENT_2",
            "COLOR_PURPLE", "COLOR_PURPLE_HOVER",
            "COLOR_INFO_BG", "COLOR_INFO_TEXT",
            "COLOR_BORDER",
        ]

    @classmethod
    def apply(cls, theme_key: str) -> bool:
        """
        Применяет тему к UIConfig в runtime.
        Возвращает True если тема существует.
        """
        if theme_key not in cls.THEMES:
            return False
        cls._backup_defaults()
        # Восстанавливаем дефолты
        for field, val in cls._backup.items():
            try:
                setattr(UIConfig, field, val)
            except Exception:
                pass
        # Применяем оверрайды
        overrides = cls.THEMES[theme_key]["overrides"]
        for field, val in overrides.items():
            try:
                setattr(UIConfig, field, val)
            except Exception:
                pass
        return True

    @classmethod
    def current(cls, settings: dict) -> str:
        """Возвращает текущий ключ темы из settings, или 'premium-dark'."""
        return settings.get("nexus_theme", "premium-dark")


# ==========================================
# --- SNAKE GAME: мини-игра для скрашивания ожидания ---
# ==========================================
class SnakeGame:
    """
    Классическая змейка на Tk Canvas.
    Управление: стрелки или WASD.
    Запускается на экране установки модов чтобы пользователь
    не скучал во время длительной загрузки.

    Состояние:
      • snake — список ячеек [(x, y), ...]
      • direction — (dx, dy)
      • food — (x, y)
      • score — счёт
      • game_over — True/False
      • paused — True/False (например при потере фокуса)

    Особенность: змейка автоматически рестартует при game over.
    """

    GRID_W = 18   # клеток по горизонтали (для большого окна)
    GRID_H = 16   # клеток по вертикали
    TICK_MS = 130
    SPEED_UP_EVERY = 5
    MIN_CANVAS_W = 360
    MIN_CANVAS_H = 320

    def __init__(self, parent: ctk.CTkBaseClass, root: ctk.CTk,
                 on_score_change: Optional[Callable[[int, int], None]] = None):
        self.root = root
        self._on_score_change = on_score_change
        self._running = True

        # Цвета по теме
        try:
            mode_idx = 0 if ctk.get_appearance_mode() == "Light" else 1
            self._bg = UIConfig.COLOR_LOG_BG[mode_idx]
            self._grid_color = UIConfig.COLOR_BORDER[mode_idx]
            self._snake_head = UIConfig.COLOR_SUCCESS[mode_idx]
            self._snake_body = UIConfig.COLOR_ACCENT[mode_idx]
            self._food_color = UIConfig.COLOR_WARNING[mode_idx]
            self._text_color = UIConfig.COLOR_TEXT_MAIN[mode_idx]
        except Exception:
            self._bg = "#080B10"
            self._grid_color = "#222936"
            self._snake_head = "#34D399"
            self._snake_body = "#5B8DEF"
            self._food_color = "#FBBF24"
            self._text_color = "#E8ECF1"

        # Контейнер. Высота определяется содержимым (без propagate=False).
        # Canvas внутри имеет minsize 240×200, шапка/подсказка ~70px.
        # На большом экране растягивается через pack expand.
        self._frame = ctk.CTkFrame(
            parent,
            fg_color=UIConfig.COLOR_CARD_BG,
            corner_radius=UIConfig.CORNER_RADIUS_CARD,
            border_width=1,
            border_color=UIConfig.COLOR_BORDER)

        # Хедер
        head = ctk.CTkFrame(self._frame, fg_color="transparent")
        head.pack(fill="x", padx=14, pady=(12, 6))
        ctk.CTkLabel(head, text="🐍  ЗМЕЙКА",
                     font=UIConfig.FONT_TINY,
                     text_color=UIConfig.COLOR_ACCENT,
                     anchor="w").pack(side="left")
        self._score_lbl = ctk.CTkLabel(head, text="0",
                                         font=("Segoe UI Semibold", 14),
                                         text_color=UIConfig.COLOR_TEXT_MAIN)
        self._score_lbl.pack(side="right")

        # Canvas для игры — фиксированная МИНИМАЛЬНАЯ высота,
        # чтобы поле всегда было играбельным даже когда колонка узкая
        self._canvas = tk.Canvas(self._frame,
                                  bg=self._bg, highlightthickness=0, bd=0,
                                  width=self.MIN_CANVAS_W,
                                  height=self.MIN_CANVAS_H)
        self._canvas.pack(fill="both", expand=True, padx=10, pady=(0, 6))

        # Подсказка
        self._hint_lbl = ctk.CTkLabel(
            self._frame, text="Управление: ←↑→↓ или WASD · клик чтобы фокус",
            font=("Segoe UI", 10),
            text_color=UIConfig.COLOR_TEXT_GHOST)
        self._hint_lbl.pack(pady=(0, 10))

        # Биндинги клавиш
        self._canvas.bind("<Up>",      lambda e: self._set_dir(0, -1))
        self._canvas.bind("<Down>",    lambda e: self._set_dir(0, 1))
        self._canvas.bind("<Left>",    lambda e: self._set_dir(-1, 0))
        self._canvas.bind("<Right>",   lambda e: self._set_dir(1, 0))
        self._canvas.bind("w",         lambda e: self._set_dir(0, -1))
        self._canvas.bind("s",         lambda e: self._set_dir(0, 1))
        self._canvas.bind("a",         lambda e: self._set_dir(-1, 0))
        self._canvas.bind("d",         lambda e: self._set_dir(1, 0))
        self._canvas.bind("<space>",   lambda e: self.restart())
        self._canvas.bind("<Button-1>", lambda e: self._canvas.focus_set())

        # Состояние
        self._reset_state()

        # Запускаем тик
        self._tick_id = None
        self._schedule_tick()

    @property
    def widget(self) -> ctk.CTkFrame:
        """Возвращает фрейм для добавления в layout."""
        return self._frame

    def _reset_state(self):
        import random as _r
        cx, cy = self.GRID_W // 2, self.GRID_H // 2
        self._snake = [(cx, cy), (cx - 1, cy), (cx - 2, cy)]
        self._direction = (1, 0)
        self._next_direction = (1, 0)
        self._food = self._spawn_food()
        self._score = 0
        self._game_over = False
        self._tick_ms = self.TICK_MS

    def _spawn_food(self) -> Tuple[int, int]:
        import random as _r
        snake_set = set(self._snake)
        while True:
            x = _r.randint(0, self.GRID_W - 1)
            y = _r.randint(0, self.GRID_H - 1)
            if (x, y) not in snake_set:
                return (x, y)

    def _set_dir(self, dx: int, dy: int):
        # Запрет разворота на 180°
        cur_dx, cur_dy = self._direction
        if (dx, dy) == (-cur_dx, -cur_dy):
            return
        self._next_direction = (dx, dy)

    def _schedule_tick(self):
        if not self._running:
            return
        try:
            if not self._canvas.winfo_exists():
                self._running = False
                return
        except Exception:
            self._running = False
            return
        self._tick_id = self.root.after(self._tick_ms, self._tick)

    def _tick(self):
        if not self._running:
            return
        try:
            if not self._canvas.winfo_exists():
                self._running = False
                return
        except Exception:
            return

        if not self._game_over:
            self._step()
        self._render()
        self._schedule_tick()

    def _step(self):
        # Применяем next_direction
        self._direction = self._next_direction
        head_x, head_y = self._snake[0]
        dx, dy = self._direction
        new_head = (head_x + dx, head_y + dy)

        # Столкновение со стеной
        if (new_head[0] < 0 or new_head[0] >= self.GRID_W or
                new_head[1] < 0 or new_head[1] >= self.GRID_H):
            self._game_over = True
            return

        # Столкновение с собой
        if new_head in self._snake:
            self._game_over = True
            return

        self._snake.insert(0, new_head)

        # Съели еду?
        if new_head == self._food:
            self._score += 1
            try:
                self._score_lbl.configure(text=str(self._score))
                if self._on_score_change:
                    self._on_score_change(self._score, self._score)
            except Exception:
                pass
            # Ускоряемся
            if self._score % self.SPEED_UP_EVERY == 0 and self._tick_ms > 60:
                self._tick_ms = max(60, self._tick_ms - 10)
            self._food = self._spawn_food()
        else:
            self._snake.pop()

    def _render(self):
        try:
            c = self._canvas
            c.delete("all")
            w = c.winfo_width()
            h = c.winfo_height()
            if w < 20 or h < 20:
                return

            # Квадратные ячейки — берём минимальный размер ячейки
            # и центрируем поле в canvas. Так клетки не растягиваются
            # независимо от формы canvas.
            cell = min(w / self.GRID_W, h / self.GRID_H)
            field_w = cell * self.GRID_W
            field_h = cell * self.GRID_H
            ox = (w - field_w) / 2   # отступ слева
            oy = (h - field_h) / 2   # отступ сверху

            # Внешняя рамка поля
            c.create_rectangle(ox, oy, ox + field_w, oy + field_h,
                                outline=self._grid_color, width=1)

            # Тонкая сетка
            for i in range(1, self.GRID_W):
                x = ox + i * cell
                c.create_line(x, oy, x, oy + field_h,
                                fill=self._grid_color, dash=(2, 4))
            for i in range(1, self.GRID_H):
                y = oy + i * cell
                c.create_line(ox, y, ox + field_w, y,
                                fill=self._grid_color, dash=(2, 4))

            # Еда
            fx, fy = self._food
            c.create_oval(
                ox + fx * cell + 3, oy + fy * cell + 3,
                ox + (fx + 1) * cell - 3, oy + (fy + 1) * cell - 3,
                fill=self._food_color, outline="")

            # Змейка
            for i, (sx, sy) in enumerate(self._snake):
                color = self._snake_head if i == 0 else self._snake_body
                pad = 2 if i == 0 else 3
                c.create_rectangle(
                    ox + sx * cell + pad, oy + sy * cell + pad,
                    ox + (sx + 1) * cell - pad, oy + (sy + 1) * cell - pad,
                    fill=color, outline="")

            # Game Over оверлей
            if self._game_over:
                c.create_rectangle(0, 0, w, h, fill=self._bg, stipple="gray50")
                c.create_text(w / 2, h / 2 - 16,
                               text="GAME OVER",
                               font=("Segoe UI Black", 18),
                               fill=self._text_color)
                c.create_text(w / 2, h / 2 + 8,
                               text=f"Счёт: {self._score}",
                               font=("Segoe UI", 12),
                               fill=self._text_color)
                c.create_text(w / 2, h / 2 + 32,
                               text="Нажмите ПРОБЕЛ для рестарта",
                               font=("Segoe UI", 10),
                               fill=self._grid_color)
        except Exception as e:
            logging.error(f"SnakeGame._render: {e}")

    def restart(self):
        """Внешний рестарт игры."""
        self._reset_state()
        try:
            self._score_lbl.configure(text="0")
        except Exception:
            pass

    def stop(self):
        self._running = False
        if self._tick_id is not None:
            try:
                self.root.after_cancel(self._tick_id)
            except Exception:
                pass


# ==========================================
# --- ANIMATED BACKGROUND: плавающие градиентные пятна ---
# ==========================================
class AnimatedBackground:
    """
    Многослойный анимированный фон в стиле «aurora glow»:
      • Слой 1 (back): 3 больших мягких пятна — глубина и атмосфера
      • Слой 2 (mid):  5 средних пятен — основной цвет
      • Слой 3 (front): 12 «искр» — мелкие частицы для динамики

    Эффекты:
      • Параллакс при движении мыши (разная глубина → разная скорость)
      • Реакция на близость курсора: пятно у мыши ярче
      • Плавный «дыхательный» пульс размера каждого пятна

    Производительность: ~28 FPS, ~20 объектов на canvas.
    """
    FPS = 28
    PARALLAX_AMOUNT = 42  # для front-слоя; back двигается медленнее

    def __init__(self, parent: ctk.CTkBaseClass, root: ctk.CTk,
                  colors: Optional[List[str]] = None):
        self.root = root
        self.parent = parent
        self._enabled = True
        self._mouse_x_norm = 0.5
        self._mouse_y_norm = 0.5
        self._colors = colors or self._default_colors()
        self._frame_count = 0  # для пульсации

        # Canvas создаём с фоном цвета базы
        self._tk_canvas = tk.Canvas(
            parent, highlightthickness=0,
            bg=self._bg_color(),
            bd=0)
        # Понижаем canvas под виджеты (через Misc для совместимости с Py3.14+)
        try:
            tk.Misc.lower(self._tk_canvas)
        except Exception:
            pass

        # Многослойная инициализация
        self._blobs_back = self._init_blobs_back()
        self._blobs_mid = self._init_blobs_mid()
        self._sparkles = self._init_sparkles()
        # Биндим resize
        self._tk_canvas.bind("<Configure>", self._on_resize)

        self._animation_id = None
        self._tick()

    def _default_colors(self) -> List[str]:
        """Цвета пятен из текущей палитры."""
        try:
            mode_idx = 0 if ctk.get_appearance_mode() == "Light" else 1
            return [
                UIConfig.COLOR_ACCENT[mode_idx],
                UIConfig.COLOR_ACCENT_2[mode_idx],
                UIConfig.COLOR_PURPLE[mode_idx],
                UIConfig.COLOR_INFO_TEXT[mode_idx],
                UIConfig.COLOR_SUCCESS[mode_idx],
            ]
        except Exception:
            return ["#5B8DEF", "#9C7CFF", "#A78BFA", "#7CA3FF", "#34D399"]

    def _bg_color(self) -> str:
        try:
            mode_idx = 0 if ctk.get_appearance_mode() == "Light" else 1
            return UIConfig.COLOR_BG[mode_idx]
        except Exception:
            return "#0A0E14"

    def _init_blobs_back(self) -> list:
        """3 больших медленных пятна для фона."""
        import random as _r
        blobs = []
        for i in range(3):
            blobs.append({
                "x": _r.uniform(0.1, 0.9),
                "y": _r.uniform(0.1, 0.9),
                "r_base": _r.uniform(380, 520),
                "r_amp": _r.uniform(20, 40),    # амплитуда пульса
                "phase": _r.uniform(0, 6.28),    # фаза для пульса
                "dx": _r.uniform(-0.0004, 0.0004),
                "dy": _r.uniform(-0.0004, 0.0004),
                "color": self._colors[i % len(self._colors)],
                "stipple": "gray12",
                "depth": 0.3,                    # параллакс-фактор
                "id": None,
            })
        return blobs

    def _init_blobs_mid(self) -> list:
        """5 средних быстрее движущихся пятен."""
        import random as _r
        blobs = []
        for i in range(5):
            blobs.append({
                "x": _r.uniform(0.05, 0.95),
                "y": _r.uniform(0.05, 0.95),
                "r_base": _r.uniform(180, 280),
                "r_amp": _r.uniform(15, 30),
                "phase": _r.uniform(0, 6.28),
                "dx": _r.uniform(-0.0009, 0.0009),
                "dy": _r.uniform(-0.0009, 0.0009),
                "color": self._colors[(i + 1) % len(self._colors)],
                "stipple": "gray25",
                "depth": 0.7,
                "id": None,
            })
        return blobs

    def _init_sparkles(self) -> list:
        """12 мелких искр-частиц на переднем плане."""
        import random as _r
        sparks = []
        for _ in range(12):
            sparks.append({
                "x": _r.uniform(0.0, 1.0),
                "y": _r.uniform(0.0, 1.0),
                "r": _r.uniform(2, 5),
                "dx": _r.uniform(-0.0015, 0.0015),
                "dy": _r.uniform(-0.0015, 0.0015),
                "color": _r.choice(self._colors),
                "depth": 1.0,                    # max параллакс
                "id": None,
                "alpha_phase": _r.uniform(0, 6.28),  # мерцание
            })
        return sparks

    def _on_resize(self, _event):
        # Координаты в долях — перерисовка автоматически
        pass

    def _tick(self):
        if not self._enabled:
            return
        # Защита: если canvas уничтожен — выходим И НЕ планируем next tick
        try:
            if not self._tk_canvas.winfo_exists():
                self._enabled = False
                return
        except Exception:
            self._enabled = False
            return
        try:
            self._update_positions()
            self._render()
        except Exception as e:
            logging.error(f"AnimatedBackground._tick: {e}")
        # Следующий кадр (только если canvas жив)
        try:
            self._animation_id = self.root.after(
                int(1000 / self.FPS), self._tick)
        except Exception:
            self._enabled = False

    def _update_positions(self):
        """Обновляет позицию всех слоёв: back, mid, sparkles."""
        all_objs = self._blobs_back + self._blobs_mid + self._sparkles
        for o in all_objs:
            o["x"] += o["dx"]
            o["y"] += o["dy"]
            # Bounce от краёв (с разным «коридором» для разных слоёв)
            margin = 0.05 if "r_base" in o else 0.0
            if o["x"] < margin or o["x"] > 1 - margin:
                o["dx"] = -o["dx"]
            if o["y"] < margin or o["y"] > 1 - margin:
                o["dy"] = -o["dy"]
        self._frame_count += 1

    def _render(self):
        try:
            w = self._tk_canvas.winfo_width()
            h = self._tk_canvas.winfo_height()
            if w < 10 or h < 10:
                return

            import math
            # Параллакс: пятна смещаются в обратную сторону от мыши.
            # Глубина каждого слоя умножает смещение (back медленнее, front быстрее).
            base_offset_x = (0.5 - self._mouse_x_norm) * self.PARALLAX_AMOUNT
            base_offset_y = (0.5 - self._mouse_y_norm) * self.PARALLAX_AMOUNT

            t = self._frame_count / self.FPS  # время в секундах для пульса

            # Слой 1: back (большие пятна)
            for b in self._blobs_back:
                ox = base_offset_x * b["depth"]
                oy = base_offset_y * b["depth"]
                # Дыхательный пульс размера
                r = b["r_base"] + math.sin(t * 0.6 + b["phase"]) * b["r_amp"]
                cx = b["x"] * w + ox
                cy = b["y"] * h + oy
                x0, y0 = cx - r, cy - r
                x1, y1 = cx + r, cy + r
                if b["id"] is None:
                    b["id"] = self._tk_canvas.create_oval(
                        x0, y0, x1, y1, fill=b["color"], outline="",
                        stipple=b["stipple"])
                else:
                    self._tk_canvas.coords(b["id"], x0, y0, x1, y1)

            # Слой 2: mid (средние пятна)
            for b in self._blobs_mid:
                ox = base_offset_x * b["depth"]
                oy = base_offset_y * b["depth"]
                r = b["r_base"] + math.sin(t * 0.9 + b["phase"]) * b["r_amp"]
                cx = b["x"] * w + ox
                cy = b["y"] * h + oy
                x0, y0 = cx - r, cy - r
                x1, y1 = cx + r, cy + r
                if b["id"] is None:
                    b["id"] = self._tk_canvas.create_oval(
                        x0, y0, x1, y1, fill=b["color"], outline="",
                        stipple=b["stipple"])
                else:
                    self._tk_canvas.coords(b["id"], x0, y0, x1, y1)

            # Слой 3: sparkles (мелкие искры). Мигают через alpha-фазу.
            for s in self._sparkles:
                ox = base_offset_x * s["depth"]
                oy = base_offset_y * s["depth"]
                cx = s["x"] * w + ox
                cy = s["y"] * h + oy
                # Пульсация яркости через изменение размера
                pulse = 0.7 + 0.3 * math.sin(t * 2.0 + s["alpha_phase"])
                r = s["r"] * pulse
                x0, y0 = cx - r, cy - r
                x1, y1 = cx + r, cy + r
                if s["id"] is None:
                    s["id"] = self._tk_canvas.create_oval(
                        x0, y0, x1, y1, fill=s["color"], outline="")
                else:
                    self._tk_canvas.coords(s["id"], x0, y0, x1, y1)
        except Exception as e:
            logging.error(f"AnimatedBackground._render: {e}")

    def update_mouse(self, x: float, y: float):
        """Координаты мыши нормализованные [0..1] от ширины/высоты окна."""
        self._mouse_x_norm = max(0.0, min(1.0, x))
        self._mouse_y_norm = max(0.0, min(1.0, y))

    def update_palette(self, colors: Optional[List[str]] = None):
        """Перенастраивает цвета пятен (например при смене темы)."""
        new_colors = colors or self._default_colors()
        # Обновляем все три слоя
        for layer in (self._blobs_back, self._blobs_mid, self._sparkles):
            for i, b in enumerate(layer):
                b["color"] = new_colors[i % len(new_colors)]
                try:
                    if b["id"] is not None:
                        self._tk_canvas.itemconfig(b["id"], fill=b["color"])
                except Exception:
                    pass
        try:
            self._tk_canvas.configure(bg=self._bg_color())
        except Exception:
            pass

    def stop(self):
        self._enabled = False
        if self._animation_id is not None:
            try:
                self.root.after_cancel(self._animation_id)
            except Exception:
                pass

    def set_enabled(self, on: bool):
        was_enabled = self._enabled
        self._enabled = on
        if on and not was_enabled:
            self._tick()
        elif not on:
            try:
                self._tk_canvas.delete("all")
                for layer in (self._blobs_back, self._blobs_mid, self._sparkles):
                    for b in layer:
                        b["id"] = None
            except Exception:
                pass


