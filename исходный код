# --- MASCOT: emoji-маскот в углу окна ---
# ==========================================
class Mascot:
    """
    Emoji-маскот «Грузовичок» в правом нижнем углу окна.
    Состояния:
      - idle      → 🚛 (стоит)
      - working   → 🚛💨 (едет)
      - success   → 🚛✨ (счастливый)
      - error     → 🚛💔 (грустный)
      - sleeping  → 🚛💤 (когда программа долго в простое)

    При смене состояния — короткая анимация подпрыгивания.
    Размещается через place поверх статус-бара.
    """

    def __init__(self, root: ctk.CTk):
        self.root = root
        self._state = "idle"
        self._enabled = True

        # Контейнер с pill-фоном
        self._frame = ctk.CTkFrame(
            root,
            fg_color=UIConfig.COLOR_CARD_BG,
            corner_radius=UIConfig.CORNER_RADIUS_PILL,
            border_width=1,
            border_color=UIConfig.COLOR_BORDER)

        self._label = ctk.CTkLabel(
            self._frame,
            text="🚛",
            font=("Segoe UI", 22),
            text_color=UIConfig.COLOR_TEXT_MAIN)
        self._label.pack(padx=12, pady=4)

        # Размещаем в правом нижнем углу с отступом
        self._frame.place(relx=1.0, rely=1.0, anchor="se", x=-30, y=-60)
        # ВАЖНО: поднимаем поверх всех виджетов (PageHost-слотов и т.п.)
        try:
            self._frame.lift()
        except Exception:
            pass

        # Idle-anim: лёгкое покачивание раз в 4 секунды
        self._idle_tick()
        # Каждые 2 сек поднимаем маскот сверху — на случай если новая страница
        # его перекрыла
        self._lift_tick()

    def _lift_tick(self):
        """Регулярно поднимает маскот наверх — он должен быть всегда видим.
        Останавливается если виджет уничтожен или маскот выключен."""
        if not self._enabled:
            return
        try:
            if not self._frame.winfo_exists():
                return
            self._frame.lift()
        except Exception:
            return
        try:
            self.root.after(2000, self._lift_tick)
        except Exception:
            pass

    def set_state(self, state: str):
        if not self._enabled:
            return
        self._state = state
        emoji = {
            "idle":     "🚛",
            "working":  "🚛💨",
            "success":  "🚛✨",
            "error":    "🚛💔",
            "sleeping": "🚛💤",
        }.get(state, "🚛")
        try:
            self._label.configure(text=emoji)
            # Bounce-анимация при смене состояния
            self._bounce()
        except Exception:
            pass

    def _bounce(self):
        """Маленький прыжок: y -8 → y 0 за 280мс."""
        steps = 8
        interval = 35
        amplitude = 8

        def _step(i: int):
            if i > steps * 2:
                return
            try:
                # Полусинусоида: вверх-вниз
                import math
                t = i / (steps * 2)
                offset = -math.sin(t * math.pi) * amplitude
                self._frame.place_configure(y=int(-60 + offset))
            except Exception:
                return
            self.root.after(interval, lambda: _step(i + 1))
        _step(1)

    def _idle_tick(self):
        """Каждые 4 секунды лёгкое покачивание если в idle. Останавливается
        при выключенном маскоте или уничтоженном виджете."""
        if not self._enabled:
            return
        try:
            if not self._frame.winfo_exists():
                return
        except Exception:
            return
        try:
            if self._state == "idle":
                self._bounce()
        except Exception:
            pass
        try:
            self.root.after(4000, self._idle_tick)
        except Exception:
            pass

    def hide(self):
        self._enabled = False
        try:
            self._frame.place_forget()
        except Exception:
            pass

    def show(self):
        self._enabled = True
        try:
            self._frame.place(relx=1.0, rely=1.0, anchor="se", x=-30, y=-60)
        except Exception:
            pass


