def tail_file(path: Path, max_bytes: int = 5 * 1024 * 1024) -> str:
    """Читает последние max_bytes файла без загрузки всего в память."""
    try:
        size = path.stat().st_size
        offset = max(0, size - max_bytes)
        with open(path, "rb") as f:
            f.seek(offset)
            data = f.read()
        # Отбрасываем первую частичную строку
        nl = data.find(b"\n")
        if offset > 0 and nl != -1:
            data = data[nl + 1:]
        return data.decode("utf-8", errors="replace")
    except OSError:
        return ""


def sha256_streaming(path: Path, chunk: int = 1024 * 1024) -> str:
    """SHA-256 файла потоково (чанк 1 МБ) — для интегрити-чек."""
    h = hashlib.sha256()
    try:
        with open(path, "rb") as f:
            while True:
                data = f.read(chunk)
                if not data:
                    break
                h.update(data)
        return h.hexdigest()
    except OSError:
        return ""

def read_sii_safe(file_path: Path) -> List[str]:
    encodings = ['utf-8-sig', 'utf-8', 'cp1252', 'cp1251', 'latin-1']
    for enc in encodings:
        try:
            with open(file_path, 'r', encoding=enc) as f:
                return f.readlines()
        except UnicodeDecodeError:
            continue
        except OSError:
            break
    return []

def get_game_version(exe_path: Path) -> Optional[str]:
    try:
        size = ctypes.windll.version.GetFileVersionInfoSizeW(str(exe_path), None)
        if not size: return None
        res = ctypes.create_string_buffer(size)
        ctypes.windll.version.GetFileVersionInfoW(str(exe_path), None, size, res)
        rffi = ctypes.c_void_p()
        vsize = ctypes.c_uint()
        ctypes.windll.version.VerQueryValueW(res, "\\", ctypes.byref(rffi), ctypes.byref(vsize))
        
        class VS_FIXEDFILEINFO(ctypes.Structure):
            _fields_ = [
                ("dwSignature", ctypes.c_uint32), ("dwStrucVersion", ctypes.c_uint32),
                ("dwFileVersionMS", ctypes.c_uint32), ("dwFileVersionLS", ctypes.c_uint32)
            ]
        info = VS_FIXEDFILEINFO.from_address(rffi.value)
        return f"{info.dwFileVersionMS >> 16}.{info.dwFileVersionMS & 0xFFFF}.{info.dwFileVersionLS >> 16}.{info.dwFileVersionLS & 0xFFFF}"
    except Exception as e:
        log_error("get_game_version", e)
        return None

