    def export_config(self):
        """Экспорт настроек + манифеста в JSON-файл (без секретов)."""
        path = filedialog.asksaveasfilename(
            defaultextension=".json",
            filetypes=[("Nexus Config", "*.json")],
            initialfile=f"ets2_nexus_config_{datetime.now():%Y%m%d_%H%M}.json")
        if not path:
            return
        try:
            bundle = {
                "version": AppConfig.PROGRAM_VERSION,
                "exported_at": datetime.now().isoformat(),
                "settings": self.settings,
                "manifest": ManifestCache.get(),
                # GitHub-токен НЕ экспортируем — это секрет (DPAPI-привязан к ПК)
            }
            Path(path).write_text(
                json.dumps(bundle, indent=2, ensure_ascii=False), encoding="utf-8")
            if hasattr(self, "toast"):
                self.toast.show("Конфигурация экспортирована", "success")
        except Exception as e:
            log_error("export_config", e)
            messagebox.showerror("Ошибка", f"Не удалось экспортировать: {e}")

    def import_config(self):
        """Импорт настроек из JSON-файла."""
        path = filedialog.askopenfilename(
            filetypes=[("Nexus Config", "*.json")])
        if not path:
            return
        try:
            data = json.loads(Path(path).read_text(encoding="utf-8"))
            if not messagebox.askyesno(
                    "Импорт настроек",
                    f"Импортировать настройки из бэкапа от "
                    f"{data.get('exported_at', '?')}?\n\n"
                    "Текущие настройки будут заменены."):
                return
            if "settings" in data:
                self.settings.update(data["settings"])
                self.save_settings()
                self.apply_theme()
            if "manifest" in data and isinstance(data["manifest"], dict):
                ManifestCache.save(data["manifest"])
            if hasattr(self, "toast"):
                self.toast.show("Настройки импортированы", "success")
            else:
                messagebox.showinfo("Готово", "Настройки импортированы.")
        except Exception as e:
            log_error("import_config", e)
            messagebox.showerror("Ошибка импорта", f"Не удалось импортировать: {e}")

    def verify_mod_integrity(self) -> List[Dict]:
        """
        Сверяет SHA-256 установленных модов с манифестом.
        Возвращает список словарей: name, path, expected, actual, is_ok.
        """
        manifest = ManifestCache.get()
        results: List[Dict] = []
        mod_dir = get_my_documents() / "Euro Truck Simulator 2" / "mod"
        if not mod_dir.exists():
            return results
        for mod_file in sorted(mod_dir.glob("*.scs")):
            entry = manifest.get(mod_file.name, {})
            expected = entry.get("sha256", "")
            if not expected:
                continue
            actual = sha256_streaming(mod_file)
            results.append({
                "name": mod_file.name,
                "path": mod_file,
                "expected": expected,
                "actual": actual,
                "is_ok": (actual == expected),
            })
        return results

    def show_integrity_check(self):
        """UI-страница: проверка целостности модов."""
        self.clear_content()
        self.set_status("Проверка целостности...")
        ctk.CTkLabel(self.main_content, text="🛡️ Проверка целостности модов",
                     font=UIConfig.FONT_TITLE,
                     text_color=UIConfig.COLOR_TEXT_MAIN).pack(pady=(10, 5), anchor="w")
        ctk.CTkLabel(self.main_content,
                     text="Сверяет SHA-256 каждого .scs файла с манифестом установки.",
                     font=UIConfig.FONT_MAIN,
                     text_color=UIConfig.COLOR_TEXT_MUTED).pack(anchor="w", pady=(0, 15))

        scroll = ctk.CTkScrollableFrame(self.main_content,
                                         fg_color=UIConfig.COLOR_CARD_BG, corner_radius=10)
        scroll.pack(fill="both", expand=True)

        progress_lbl = ctk.CTkLabel(scroll, text="⏳ Сканирование...",
                                     font=("Segoe UI", 13, "bold"))
        progress_lbl.pack(pady=20)

        def _worker():
            try:
                results = self.verify_mod_integrity()
            except Exception as e:
                log_error("verify_mod_integrity worker", e)
                results = []
            self.after(0, lambda: self._render_integrity_results(scroll, progress_lbl, results))

        threading.Thread(target=_worker, daemon=True).start()

    def _render_integrity_results(self, scroll, progress_lbl, results):
        try:
            progress_lbl.destroy()
        except Exception:
            pass
        if not results:
            ctk.CTkLabel(scroll,
                         text="ℹ️ Манифест не содержит SHA-256 для проверки.\n"
                              "После следующей синхронизации проверка станет доступна.",
                         font=UIConfig.FONT_MAIN,
                         text_color=UIConfig.COLOR_TEXT_MUTED, justify="left"
                         ).pack(pady=20, padx=20)
            return
        ok_count = sum(1 for r in results if r["is_ok"])
        bad = [r for r in results if not r["is_ok"]]
        ctk.CTkLabel(scroll,
                     text=f"✅ Целы: {ok_count}/{len(results)}     ❌ Повреждены: {len(bad)}",
                     font=("Segoe UI", 16, "bold"),
                     text_color=(UIConfig.COLOR_SUCCESS if not bad
                                 else UIConfig.COLOR_DANGER)
                     ).pack(pady=10, padx=15, anchor="w")
        for r in results:
            row = ctk.CTkFrame(scroll, fg_color="transparent")
            row.pack(fill="x", pady=3, padx=10)
            icon = "✅" if r["is_ok"] else "❌"
            color = (UIConfig.COLOR_SUCCESS if r["is_ok"]
                     else UIConfig.COLOR_DANGER)
            ctk.CTkLabel(row, text=f"{icon}  {r['name']}",
                         font=UIConfig.FONT_MAIN, text_color=color
                         ).pack(side="left")

    def show_token_dialog(self):
        """Окно для ввода/удаления GitHub-токена."""
        dlg = ctk.CTkToplevel(self)
        dlg.title("GitHub API Token")
        dlg.geometry("520x340")
        dlg.transient(self)
        dlg.grab_set()

        ctk.CTkLabel(dlg, text="🔑 Личный GitHub-токен",
                     font=("Segoe UI", 18, "bold")).pack(pady=(15, 5))
        ctk.CTkLabel(dlg,
                     text=("Без токена лимит — 60 запросов в час.\n"
                           "С токеном — 5000. Токен шифруется DPAPI и привязывается\n"
                           "к вашему Windows-аккаунту (другие пользователи ПК\n"
                           "не смогут его расшифровать)."),
                     font=("Segoe UI", 12),
                     text_color=UIConfig.COLOR_TEXT_MUTED, justify="left"
                     ).pack(pady=(0, 15), padx=20)

        ctk.CTkLabel(dlg, text="Токен (ghp_...):",
                     font=("Segoe UI", 12, "bold")).pack(anchor="w", padx=20)
        token_entry = ctk.CTkEntry(dlg,
                                    placeholder_text="ghp_xxxxxxxxxxxxxxxxxxxx",
                                    height=36)
        token_entry.pack(fill="x", padx=20, pady=(5, 15))

        # Явная обработка вставки для CTkEntry (работает с любой раскладкой)
        def _paste_token(e=None):
            try:
                clipboard = dlg.clipboard_get()
                if clipboard:
                    token_entry.insert("end", clipboard)
            except Exception:
                pass
            return "break"
        token_entry.bind("<Control-v>", _paste_token)
        token_entry.bind("<Control-m>", _paste_token)  # Работает независимо от раскладки
        token_entry.bind("<Button-3>", lambda e: _paste_token())  # Правая кнопка мыши

        status_lbl = ctk.CTkLabel(dlg, text="", font=("Segoe UI", 11, "bold"))
        status_lbl.pack(pady=5)

        def _save():
            t = token_entry.get().strip()
            if not t:
                status_lbl.configure(text="⚠️ Введите токен",
                                     text_color=UIConfig.COLOR_WARNING)
                return
            # Проверяем формат токена
            if not t.startswith("ghp_"):
                status_lbl.configure(text="⚠️ Токен должен начинаться с 'ghp_'",
                                     text_color=UIConfig.COLOR_WARNING)
                return
            try:
                if SecureConfig.set_github_token(t):
                    status_lbl.configure(
                        text="✅ Токен сохранён зашифрованным (DPAPI).",
                        text_color=UIConfig.COLOR_SUCCESS)
                    token_entry.delete(0, "end")
                    if hasattr(self, "toast"):
                        self.toast.show("Токен сохранён", "success")
                else:
                    status_lbl.configure(text="❌ Ошибка сохранения. Проверьте права папки.",
                                         text_color=UIConfig.COLOR_DANGER)
            except Exception as e:
                log_error("save_token", e)
                status_lbl.configure(text=f"❌ Ошибка: {str(e)[:30]}",
                                     text_color=UIConfig.COLOR_DANGER)

        def _clear():
            SecureConfig.clear_github_token()
            status_lbl.configure(text="🗑️ Токен удалён",
                                 text_color=UIConfig.COLOR_WARNING)
            if hasattr(self, "toast"):
                self.toast.show("Токен удалён", "info")

        btn_row = ctk.CTkFrame(dlg, fg_color="transparent")
        btn_row.pack(pady=10)
        ctk.CTkButton(btn_row, text="💾 Сохранить",
                      fg_color=UIConfig.COLOR_SUCCESS,
                      hover_color=UIConfig.COLOR_SUCCESS_HOVER,
                      command=_save, height=38, width=140).pack(side="left", padx=8)
        ctk.CTkButton(btn_row, text="🗑️ Удалить",
                      fg_color=UIConfig.COLOR_DANGER,
                      hover_color=UIConfig.COLOR_DANGER_HOVER,
                      command=_clear, height=38, width=140).pack(side="left", padx=8)
        ctk.CTkButton(btn_row, text="🔗 Создать токен",
                      fg_color=UIConfig.COLOR_BTN_GRAY,
                      hover_color=UIConfig.COLOR_BTN_GRAY_HOVER,
                      text_color=UIConfig.COLOR_TEXT_MAIN,
                      command=lambda: webbrowser.open(
                          "https://github.com/settings/tokens/new?scopes=public_repo&description=ETS2-Nexus"),
                      height=38, width=160).pack(side="left", padx=8)

