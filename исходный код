# --- GAME WATCHDOG: мониторинг процесса ETS2 ---
# ==========================================
class GameWatchdog:
    """
    Фоновый монитор процесса ETS2.

    Отслеживает события:
      - launched: игра запустилась (был not running, стал running)
      - crashed: игра упала в первые 60 сек после старта
      - long_session: игра идёт >2 часов (toast «не забывайте перерывы»)
      - hung: процесс жив, но CPU=0% более 30 секунд (предложить kill)
      - exited: игра нормально закрылась после полноценной сессии

    Все события передаются в callback который регистрирует ETS2Manager.
    """

    CHECK_INTERVAL_S = 5
    CRASH_THRESHOLD_S = 60       # упала в первые N секунд = краш
    LONG_SESSION_S = 2 * 3600    # >2 часов = долгая сессия
    HANG_DETECTION_S = 30        # CPU=0% более N секунд = зависла
    BREAK_REMINDER_INTERVAL_S = 90 * 60   # каждые 90 мин предлагать перерыв

    def __init__(self, root: ctk.CTk, on_event: Callable[[str, dict], None]):
        self.root = root
        self.on_event = on_event
        self._running = True

        # Состояние
        self._game_running = False
        self._session_start_ts: Optional[float] = None
        self._zero_cpu_since: Optional[float] = None
        self._last_break_reminder_ts = 0.0
        self._notified_long = False
        self._notified_hang = False

    def start(self):
        threading.Thread(target=self._loop, daemon=True).start()

    def stop(self):
        self._running = False

    def _loop(self):
        while self._running:
            try:
                self._tick()
            except Exception as e:
                logging.error(f"GameWatchdog._tick: {e}")
            time.sleep(self.CHECK_INTERVAL_S)

    def _tick(self):
        currently_running = is_game_running()

        # ── Запуск ──
        if currently_running and not self._game_running:
            self._game_running = True
            self._session_start_ts = time.time()
            self._zero_cpu_since = None
            self._notified_long = False
            self._notified_hang = False
            self._last_break_reminder_ts = 0.0
            self._emit("launched", {"started_at": self._session_start_ts})
            return

        # ── Игра НЕ запущена ──
        if not currently_running:
            if self._game_running:
                # Только что закрылась/упала
                duration = time.time() - (self._session_start_ts or time.time())
                if duration < self.CRASH_THRESHOLD_S:
                    self._emit("crashed", {"duration_s": duration})
                else:
                    self._emit("exited", {"duration_s": duration})
                self._game_running = False
                self._session_start_ts = None
            return

        # ── Игра идёт ──
        if not self._session_start_ts:
            self._session_start_ts = time.time()
        session_duration = time.time() - self._session_start_ts

        # ── Долгая сессия (один раз) ──
        if (session_duration >= self.LONG_SESSION_S
                and not self._notified_long):
            self._notified_long = True
            self._emit("long_session", {"duration_s": session_duration})

        # ── Регулярные напоминания о перерывах (каждые 90 мин) ──
        if (session_duration >= self.BREAK_REMINDER_INTERVAL_S
                and (time.time() - self._last_break_reminder_ts)
                    >= self.BREAK_REMINDER_INTERVAL_S):
            self._last_break_reminder_ts = time.time()
            self._emit("break_reminder", {"duration_s": session_duration})

        # ── Детект зависания через CPU% ──
        if _PSUTIL_OK:
            cpu = self._get_game_cpu_percent()
            if cpu is not None:
                if cpu < 0.5:
                    if self._zero_cpu_since is None:
                        self._zero_cpu_since = time.time()
                    elif (time.time() - self._zero_cpu_since
                            >= self.HANG_DETECTION_S
                            and not self._notified_hang):
                        self._notified_hang = True
                        self._emit("hung", {"zero_cpu_for_s":
                            time.time() - self._zero_cpu_since})
                else:
                    self._zero_cpu_since = None
                    self._notified_hang = False

    def _get_game_cpu_percent(self) -> Optional[float]:
        """Возвращает CPU% процесса ETS2 (через psutil). None если psutil нет."""
        if not _PSUTIL_OK:
            return None
        try:
            for proc in psutil.process_iter(["name"]):
                try:
                    name = proc.info.get("name") or ""
                    if name.lower() == "eurotrucks2.exe":
                        return proc.cpu_percent(interval=None)
                except Exception:
                    continue
        except Exception:
            pass
        return None

    def _emit(self, kind: str, payload: dict):
        try:
            self.root.after(0, lambda: self.on_event(kind, payload))
        except Exception:
            pass


