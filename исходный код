    def open_snake_window(self):
        """
        Открывает Snake в отдельном Toplevel-окне.
        Не блокирует main, можно держать рядом во время загрузки модов.
        Если окно уже открыто — поднимает его наверх вместо создания нового.
        """
        try:
            existing = getattr(self, "_snake_window", None)
            if existing and existing.winfo_exists():
                existing.lift()
                existing.focus_force()
                return
        except Exception:
            pass

        win = ctk.CTkToplevel(self)
        win.title("🐍 Snake — пока загружаются моды")
        win.geometry("520x520")
        win.transient(self)
        win.configure(fg_color=UIConfig.COLOR_BG)

        # Центрируем относительно главного окна
        try:
            x = self.winfo_rootx() + self.winfo_width() // 2 - 260
            y = self.winfo_rooty() + self.winfo_height() // 2 - 260
            win.geometry(f"+{x}+{y}")
        except Exception:
            pass

        # Создаём Snake внутри окна
        try:
            if hasattr(self, "_snake_game") and self._snake_game:
                try:
                    self._snake_game.stop()
                except Exception:
                    pass
            self._snake_game = SnakeGame(win, root=self)
            self._snake_game.widget.pack(fill="both", expand=True, padx=14, pady=14)
            # Канвас Snake сразу получает фокус
            try:
                self._snake_game._canvas.focus_set()
            except Exception:
                pass
        except Exception as e:
            log_error("open_snake_window", e)

        # При закрытии окна — останавливаем игру
        def _on_close():
            try:
                if self._snake_game:
                    self._snake_game.stop()
            except Exception:
                pass
            self._snake_window = None
            try:
                win.destroy()
            except Exception:
                pass

        win.protocol("WM_DELETE_WINDOW", _on_close)
        self._snake_window = win

