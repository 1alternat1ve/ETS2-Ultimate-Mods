            "match_any": ["plugin", "telemetry"],
            "description":
                "Сторонний .dll плагин в bin/win_x64/plugins/ упал или "
                "несовместим с текущей версией.",
            "solutions": [
                "Перейдите в Оптимизация → Сбросить плагины (создаёт бэкап)",
                "Обновите TruckersMP до последней версии",
                "Если используете телеметрию для приборки — обновите её плагин",
            ],
        },
    ]

    @classmethod
    def analyze(cls, log_text: str) -> List[LogIssue]:
        """
        Сканирует текст лога и возвращает обнаруженные проблемы.
        Каждая проблема считается ОДИН раз даже если матчится много строк
        (но мы запоминаем количество совпадений в matched_lines).
        """
        results: Dict[str, LogIssue] = {}
        lower = log_text.lower()

        for pattern in cls.PATTERNS:
            match_any = pattern.get("match_any", [])
            match_all = pattern.get("match_all", [])

            # Проверяем any (хотя бы один паттерн встречается)
            any_ok = (not match_any) or any(p in lower for p in match_any)
            all_ok = (not match_all) or all(p in lower for p in match_all)

            if not (any_ok and all_ok):
                continue

            # Считаем количество строк с этим паттерном (приблизительно)
            count = 0
            for line in lower.splitlines():
                if "<error>" in line or "<warning>" in line:
                    if any(p in line for p in (match_any or match_all)):
                        count += 1

            issue = LogIssue(
                issue_id=pattern["id"],
                title=pattern["title"],
                severity=pattern["severity"],
                category=pattern["category"],
                description=pattern["description"],
                solutions=pattern["solutions"],
                stats_hint=pattern.get("stats_hint", ""),
                matched_lines=count,
            )
            results[pattern["id"]] = issue

        # Сортируем по severity (critical → high → medium → low)
        sev_order = {"critical": 0, "high": 1, "medium": 2, "low": 3}
        return sorted(results.values(),
                       key=lambda i: sev_order.get(i.severity, 4))


