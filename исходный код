    def _file_row_set_status(self, name: str, state: str, extra: str = ""):
        """
        state: 'wait' | 'downloading' | 'installing' | 'done' | 'skipped' | 'error'

        Mission Control: статус — короткий цветной значок в углу карточки.
        Имена в карточке остаются неизменными — статус меняет только цвет
        иконки и border плитки.
        """
        entry = self._file_rows.get(name)
        if not entry:
            entry = self._file_row_create(name)
        # (status_text, status_color, border_color)
        cfg = {
            "wait":         ("◌",  UIConfig.COLOR_TEXT_GHOST, UIConfig.COLOR_BORDER),
            "downloading":  ("⬇",  UIConfig.COLOR_ACCENT,     UIConfig.COLOR_ACCENT),
            "installing":   ("⚙",  UIConfig.COLOR_PURPLE,     UIConfig.COLOR_PURPLE),
            "done":         ("✓",  UIConfig.COLOR_SUCCESS,    UIConfig.COLOR_SUCCESS),
            "skipped":      ("↷",  UIConfig.COLOR_TEXT_MUTED, UIConfig.COLOR_BORDER),
            "error":        ("✗",  UIConfig.COLOR_DANGER,     UIConfig.COLOR_DANGER),
        }
        sym, sym_color, border = cfg.get(state, cfg["wait"])
        try:
            entry["status_lbl"].configure(text=sym, text_color=sym_color)
            entry["row"].configure(border_color=border)
            prev_state = entry.get("status", "wait")
            entry["status"] = state

            mode_idx = 0 if self.settings.get("appearance") == "Light" else 1

            # === Цветовая анимация плитки ===
            # При выходе из downloading — обязательно останавливаем дыхание.
            if prev_state == "downloading" and state != "downloading":
                Anim.stop_breathing(entry["row"], restore_color=border[mode_idx]
                                     if isinstance(border, tuple) else border)

            if state == "downloading":
                # Карусель подъезжает к плитке
                self._maybe_follow_active_file(entry["row"])
                # «Дыхание»: border пульсирует между accent ↔ accent2 (фиолет)
                try:
                    color_low = (UIConfig.COLOR_ACCENT[mode_idx]
                                  if isinstance(UIConfig.COLOR_ACCENT, tuple)
                                  else UIConfig.COLOR_ACCENT)
                    color_high = (UIConfig.COLOR_ACCENT_2[mode_idx]
                                   if isinstance(UIConfig.COLOR_ACCENT_2, tuple)
                                   else UIConfig.COLOR_ACCENT_2)
                    Anim.breathing_glow(entry["row"], color_low, color_high,
                                          period_ms=1400, steps=28, root=self)
                except Exception:
                    pass

            # Финальный импульс при переходе в done
            if state == "done" and prev_state != "done":
                try:
                    Anim.pulse(entry["row"], UIConfig.COLOR_SUCCESS[mode_idx],
                               duration_ms=350, root=self)
                except Exception:
                    pass

            # Обновляем сводку (✓/↷/✗)
            self._update_summary_pills()
        except Exception:
            pass

    def _update_summary_pills(self):
        """Подсчитывает по статусу и обновляет ✓ / ↷ / ✗ карточку."""
        if not hasattr(self, "_sum_done_lbl"):
            return
        try:
            done = sum(1 for e in self._file_rows.values() if e["status"] == "done")
            skip = sum(1 for e in self._file_rows.values() if e["status"] == "skipped")
            err = sum(1 for e in self._file_rows.values() if e["status"] == "error")
            self._sum_done_lbl.configure(text=f"✓ {done}")
            self._sum_skip_lbl.configure(text=f"↷ {skip}")
            self._sum_err_lbl.configure(text=f"✗ {err}")
        except Exception:
            pass

    def _maybe_follow_active_file(self, row_widget):
        """
        Mission Control: автоследование за активным файлом.

        Карусель ВСЕГДА мягко подъезжает к активной плитке, чтобы пользователю
        не приходилось листать вручную. Анимация — плавная (240мс ease-out).

        Если пользователь сам недавно прокрутил карусель (за последние 4 сек),
        автоследование временно отключается — мы уважаем ручной ввод.
        """
        try:
            canvas = self._files_list._parent_canvas
            # Учитываем последний ручной ввод
            last_user_scroll = getattr(self, "_last_user_scroll", 0.0)
            if (time.time() - last_user_scroll) < 4.0:
                return  # пользователь сейчас сам листает — не мешаем

            row_widget.update_idletasks()
            # Координаты плитки внутри files_list
            tile_x = row_widget.winfo_x()
            tile_w = row_widget.winfo_width() or 160
            content_w = self._files_list.winfo_width() or 1

            # Полная ширина scroll-content (то, что внутри canvas)
            try:
                bbox = canvas.bbox("all")
                full_w = bbox[2] - bbox[0] if bbox else content_w
            except Exception:
                full_w = content_w

            if full_w <= content_w:
                return  # всё помещается — нечего скроллить

            # Целевая позиция: плитка ~25% от левого края видимой области
            # (т.е. видно одну-две предыдущие, и несколько следующих)
            target_left = tile_x - content_w * 0.25
            target_left = max(0, min(target_left, full_w - content_w))
            target_frac = target_left / max(full_w - content_w, 1)

            # Плавно перегоняем
            self._smooth_xview(canvas, target_frac, duration_ms=260)
        except Exception:
            pass

    def _smooth_xview(self, canvas, target_frac: float,
                       duration_ms: int = 240, steps: int = 12):
        """Плавно прокручивает canvas по горизонтали к target_frac (0..1)."""
        try:
            current = canvas.xview()[0]
            target = max(0.0, min(1.0, float(target_frac)))
            delta = target - current
            if abs(delta) < 0.01:
                canvas.xview_moveto(target)
                return
            interval = max(8, duration_ms // steps)

            def _step(i: int):
                if i > steps:
                    try:
                        canvas.xview_moveto(target)
                    except Exception:
                        pass
                    return
                t = i / steps
                eased = 1 - (1 - t) ** 3
                pos = current + delta * eased
                try:
                    canvas.xview_moveto(pos)
                except Exception:
                    return
                self.after(interval, lambda: _step(i + 1))

            _step(1)
        except Exception:
            pass

