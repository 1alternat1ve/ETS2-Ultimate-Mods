        left = ctk.CTkFrame(
            body, fg_color=UIConfig.COLOR_CARD_BG,
            corner_radius=UIConfig.CORNER_RADIUS_CARD,
            border_width=1, border_color=UIConfig.COLOR_BORDER)
        left.grid(row=0, column=0, sticky="nsew", padx=(0, 8))

        left_inner = ctk.CTkFrame(left, fg_color="transparent")
        left_inner.pack(fill="both", expand=True, padx=24, pady=22)

        # Большой процент
        pct_row = ctk.CTkFrame(left_inner, fg_color="transparent")
        pct_row.pack(fill="x")
        self._sync_pct_lbl = ctk.CTkLabel(
            pct_row, text="0%",
            font=("Segoe UI Black", 64),
            text_color=UIConfig.COLOR_TEXT_MAIN, anchor="w")
        self._sync_pct_lbl.pack(side="left")
        self._sync_pct_unit = ctk.CTkLabel(
            pct_row, text="общий прогресс",
            font=("Segoe UI", 12),
            text_color=UIConfig.COLOR_TEXT_GHOST, anchor="sw")
