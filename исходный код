def is_admin() -> bool:
    try:
        return ctypes.windll.shell32.IsUserAnAdmin() != 0
    except Exception:
        return False

def hex_to_nickname(hex_str: str) -> str:
    try:
        return bytes.fromhex(hex_str).decode('utf-8')
    except ValueError:
        return hex_str

def get_my_documents() -> Path:
    CSIDL_PERSONAL = 5
    buf = ctypes.create_unicode_buffer(wintypes.MAX_PATH)
    ctypes.windll.shell32.SHGetFolderPathW(None, CSIDL_PERSONAL, None, 0, buf)
    return Path(buf.value)

def get_profiles_dir() -> Path:
    return get_my_documents() / "Euro Truck Simulator 2" / "profiles"

def is_onedrive_path(path: Path) -> bool:
    return "onedrive" in str(path).lower()

def read_sii_safe(file_path: Path) -> List[str]:
    encodings = ['utf-8-sig', 'utf-8', 'cp1252', 'cp1251', 'latin-1']
    for enc in encodings:
        try:
            with open(file_path, 'r', encoding=enc) as f:
                return f.readlines()
        except UnicodeDecodeError:
            continue
        except OSError:
            break
    return []

def get_game_version(exe_path: Path) -> Optional[str]:
    try:
        size = ctypes.windll.version.GetFileVersionInfoSizeW(str(exe_path), None)
        if not size: return None
        res = ctypes.create_string_buffer(size)
        ctypes.windll.version.GetFileVersionInfoW(str(exe_path), None, size, res)
        rffi = ctypes.c_void_p()
        vsize = ctypes.c_uint()
        ctypes.windll.version.VerQueryValueW(res, "\\", ctypes.byref(rffi), ctypes.byref(vsize))
        
        class VS_FIXEDFILEINFO(ctypes.Structure):
            _fields_ = [
                ("dwSignature", ctypes.c_uint32), ("dwStrucVersion", ctypes.c_uint32),
                ("dwFileVersionMS", ctypes.c_uint32), ("dwFileVersionLS", ctypes.c_uint32)
            ]
        info = VS_FIXEDFILEINFO.from_address(rffi.value)
        return f"{info.dwFileVersionMS >> 16}.{info.dwFileVersionMS & 0xFFFF}.{info.dwFileVersionLS >> 16}.{info.dwFileVersionLS & 0xFFFF}"
    except Exception as e:
        log_error("get_game_version", e)
        return None

def run_hidden_process(command: List[str]):
    creationflags = subprocess.CREATE_NO_WINDOW if sys.platform == "win32" else 0
    return subprocess.run(command, creationflags=creationflags, capture_output=True, text=True)

def is_game_running() -> bool:
    try:
        hwnd = ctypes.windll.user32.FindWindowW("prism3d", None)
        return bool(hwnd)
    except Exception:
        return False

def is_steam_running() -> bool:
    try:
        output = subprocess.check_output('tasklist', creationflags=subprocess.CREATE_NO_WINDOW).decode('cp866', 'ignore')
        return "steam.exe" in output.lower()
    except Exception:
        return True 

def parse_version(v_string: str) -> tuple:
    clean_v = v_string.lower().replace('v', '').strip()
    try:
        return tuple(map(int, clean_v.split('.')))
    except Exception:
        return (0, 0, 0)

