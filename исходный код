            "description": "Звуки двигателей, клаксоны, окружение",
            "keywords": ["sound", "engine_sound", "horn", "audio",
                          "kriechbaum", "fmod"],
        },
        "graphics": {
            "name": "🌅  Графика",
            "description": "Reshade, текстуры, освещение",
            "keywords": ["graphic", "reshade", "hd", "weather", "lighting",
                          "fog", "rain", "skybox", "sky"],
        },
        "physics": {
            "name": "⚙  Физика",
            "description": "Моды физики, подвески, рулевого управления",
            "keywords": ["physic", "suspension", "wheel"],
        },
        "other": {
            "name": "✦  Прочее",
            "description": "Всё что не попало в другие категории",
            "keywords": [],   # fallback
        },
    }

    DISABLED_SUFFIX = ".off"

    @classmethod
    def categorize(cls, mod_name: str) -> str:
        """Определяет группу по имени файла мода."""
        name_lower = mod_name.lower()
        # Убираем суффикс .off если есть
        if name_lower.endswith(cls.DISABLED_SUFFIX):
            name_lower = name_lower[:-len(cls.DISABLED_SUFFIX)]
        for group_id, group in cls.GROUPS.items():
            if group_id == "other":
                continue
            for kw in group["keywords"]:
                if kw in name_lower:
                    return group_id
        return "other"

    @classmethod
    def scan_mod_directory(cls) -> Dict[str, List[Dict]]:
        """
        Сканирует Documents/ETS2/mod/ и группирует моды.
        Возвращает {group_id: [{name, path, size_mb, enabled}, ...]}
        """
        result: Dict[str, List[Dict]] = {gid: [] for gid in cls.GROUPS}
        mod_dir = get_my_documents() / "Euro Truck Simulator 2" / "mod"
        if not mod_dir.exists():
            return result

        # Собираем все .scs (включая .scs.off)
        for f in mod_dir.iterdir():
            if not f.is_file():
                continue
            name = f.name
            if not (name.lower().endswith(".scs") or
                    name.lower().endswith(".scs" + cls.DISABLED_SUFFIX)):
                continue
            enabled = not name.lower().endswith(cls.DISABLED_SUFFIX)
            display_name = name
            if not enabled:
                display_name = name[:-len(cls.DISABLED_SUFFIX)]
            try:
                size_mb = f.stat().st_size / (1024 * 1024)
            except Exception:
                size_mb = 0
            group = cls.categorize(display_name)
            result[group].append({
                "name": display_name,
                "path": f,
                "size_mb": size_mb,
                "enabled": enabled,
            })
        # Сортируем по имени внутри группы
        for gid in result:
            result[gid].sort(key=lambda m: m["name"].lower())
        return result

    @classmethod
    def set_mod_enabled(cls, mod_path: Path, enabled: bool) -> bool:
        """
        Включает/выключает мод переименованием.
        mod.scs ↔ mod.scs.off
        Возвращает True при успехе.
        """
        try:
            if not mod_path.exists():
                return False
            current_name = mod_path.name
            is_currently_disabled = current_name.lower().endswith(cls.DISABLED_SUFFIX)

            if enabled and is_currently_disabled:
                # mod.scs.off → mod.scs
                new_name = current_name[:-len(cls.DISABLED_SUFFIX)]
                new_path = mod_path.with_name(new_name)
                mod_path.rename(new_path)
                return True
            elif not enabled and not is_currently_disabled:
                # mod.scs → mod.scs.off
                new_path = mod_path.with_name(current_name + cls.DISABLED_SUFFIX)
                mod_path.rename(new_path)
                return True
            return True  # уже в нужном состоянии
        except Exception as e:
            logging.error(f"ModGroups.set_mod_enabled: {e}")
            return False

    @classmethod
    def set_group_enabled(cls, group_mods: List[Dict],
                            enabled: bool) -> Tuple[int, int]:
        """
        Включает/выключает все моды группы. Обновляет path после переименования.
        Возвращает (успешно, всего).
        """
        ok = 0
        for mod in group_mods:
            old_path = mod["path"]
            if cls.set_mod_enabled(old_path, enabled):
                ok += 1
                # Вычисляем новый path детерминистично
                old_name = old_path.name
                if enabled:
                    # Хотим включить → имя БЕЗ .off
                    new_name = (old_name[:-len(cls.DISABLED_SUFFIX)]
                                  if old_name.endswith(cls.DISABLED_SUFFIX)
                                  else old_name)
                else:
                    # Хотим выключить → имя С .off
                    new_name = (old_name
                                  if old_name.endswith(cls.DISABLED_SUFFIX)
                                  else old_name + cls.DISABLED_SUFFIX)
                mod["path"] = old_path.with_name(new_name)
                mod["enabled"] = enabled
        return ok, len(group_mods)


