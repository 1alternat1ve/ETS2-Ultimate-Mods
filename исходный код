            self._save_metric(m_row, "Баланс",
                                f"{stats['money']:,} €".replace(",", " "),
                                UIConfig.COLOR_SUCCESS)
        if stats["xp"] is not None:
            self._save_metric(m_row, "Опыт",
                                f"{stats['xp']:,}".replace(",", " "),
                                UIConfig.COLOR_PURPLE)
        if stats["distance_km"]:
            self._save_metric(m_row, "Пробег",
                                f"{stats['distance_km']:,.0f} км"
                                .replace(",", " "),
                                UIConfig.COLOR_ACCENT)

        # Доп. метрики (грузовики/гаражи)
        m2 = ctk.CTkFrame(card, fg_color="transparent")
        m2.pack(fill="x", padx=20, pady=(0, 6))
        if stats["trucks_owned"]:
            self._save_metric(m2, "Грузовики",
                                str(stats["trucks_owned"]),
                                UIConfig.COLOR_TEXT_MAIN)
        if stats["garages"]:
            self._save_metric(m2, "Гаражи",
                                str(stats["garages"]),
                                UIConfig.COLOR_TEXT_MAIN)

        # Время последней игры
        days_ago = (datetime.now() - dt).days
        ago_text = ("сегодня" if days_ago == 0
                    else "вчера" if days_ago == 1
                    else f"{days_ago} дн. назад"
                    if days_ago < 30 else dt.strftime("%d.%m.%Y"))
        ctk.CTkLabel(card, text=f"⏱  Последняя игра: {ago_text}",
                     font=UIConfig.FONT_TINY,
                     text_color=UIConfig.COLOR_TEXT_GHOST,
                     anchor="w").pack(anchor="w", padx=20, pady=(8, 0))

        # Превью-скриншоты (общая папка)
