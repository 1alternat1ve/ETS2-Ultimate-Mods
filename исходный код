    _early_log_path = Path(sys.executable).parent / "startup_debug.txt" \
        if (getattr(sys, 'frozen', False) or "__compiled__" in globals()) \
        else Path(os.path.abspath(__file__)).parent / "startup_debug.txt"
    def _early_log(msg: str):
        try:
            with open(_early_log_path, 'a', encoding='utf-8') as _f:
                _f.write(f"[{datetime.now().strftime('%H:%M:%S.%f')}] {msg}\n")
        except Exception:
            pass

    _early_log("=== СТАРТ EXE ===")
    _early_log(f"sys.executable = {sys.executable}")
    _early_log(f"frozen = {getattr(sys, 'frozen', False)}, compiled = {'__compiled__' in globals()}")
    _early_log(f"is_admin = {is_admin()}")

    if sys.stdout is None:
        sys.stdout = open(os.devnull, 'w')
    if sys.stderr is None:
        sys.stderr = open(os.devnull, 'w')

    try:
        _early_log("setup_logging()...")
        setup_logging()
        _early_log("Создаём ETS2Manager()...")
        app = ETS2Manager()
        _early_log("mainloop()...")
        app.mainloop()
        _early_log("mainloop() завершён нормально.")
    except Exception as _fatal_exc:
        _tb = traceback.format_exc()
        _early_log(f"FATAL EXCEPTION: {_fatal_exc}\n{_tb}")
        try:
            with open(AppConfig.CRASH_LOG_FILE, 'a', encoding='utf-8') as _f:
                _f.write(f"\n[FATAL] {datetime.now()}\n{_tb}\n")
        except Exception:
            pass
        try:
            import tkinter as _tk
            from tkinter import messagebox as _mb
            _r = _tk.Tk(); _r.withdraw()
            _mb.showerror("Критическая ошибка",
                f"Программа аварийно завершилась:\n\n{str(_fatal_exc)}\n\n"
                f"Подробности сохранены в startup_debug.txt\n\n{_tb[-800:]}")
            _r.destroy()
        except Exception as _gui_exc:
            _early_log(f"Не удалось показать GUI-ошибку: {_gui_exc}")
            pass
