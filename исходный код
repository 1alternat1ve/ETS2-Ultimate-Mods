    def _load_manifest(self) -> dict:
        """
        Манифест теперь читается через ManifestCache (один раз за сессию,
        инвалидация по mtime). Это убирает повторные обращения к диску.
        """
        return ManifestCache.get()

    def _save_manifest(self, manifest: dict):
        """Атомарная запись через ManifestCache."""
        ManifestCache.save(manifest)

    def _is_asset_current(self, asset: dict, manifest: dict, dest_path: Path) -> bool:
        """
        Проверяет, актуален ли ассет ПЕРЕД скачиванием.
        Возвращает True (пропустить загрузку), если:
          1. Файл есть в манифесте с совпадающим updated_at
          2. И целевой файл физически существует (для прямых .scs/.exe файлов)
             ИЛИ манифест помечает его как "installed" (для архивов)
        """
        name = asset.get("name", "")
        updated_at = asset.get("updated_at", "")
        asset_size = asset.get("size", 0)
        entry = manifest.get(name)

        if not entry:
            return False  # Нет в манифесте — скачиваем

        # Сравниваем дату обновления с GitHub
        if entry.get("updated_at") != updated_at:
            return False  # Обновлено на сервере — скачиваем

        # Если это не архив — проверяем физическое наличие файла
        if not (name.endswith(".zip") or name.endswith(".7z")):
            if not dest_path.exists():
                return False  # Файл удалён — скачиваем
            if dest_path.stat().st_size != asset_size and asset_size > 0:
                return False  # Размер не совпадает — скачиваем

        # Для архивов — доверяем манифесту (installed=True)
        return entry.get("installed", False)

    def _mark_asset_installed(self, manifest: dict, asset: dict,
                                installed_path: Optional[Path] = None) -> dict:
        """
        Помечает ассет как установленный в манифесте.
        Если передан installed_path и это .scs-файл — считает SHA-256 для проверки целостности.
        """
        entry = {
            "updated_at": asset.get("updated_at", ""),
            "size": asset.get("size", 0),
            "installed": True,
            "installed_at": datetime.now().isoformat(),
        }
        # SHA-256 только для одиночных файлов (не для архивов — там много распакованных файлов)
        if installed_path is not None and installed_path.exists() and installed_path.is_file():
            try:
                if installed_path.suffix.lower() in (".scs", ".exe"):
                    entry["sha256"] = sha256_streaming(installed_path)
            except Exception as e:
                logging.error(f"_mark_asset_installed sha256: {e}")
        manifest[asset["name"]] = entry
        return manifest

    # ==========================================
    # --- СИСТЕМА АВТООБНОВЛЕНИЙ ---
    # ==========================================
    def check_program_updates(self, silent=False):
        if not silent:
            self.set_status("Проверка обновлений...")
        threading.Thread(target=self._update_worker, args=(silent,), daemon=True).start()

    def _update_worker(self, silent, retry_count=0):
        try:
            # Используем кэш GitHub (5 мин TTL) — silent-проверки не дёргают API каждый раз
            session = self._get_gh_session()
            try:
                releases = GitHubCache.get_releases(session, AppConfig.PROGRAM_REPO, timeout=15)
                # Берём первый (самый свежий) релиз
                data = releases[0] if releases else {}
            except requests.exceptions.RequestException:
                # Fallback к /releases/latest (если /releases недоступен по правам токена)
                url = f"https://api.github.com/repos/{AppConfig.PROGRAM_REPO}/releases/latest"
                resp = session.get(url, timeout=15)
                resp.raise_for_status()
                data = resp.json()

            latest_version_str = data.get('tag_name', 'v0.0.0')
            latest_version = parse_version(latest_version_str)
            current_version = parse_version(AppConfig.PROGRAM_VERSION)

            if latest_version > current_version:
                release_notes = data.get('body', 'Нет описания изменений.')
                download_url = None

                for asset in data.get('assets', []):
                    if asset['name'].endswith('.exe'):
                        download_url = asset['browser_download_url']
                        break

                if download_url:
                    # Сохраняем инфу об обновлении для показа на главной
                    update_data = {
                        'version': latest_version_str,
                        'notes': release_notes,
                        'url': download_url
                    }
                    try:
                        AppConfig.APPDATA_DIR.mkdir(parents=True, exist_ok=True)
                        (AppConfig.APPDATA_DIR / "pending_program_update.json").write_text(
                            json.dumps(update_data, ensure_ascii=False), encoding="utf-8")
                    except Exception:
                        pass

                    if silent:
                        # При silent-запуске просто обновляем статус
                        self.after(0, lambda: self.set_status(f"Доступно обновление {latest_version_str}"))
                    else:
                        self.after(0, lambda: self.prompt_program_update(latest_version_str, release_notes, download_url))
                else:
                    if not silent:
                        self.after(0, lambda: messagebox.showinfo("Обновление найдено", f"Доступна версия {latest_version_str}, но EXE файл не найден в релизе.\nПеренаправляю на GitHub."))
                        self.after(0, lambda: webbrowser.open(data.get('html_url')))
                    self.after(0, lambda: self.set_status("Система готова"))
            else:
                # Убираем файл pending update если версия актуальна
                try:
                    (AppConfig.APPDATA_DIR / "pending_program_update.json").unlink(missing_ok=True)
                except Exception:
                    pass
                if not silent:
                    self.after(0, lambda: messagebox.showinfo("Обновлений нет", f"У вас установлена самая актуальная версия программы (v{AppConfig.PROGRAM_VERSION})."))
                # Всегда обновляем статус - даже при silent
                self.after(0, lambda: self.set_status("Система готова"))
        except requests.exceptions.HTTPError as http_err:
            status = http_err.response.status_code if http_err.response else 0
            log_error("check_program_updates http", http_err)
            if status == 403 and not silent:
                def _suggest_token():
                    if messagebox.askyesno(
                            "Лимит GitHub API исчерпан",
                            "Превышен лимит запросов к GitHub (60 в час для анонимных).\n\n"
                            "Добавьте свой бесплатный личный токен — лимит вырастет до 5000/час.\n"
                            "Открыть диалог управления токеном?"):
                        self.show_token_dialog()
                self.safe_after(0, _suggest_token)
            elif not silent:
                self.safe_after(0, lambda exc=http_err: messagebox.showerror(
                    "Ошибка сети", f"Не удалось проверить обновления: {exc}"))
            self.safe_after(0, lambda: self.set_status("Сбой проверки обновлений"))
        except (requests.exceptions.Timeout, requests.exceptions.RequestException) as e:
            # Повтор через 2 сек
            if retry_count < 2:
                threading.Thread(target=lambda: self._update_worker(silent, retry_count + 1), daemon=True).start()
            else:
                log_error("check_program_updates", e)
                if not silent:
                    self.safe_after(0, lambda exc=e: messagebox.showerror(
                        "Ошибка сети", f"Не удалось проверить обновления: {exc}"))
                self.safe_after(0, lambda: self.set_status("Сбой проверки обновлений"))
        except Exception as e:
            log_error("check_program_updates", e)
            if not silent:
                self.safe_after(0, lambda exc=e: messagebox.showerror(
                    "Ошибка сети", f"Не удалось проверить обновления: {exc}"))
            self.safe_after(0, lambda: self.set_status("Сбой проверки обновлений"))

    def prompt_program_update(self, new_version, notes, download_url):
        msg = f"Доступна новая версия программы: {new_version}!\n\nЧто нового:\n{notes[:300]}{'...' if len(notes) > 300 else ''}\n\nОбновить сейчас? Программа будет перезапущена."
        if messagebox.askyesno("Доступно обновление!", msg):
            self.set_status("Скачивание обновления...")
            threading.Thread(target=self.perform_auto_update, args=(download_url,), daemon=True).start()

    def perform_auto_update(self, download_url, expected_sha256: Optional[str] = None):
        """
        Новый updater БЕЗ .bat-файла (антивирус перестал ломать обновление).

        Алгоритм:
          1. Скачиваем .exe в pending_update.exe рядом с текущим (с прогрессом).
          2. Считаем SHA-256 на лету. Если задан expected — сверяем; mismatch → удаляем.
          3. Записываем маркер .update_pending с метаданными.
          4. Перезапускаем себя — при старте _apply_pending_update_if_any() запускает
             pending_update.exe в режиме --apply-update --target <старый.exe>.
          5. Новый процесс ждёт освобождения файла, заменяет его и стартует.

        Это полностью устраняет ситуацию «.bat обрезан антивирусом — обновление застряло».
        """
        is_compiled = "__compiled__" in globals() or getattr(sys, 'frozen', False)
        if not is_compiled:
            self.after(0, lambda: messagebox.showinfo(
                "Режим разработчика",
                "Автообновление работает только в скомпилированном EXE.\n"
                "Скачайте обновление вручную с GitHub."))
            self.after(0, lambda: webbrowser.open(
                f"https://github.com/{AppConfig.PROGRAM_REPO}/releases/latest"))
            return

        current_exe = Path(sys.executable)
        pending = current_exe.parent / "pending_update.exe"
        marker = current_exe.parent / ".update_pending"

        try:
            sha = hashlib.sha256()
            downloaded = 0
            total = 0
            session = self._get_gh_session()
            with session.get(download_url, stream=True, timeout=30) as r:
                r.raise_for_status()
                total = int(r.headers.get("Content-Length", 0) or 0)
                with open(pending, "wb") as f:
                    for chunk in r.iter_content(chunk_size=1024 * 256):  # 256 КБ
                        if not chunk:
                            continue
                        f.write(chunk)
                        sha.update(chunk)
                        downloaded += len(chunk)
                        if total > 0:
                            pct = downloaded / total
                            mb_done = downloaded / (1024 * 1024)
                            mb_total = total / (1024 * 1024)
                            self.after(0, self.set_status,
                                       f"Скачивание обновления: {pct*100:.0f}% "
                                       f"({mb_done:.1f}/{mb_total:.1f} МБ)")

            actual_sha = sha.hexdigest()
            if expected_sha256 and actual_sha.lower() != expected_sha256.lower():
                pending.unlink(missing_ok=True)
                raise ValueError(
                    f"SHA-256 не совпадает!\n"
                    f"Ожидался: {expected_sha256}\nПолучен:  {actual_sha}\n"
                    f"Файл удалён в целях безопасности.")

            marker.write_text(json.dumps({
                "current_exe": current_exe.name,
                "pending_exe": pending.name,
                "downloaded_at": datetime.now().isoformat(),
                "sha256": actual_sha,
            }), encoding="utf-8")

            def _confirm_and_restart():
                if messagebox.askyesno(
                        "Готово",
                        "Обновление загружено и проверено по SHA-256.\n\n"
                        "Перезапустить программу для применения?"):
                    # Запускаем себя ещё раз — на старте применится pending update
                    subprocess.Popen([str(current_exe)],
                                     creationflags=subprocess.DETACHED_PROCESS
                                     | subprocess.CREATE_NO_WINDOW)
                    self.destroy()
            self.after(0, _confirm_and_restart)

        except Exception as e:
            log_error("perform_auto_update", e)
            try:
                pending.unlink(missing_ok=True)
            except Exception:
                pass
            self.after(0, lambda exc=e: messagebox.showerror(
                "Ошибка обновления",
                f"Сбой при скачивании или проверке: {exc}"))
            self.after(0, lambda: self.set_status("Сбой автообновления"))

