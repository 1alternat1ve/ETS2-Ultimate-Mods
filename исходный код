    def _build_profile_card(self, parent, profile: dict, idx: int):
        """Карточка профиля: имя, тип, время последней игры, превью."""
        path = str(profile['path'])
        name = profile['name']
        ptype = profile['type']
        is_cloud = ptype == 'Steam Cloud'
        dt = datetime.fromtimestamp(profile['time'])
        days_ago = (datetime.now() - dt).days
        ago_text = ("сегодня" if days_ago == 0
                    else "вчера" if days_ago == 1
                    else f"{days_ago} дней назад"
                    if days_ago < 30 else dt.strftime("%d.%m.%Y"))

        col = idx % 2
        row = idx // 2

        card = ctk.CTkFrame(
            parent, fg_color=UIConfig.COLOR_CARD_BG,
            corner_radius=UIConfig.CORNER_RADIUS_CARD,
            border_width=1, border_color=UIConfig.COLOR_BORDER,
            cursor="hand2")
        card.grid(row=row, column=col, sticky="nsew", padx=6, pady=6)

        inner = ctk.CTkFrame(card, fg_color="transparent")
        inner.pack(fill="both", expand=True, padx=18, pady=16)

        # Заголовок: emoji-аватар + имя + тип
        head = ctk.CTkFrame(inner, fg_color="transparent")
        head.pack(fill="x")

        # Аватар: эмодзи на основе хеша имени
        avatars = ["🚛", "🏎", "🚀", "🎩", "🦊", "🐺", "🦅", "🐉",
                    "⚡", "🔥", "💎", "🌟"]
        avatar = avatars[hash(name) % len(avatars)]
        ctk.CTkLabel(
            head, text=avatar, font=("Segoe UI", 32),
            fg_color=UIConfig.COLOR_PRO_BG,
            corner_radius=UIConfig.CORNER_RADIUS_PILL,
            width=64, height=64).pack(side="left", padx=(0, 14))

        meta = ctk.CTkFrame(head, fg_color="transparent")
        meta.pack(side="left", fill="x", expand=True, anchor="w")
        ctk.CTkLabel(meta, text=name,
                     font=("Segoe UI Black", 18),
                     text_color=UIConfig.COLOR_TEXT_MAIN,
                     anchor="w").pack(anchor="w")

        type_pill_color = (UIConfig.COLOR_INFO_TEXT if is_cloud
                            else UIConfig.COLOR_SUCCESS)
        type_pill_bg = (UIConfig.COLOR_INFO_BG if is_cloud
                        else UIConfig.COLOR_CARD_BG_ALT)
        type_text = ("☁ Steam Cloud" if is_cloud else "💻 Локальный")
        ctk.CTkLabel(meta, text=f"  {type_text}  ",
                     font=UIConfig.FONT_TINY,
                     text_color=type_pill_color,
                     fg_color=type_pill_bg,
                     corner_radius=UIConfig.CORNER_RADIUS_PILL,
                     padx=8, pady=2).pack(anchor="w", pady=(4, 0))

        # Метрики: последняя игра + (опционально) деньги/опыт из profile.sii
        info_row = ctk.CTkFrame(inner, fg_color="transparent")
        info_row.pack(fill="x", pady=(14, 0))

        self._profile_metric(info_row, "Активен",   ago_text,
                              UIConfig.COLOR_ACCENT)

        # Пытаемся вытащить money/xp из profile.sii (быстро, не критично)
        money, xp = self._extract_profile_stats(profile['path'])
        if money is not None:
            self._profile_metric(info_row, "Баланс",
                                  f"{money:,} €".replace(",", " "),
                                  UIConfig.COLOR_SUCCESS)
