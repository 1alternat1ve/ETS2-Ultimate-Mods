# --- УТИЛИТЫ-АНИМАЦИИ (stagger, smooth-progress, pop-in) ---
# ==========================================
class Anim:
    """Набор анимационных хелперов поверх tkinter."""

    @staticmethod
    def smooth_progress_to(progressbar, target: float,
                            duration_ms: int = 280,
                            steps: int = 14,
                            root: Optional[ctk.CTk] = None):
        """
        Плавно перегоняет CTkProgressBar к target (0..1) с ease-out cubic.
        Раньше bar дёргался на каждый chunk — теперь плавно «догоняет» цель.
        """
        try:
            current = float(progressbar.get())
            target = max(0.0, min(1.0, float(target)))
            delta = target - current
            if abs(delta) < 0.01:
                progressbar.set(target)
                return
            interval = max(8, duration_ms // steps)
            r = root or progressbar.winfo_toplevel()

            def _step(i: int):
                if i > steps:
                    try:
                        progressbar.set(target)
                    except Exception:
                        pass
                    return
                t = i / steps
                eased = 1 - (1 - t) ** 3
                val = current + delta * eased
                try:
                    progressbar.set(val)
                except Exception:
                    return
                r.after(interval, lambda: _step(i + 1))

            _step(1)
        except Exception:
            pass

    @staticmethod
    def stagger_fade_in(widgets: List, delay_ms: int = 40,
                         root: Optional[ctk.CTk] = None):
        """
        По очереди «прокидывает» через каждый виджет короткий highlight-эффект:
        изначально border_color яркий, плавно затухает за 200мс.
        Создаёт ощущение последовательного появления карточек.
        """
        if not widgets:
            return
        r = root or widgets[0].winfo_toplevel()
        try:
            mode_idx = 0 if ctk.get_appearance_mode() == "Light" else 1
            highlight = UIConfig.COLOR_ACCENT[mode_idx]
            normal = UIConfig.COLOR_BORDER[mode_idx]
        except Exception:
            return

        for idx, w in enumerate(widgets):
            r.after(idx * delay_ms,
                     lambda ww=w: Anim._flash_border(ww, highlight, normal, r))

    @staticmethod
    def _flash_border(widget, highlight: str, normal: str,
                       root, duration_ms: int = 220, steps: int = 8):
        """Пыхает border'ом виджета: highlight → normal."""
        try:
            widget.configure(border_color=highlight)
        except Exception:
            return
        interval = max(8, duration_ms // steps)

        def _step(i: int):
            if i >= steps:
                try:
                    widget.configure(border_color=normal)
                except Exception:
                    pass
                return
            root.after(interval, lambda: _step(i + 1))

        root.after(interval, lambda: _step(1))

    @staticmethod
    def pulse(widget, color: str,
                duration_ms: int = 400,
                root: Optional[ctk.CTk] = None):
        """Один импульс на виджет: яркий border на короткое время."""
        if widget is None:
            return
        r = root or widget.winfo_toplevel()
        try:
            old = widget.cget("border_color")
        except Exception:
            old = None
        try:
            widget.configure(border_color=color)
        except Exception:
            return

        def _back():
            try:
                if old is not None:
                    widget.configure(border_color=old)
            except Exception:
                pass

        r.after(duration_ms, _back)

    @staticmethod
    def _hex_to_rgb(hex_str: str) -> Tuple[int, int, int]:
        """#RRGGBB → (R, G, B)."""
        h = hex_str.lstrip("#")
        if len(h) == 3:
            h = "".join(c * 2 for c in h)
        try:
            return (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16))
        except Exception:
            return (0, 0, 0)

    @staticmethod
    def _rgb_to_hex(rgb: Tuple[int, int, int]) -> str:
        return "#{:02X}{:02X}{:02X}".format(
            max(0, min(255, rgb[0])),
            max(0, min(255, rgb[1])),
            max(0, min(255, rgb[2])))

    @staticmethod
    def _lerp_color(c1: str, c2: str, t: float) -> str:
        """Линейная интерполяция между двумя HEX-цветами. t ∈ [0..1]."""
        a = Anim._hex_to_rgb(c1)
        b = Anim._hex_to_rgb(c2)
        mixed = tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))
        return Anim._rgb_to_hex(mixed)

    @staticmethod
    def breathing_glow(widget, color_low: str, color_high: str,
                         period_ms: int = 1400, steps: int = 28,
                         token_attr: str = "_breathing_token",
                         root: Optional[ctk.CTk] = None):
        """
        «Дышащая» подсветка border'а виджета.
        Border плавно колеблется между color_low ↔ color_high по синусоиде
        в течение period_ms, и так до тех пор, пока на виджете не сменится
        атрибут token_attr (тогда анимация останавливается).

        Использование:
          Anim.breathing_glow(tile, "#3B57E8", "#9C7CFF", period_ms=1400)
          # ... потом, чтобы остановить:
          Anim.stop_breathing(tile)
        """
        if widget is None:
            return
        r = root or widget.winfo_toplevel()
        # Уникальный токен для этого запуска
        import uuid
        token = uuid.uuid4().hex
        try:
            setattr(widget, token_attr, token)
        except Exception:
            return

        interval = max(8, period_ms // steps)

        def _step(i: int):
            # Если токен изменился — кто-то остановил эту анимацию
            try:
                if getattr(widget, token_attr, None) != token:
                    return
                if not widget.winfo_exists():
                    return
            except Exception:
                return
            # Синусоида: 0..1..0 за period_ms
            import math
            phase = (i % steps) / steps
            t = (1 - math.cos(phase * 2 * math.pi)) / 2  # smooth 0→1→0
            color = Anim._lerp_color(color_low, color_high, t)
            try:
                widget.configure(border_color=color)
            except Exception:
                return
            r.after(interval, lambda: _step(i + 1))

        _step(0)

    @staticmethod
    def stop_breathing(widget, token_attr: str = "_breathing_token",
                        restore_color: Optional[str] = None):
        """Останавливает breathing_glow для виджета. Опционально восстанавливает цвет."""
        if widget is None:
            return
        try:
            # Сменив токен, мы заставляем активный _step выйти на следующем тике
            setattr(widget, token_attr, None)
            if restore_color is not None:
                widget.configure(border_color=restore_color)
        except Exception:
            pass


