# --- TOAST-УВЕДОМЛЕНИЯ (неблокирующие) ---
# ==========================================
class ToastManager:
    """Лёгкие неблокирующие уведомления в правом-нижнем углу окна."""
    LEVELS = {
        "info":    ("ℹ️", ("#2563EB", "#3B82F6")),
        "success": ("✅", ("#059669", "#2EA043")),
        "warn":    ("⚠️", ("#D97706", "#D29922")),
        "error":   ("❌", ("#DC2626", "#DA3633")),
    }

    def __init__(self, root: ctk.CTk):
        self.root = root
        self._stack: List[ctk.CTkFrame] = []

    def show(self, text: str, level: str = "info", duration_ms: int = 3500):
        icon, color = self.LEVELS.get(level, self.LEVELS["info"])
        try:
            toast = ctk.CTkFrame(self.root, fg_color=("#FFFFFF", "#161B22"),
                                 border_width=2, border_color=color, corner_radius=12)
            ctk.CTkLabel(toast, text=f"{icon}  {text}",
                         font=("Segoe UI", 13, "bold"),
                         text_color=("#111827", "#E6EDF3"),
                         wraplength=380, justify="left").pack(padx=18, pady=12)
            idx = len(self._stack)
            toast.place(relx=1.0, rely=1.0, anchor="se", x=-20, y=-(20 + idx * 70))
            self._stack.append(toast)
            self.root.after(duration_ms, lambda t=toast: self._close(t))
        except Exception as e:
            logging.error(f"ToastManager.show: {e}")

    def _close(self, toast):
        try:
            if toast in self._stack:
                self._stack.remove(toast)
            toast.destroy()
            # Сдвигаем оставшиеся
            for i, t in enumerate(self._stack):
                t.place_configure(y=-(20 + i * 70))
        except Exception:
            pass


