class ManifestCache:
    """
    Кэш installed_manifest.json в памяти. Инвалидируется по mtime файла.
    Раньше манифест читался с диска для каждого ассета — теперь один раз за сессию.
    """
    _data: Optional[dict] = None
    _mtime: float = 0.0

    @classmethod
    def get(cls) -> dict:
        try:
            if not AppConfig.MANIFEST_FILE.exists():
                cls._data = {}
                cls._mtime = 0.0
                return cls._data
            mtime = AppConfig.MANIFEST_FILE.stat().st_mtime
            if cls._data is not None and mtime == cls._mtime:
                return cls._data
            cls._data = json.loads(
                AppConfig.MANIFEST_FILE.read_text(encoding="utf-8"))
            cls._mtime = mtime
            return cls._data
        except Exception as e:
            logging.error(f"ManifestCache.get: {e}")
            return cls._data or {}

    @classmethod
    def save(cls, data: dict):
        try:
            AppConfig.MANIFEST_FILE.parent.mkdir(parents=True, exist_ok=True)
            tmp = AppConfig.MANIFEST_FILE.with_suffix(".json.tmp")
            tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False),
                           encoding="utf-8")
            os.replace(tmp, AppConfig.MANIFEST_FILE)
            cls._data = data
            cls._mtime = AppConfig.MANIFEST_FILE.stat().st_mtime
        except Exception as e:
            logging.error(f"ManifestCache.save: {e}")

    @classmethod
    def invalidate(cls):
        cls._data = None
        cls._mtime = 0.0


class GitHubCache:
    """
    Кэш ответов GitHub API.
    TTL автоматически адаптивный:
      • С токеном (5000 req/h)   → 5 минут
      • Без токена (60 req/h)     → 15 минут (бережём лимит)

    Это позволяет раздавать EXE без токена — пользователи не упрутся в лимит,
    потому что один список релизов кэшируется на 15 мин.
    """
    _cache: Dict[str, Tuple[float, list]] = {}
    TTL_AUTHENTICATED = 300.0   # 5 минут
    TTL_ANONYMOUS = 900.0       # 15 минут

    @classmethod
    def _ttl(cls) -> float:
        # Если есть токен — короткий TTL, иначе — длинный
        return cls.TTL_AUTHENTICATED if SecureConfig.get_github_token() else cls.TTL_ANONYMOUS

    @classmethod
    def get_releases(cls, session: requests.Session, repo: str,
                     force_refresh: bool = False, timeout: float = 15.0) -> list:
        key = f"releases:{repo}"
        now = time.time()
        ttl = cls._ttl()
        if not force_refresh and key in cls._cache:
            ts, data = cls._cache[key]
            if now - ts < ttl:
                return data
        url = f"https://api.github.com/repos/{repo}/releases"
        resp = session.get(url, timeout=timeout)
        resp.raise_for_status()
        data = resp.json()
        if isinstance(data, dict):
            data = [data]
        cls._cache[key] = (now, data)
        return data

    @classmethod
    def invalidate(cls, repo: Optional[str] = None):
        if repo:
            cls._cache.pop(f"releases:{repo}", None)
        else:
            cls._cache.clear()


class UiBus:
    """
    Поток-безопасная шина для UI-обновлений.
    Рабочие потоки кладут события в очередь, главный поток их обрабатывает.
    Снижает количество self.after(0, ...) и упрощает логику.
    """
    def __init__(self, root: ctk.CTk, poll_ms: int = 50):
        self.root = root
        self.q: queue.Queue = queue.Queue()
        self._poll_ms = poll_ms
        self._handlers: Dict[str, Callable[[dict], None]] = {}
        self._running = True
        self.root.after(self._poll_ms, self._poll)

    def on(self, kind: str, handler: Callable[[dict], None]):
        self._handlers[kind] = handler

    def emit(self, kind: str, **payload):
        self.q.put((kind, payload))

    def stop(self):
        self._running = False

    def _poll(self):
        if not self._running:
            return
        try:
            while True:
                kind, payload = self.q.get_nowait()
                handler = self._handlers.get(kind)
                if handler:
                    try:
                        handler(payload)
                    except Exception as e:
                        logging.error(f"UiBus handler '{kind}': {e}")
        except queue.Empty:
            pass
        try:
            self.root.after(self._poll_ms, self._poll)
        except Exception:
            pass


