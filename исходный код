# --- HARDWARE DETECTOR: определение железа + рекомендации ---
# ==========================================
@dataclass
class HardwareInfo:
    cpu_name: str = ""
    cpu_cores: int = 0
    gpu_name: str = ""
    gpu_vram_mb: int = 0
    ram_total_gb: float = 0.0
    tier: str = "unknown"   # "low" | "mid" | "high" | "ultra"


class HardwareDetector:
    """
    Получает информацию о железе через wmic (быстро, без зависимостей).
    Классифицирует по тиру и подбирает оптимальный preset для ETS2.
    """

    @classmethod
    def detect(cls) -> HardwareInfo:
        info = HardwareInfo()

        # === CPU + GPU + RAM через PowerShell Get-CimInstance ===
        # wmic deprecated в Windows 11 22H2+ и УДАЛЁН в новых сборках.
        # PowerShell Get-CimInstance — современная замена, работает всегда.
        # Один subprocess вместо трёх → быстрее старт.
        ps_script = (
            "$cpu = Get-CimInstance Win32_Processor | "
            "Select-Object -First 1 Name,NumberOfCores; "
            "$gpu = Get-CimInstance Win32_VideoController | "
            "Sort-Object AdapterRAM -Descending | "
            "Select-Object -First 1 Name,AdapterRAM; "
            "$ram = (Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory; "
            "Write-Output \"CPU_NAME=$($cpu.Name)\"; "
            "Write-Output \"CPU_CORES=$($cpu.NumberOfCores)\"; "
            "Write-Output \"GPU_NAME=$($gpu.Name)\"; "
            "Write-Output \"GPU_VRAM=$($gpu.AdapterRAM)\"; "
            "Write-Output \"RAM_BYTES=$ram\""
        )

        try:
            out = run_hidden_process([
                "powershell", "-NoProfile", "-NonInteractive",
                "-ExecutionPolicy", "Bypass", "-Command", ps_script
            ])
            text = out.stdout if hasattr(out, "stdout") else ""
            for line in text.splitlines():
                line = line.strip()
                if "=" not in line:
                    continue
                key, _, val = line.partition("=")
                val = val.strip()
                try:
                    if key == "CPU_NAME":
                        info.cpu_name = val
                    elif key == "CPU_CORES":
                        info.cpu_cores = int(val) if val else 0
                    elif key == "GPU_NAME":
                        info.gpu_name = val
                    elif key == "GPU_VRAM":
                        # AdapterRAM в байтах, ограничен 4 ГБ для 32-bit
                        # API; современные карты могут показать мусор.
                        vram_b = int(val) if val.isdigit() else 0
                        info.gpu_vram_mb = vram_b // (1024 * 1024)
                    elif key == "RAM_BYTES":
                        ram_b = int(val) if val.isdigit() else 0
                        if ram_b > 0:
                            info.ram_total_gb = ram_b / (1024 ** 3)
                except (ValueError, AttributeError):
                    pass
        except Exception as e:
            logging.error(f"HardwareDetector.detect powershell: {e}")

        # === Fallback на psutil для RAM, если PowerShell не сработал ===
        if info.ram_total_gb == 0.0 and _PSUTIL_OK:
            try:
                info.ram_total_gb = psutil.virtual_memory().total / (1024 ** 3)
            except Exception:
                pass

        # === Fallback на ctypes для CPU/GPU если PowerShell вообще упал ===
        if not info.cpu_name:
            try:
                # Имя процессора через регистр Windows
                with winreg.OpenKey(
                        winreg.HKEY_LOCAL_MACHINE,
                        r"HARDWARE\DESCRIPTION\System\CentralProcessor\0") as k:
                    info.cpu_name = winreg.QueryValueEx(
                        k, "ProcessorNameString")[0].strip()
            except Exception:
                pass

        if not info.gpu_name:
            try:
                # GPU через DirectX EnumDisplayDevices
                buf = ctypes.create_unicode_buffer(256)
                user32 = ctypes.windll.user32
                # EnumDisplayDevices
                class DISPLAY_DEVICEW(ctypes.Structure):
                    _fields_ = [
                        ("cb", ctypes.c_ulong),
                        ("DeviceName", ctypes.c_wchar * 32),
                        ("DeviceString", ctypes.c_wchar * 128),
                        ("StateFlags", ctypes.c_ulong),
                        ("DeviceID", ctypes.c_wchar * 128),
                        ("DeviceKey", ctypes.c_wchar * 128),
                    ]
                dd = DISPLAY_DEVICEW()
                dd.cb = ctypes.sizeof(DISPLAY_DEVICEW)
                if user32.EnumDisplayDevicesW(None, 0, ctypes.byref(dd), 0):
                    info.gpu_name = dd.DeviceString
            except Exception:
                pass

        info.tier = cls._classify(info)
        return info

    @classmethod
    def _classify(cls, info: HardwareInfo) -> str:
        """Простая классификация: смотрим на VRAM и RAM как главные факторы."""
        # AdapterRAM в Windows для VRAM > 4GB иногда возвращает мусор (32-bit overflow)
        # Поэтому смотрим больше на RAM + название GPU
        gpu_lc = info.gpu_name.lower()

        # Топ-карты — независимо от VRAM
        if any(k in gpu_lc for k in [
                "rtx 40", "rtx 50", "rtx 4090", "rtx 4080", "rtx 4070",
                "rtx 5090", "rtx 5080", "radeon rx 7900", "radeon rx 7800",
                "radeon rx 7700"]):
            return "ultra"
        # Мощные карты
        if any(k in gpu_lc for k in [
                "rtx 30", "rtx 3060", "rtx 3070", "rtx 3080", "rtx 3090",
                "rtx 4060", "rtx 5060",
                "radeon rx 6700", "radeon rx 6800", "radeon rx 6900"]):
            return "high"
        # Среднячок
        if any(k in gpu_lc for k in [
                "gtx 16", "gtx 1660", "gtx 1650", "rtx 20", "rtx 2060",
                "radeon rx 5", "radeon rx 6500", "radeon rx 6600"]):
            return "mid"
        # Старые / интегрированные
        if any(k in gpu_lc for k in [
                "intel hd", "intel uhd", "iris", "gtx 10", "gtx 1050",
                "gtx 9", "radeon vega", "radeon r5", "radeon r7"]):
            return "low"

        # Если GPU не определился — судим по RAM
        if info.ram_total_gb >= 32:
            return "high"
        if info.ram_total_gb >= 16:
            return "mid"
        if info.ram_total_gb >= 8:
            return "low"
        return "unknown"

    # Пресеты ETS2 по тирам
    PRESETS = {
        "low": {
            "name": "Low / Performance",
            "description":
                "Снижаем нагрузку на старое железо. FPS важнее картинки.",
