            self.settings["appearance"] = "Light"
            self.theme_switch.configure(text="☀️ Светлая тема")
        self._update_mode_idx()
        self.save_settings()

    # ==========================================
    # --- GITHUB SESSION С ТОКЕНОМ (RATE LIMIT FIX) ---
    # ==========================================
    def _get_gh_session(self) -> requests.Session:
        """
        Сессия requests для GitHub API.
        Токен берётся из SecureConfig (DPAPI) или переменной окружения ETS2_GITHUB_TOKEN.
        Если токена нет — запросы анонимные (лимит 60 req/h).
        """
        session = requests.Session()
        headers = {
            "User-Agent": f"ETS2-Nexus/{AppConfig.PROGRAM_VERSION}",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
        }
        token = SecureConfig.get_github_token()
        if token:
            headers["Authorization"] = f"Bearer {token}"
        session.headers.update(headers)
        return session

