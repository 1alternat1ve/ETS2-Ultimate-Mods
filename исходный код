# --- BACKGROUND MOD UPDATER: фоновый поиск обновлений модов ---
# ==========================================
class BackgroundModUpdater:
    """
    Фоновый процесс который раз в 6 часов:
      1. Запрашивает текущий релиз с GitHub
      2. Сравнивает updated_at каждого ассета с локальным манифестом
      3. Если что-то изменилось — записывает в pending_mod_updates.json
         (но не скачивает ничего автоматически — это делает sync_engine)

    При открытии Mission Control / страницы установки программа читает
    pending_mod_updates.json и показывает toast «доступно N обновлений».

    Безопасно: ничего не пишет в game.* папки, только в Nexus-state.
    """

    PENDING_FILE = AppConfig.APPDATA_DIR / "pending_mod_updates.json"
    CHECK_INTERVAL_S = 6 * 3600  # 6 часов
    MIN_INTERVAL_S = 30 * 60     # минимум 30 мин между проверками

    def __init__(self, root: ctk.CTk, gh_session_factory: Callable):
        self.root = root
        self._gh_session_factory = gh_session_factory
        self._running = True
        self._last_check_ts = 0.0

    def start(self):
        """Запускает фоновый thread с периодическими проверками."""
        threading.Thread(target=self._loop, daemon=True).start()

    def stop(self):
        self._running = False

    def _loop(self):
        # Первая проверка через 60 сек после старта программы
        # (чтобы не нагружать сразу)
        time.sleep(60)
        while self._running:
            try:
                self._check_once()
            except Exception as e:
                logging.error(f"BackgroundModUpdater._check_once: {e}")
            # Спим 6 часов с проверкой флага каждые 60 сек
            for _ in range(self.CHECK_INTERVAL_S // 60):
                if not self._running:
                    return
                time.sleep(60)

    def _check_once(self):
        """Сравнивает GitHub-манифест с локальным."""
        now = time.time()
        if now - self._last_check_ts < self.MIN_INTERVAL_S:
            return
        self._last_check_ts = now

        session = self._gh_session_factory()
        try:
            url = AppConfig.GITHUB_API_URL.replace("/latest", "")
            resp = session.get(url, timeout=10)
            resp.raise_for_status()
            releases = resp.json()
            if isinstance(releases, dict):
                releases = [releases]
        except Exception as e:
            logging.error(f"BackgroundModUpdater fetch: {e}")
            return

        # Собираем актуальный манифест с GitHub
        gh_assets: Dict[str, dict] = {}
        for release in releases:
            for asset in release.get("assets", []):
                name = asset.get("name", "")
                if name.endswith(".exe") and name != "SII_Decrypt.exe":
                    continue
                if name not in gh_assets:
                    gh_assets[name] = {
                        "size": asset.get("size", 0),
                        "updated_at": asset.get("updated_at", ""),
                        "download_url": asset.get("browser_download_url", ""),
                    }

        # Сравниваем с локальным манифестом
        local = ManifestCache.get()
        pending = []
        for name, gh in gh_assets.items():
            local_entry = local.get(name)
            if not local_entry or not local_entry.get("installed"):
                continue  # этот файл вообще не устанавливался
            local_at = local_entry.get("updated_at", "")
            if local_at and gh["updated_at"] and gh["updated_at"] > local_at:
                pending.append({
                    "name": name,
                    "old_at": local_at,
                    "new_at": gh["updated_at"],
                    "size": gh["size"],
                })

        # Сохраняем результат
        try:
            AppConfig.APPDATA_DIR.mkdir(parents=True, exist_ok=True)
            payload = {
                "checked_at": datetime.now().isoformat(),
                "updates": pending,
            }
            self.PENDING_FILE.write_text(
                json.dumps(payload, indent=2, ensure_ascii=False),
                encoding="utf-8")
        except Exception as e:
            logging.error(f"BackgroundModUpdater save: {e}")

        # Если есть обновления — toast
        if pending:
            try:
                self.root.after(0, lambda: self._notify(pending))
            except Exception:
                pass

    def _notify(self, pending: list):
        toast = getattr(self.root, "toast", None)
        if toast:
            count = len(pending)
            word = "обновление" if count == 1 else "обновлений"
            if 2 <= count % 10 <= 4 and not (12 <= count % 100 <= 14):
                word = "обновления"
            toast.show(
                f"📦  Доступно {count} {word} модов · "
                f"запустите «Установка»",
                "info", duration_ms=6000)

    @classmethod
    def get_pending_count(cls) -> int:
        """Возвращает количество pending updates из файла. 0 если файла нет."""
        try:
            if not cls.PENDING_FILE.exists():
                return 0
            data = json.loads(cls.PENDING_FILE.read_text(encoding="utf-8"))
            return len(data.get("updates", []))
        except Exception:
            return 0

    @classmethod
    def clear_pending(cls):
        """Удаляет файл pending — после применения обновлений."""
        try:
            cls.PENDING_FILE.unlink(missing_ok=True)
        except Exception:
            pass


