    def perform_restore(self, zip_path: Path):
        profiles_dir = get_profiles_dir()
        self.set_status("Восстановление из резервной копии...")
        try:
            self.create_backup(silent=True)
            
            if profiles_dir.exists():
                shutil.rmtree(profiles_dir)
            profiles_dir.mkdir(parents=True, exist_ok=True)
            
            with zipfile.ZipFile(zip_path, 'r') as zip_ref:
                zip_ref.extractall(profiles_dir)
                
            messagebox.showinfo("Успех", "Резервная копия успешно восстановлена.")
            self.show_tools()
        except Exception as e:
            log_error("perform_restore", e)
            messagebox.showerror("Сбой восстановления", f"Ошибка при распаковке архива:\n{e}")
        finally:
            self.set_status("Ожидание действий")

