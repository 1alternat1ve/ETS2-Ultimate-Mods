        rec_card = ctk.CTkFrame(
            self._auto_tune_result_frame,
            fg_color=UIConfig.COLOR_CARD_BG,
            corner_radius=UIConfig.CORNER_RADIUS_CARD,
            border_width=2, border_color=tier_color)
