    def get_missing_dlcs(self) -> List[str]:
        """Проверяет отсутствующие DLC с учетом нескольких путей к игре."""
        all_paths = [self.game_path] + [p for p in self.find_all_game_paths() if p != self.game_path]
        missing = []
        for dlc_file, dlc_name in AppConfig.REQUIRED_DLCS.items():
