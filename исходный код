        log_path = get_my_documents() / "Euro Truck Simulator 2" / "game.log.txt"

        if not log_path.exists():
            self.show_empty_state(self.main_content, "📄", "Журнал недоступен", "Файл лога будет создан игрой после первого запуска.", "Запустить игру", self.launch_game)
            return

        smart_frame = ctk.CTkFrame(self.main_content, fg_color=UIConfig.COLOR_INFO_BG, corner_radius=UIConfig.CORNER_RADIUS_CARD)
        smart_frame.pack(fill="x", pady=(0, 15))
        
        top_bar = ctk.CTkFrame(smart_frame, fg_color="transparent")
        top_bar.pack(fill="x", padx=20, pady=(15, 5))
        ctk.CTkLabel(top_bar, text="🧠 Диагностический отчет:", font=("Segoe UI", 16, "bold"), text_color=UIConfig.COLOR_INFO_TEXT).pack(side="left")
        
        self.google_btn = ctk.CTkButton(top_bar, text="🔍 Искать решение в сети", width=180, fg_color=UIConfig.COLOR_INFO_TEXT, hover_color="#2563EB", corner_radius=UIConfig.CORNER_RADIUS_BTN, font=("Segoe UI", 12, "bold"))
        self.google_btn.pack(side="right")
        self.google_btn.pack_forget()

        smart_result_label = ctk.CTkLabel(smart_frame, text="Анализ данных...", font=UIConfig.FONT_MAIN, text_color=UIConfig.COLOR_TEXT_MAIN, justify="left", wraplength=700)
        smart_result_label.pack(pady=(0, 15), padx=20, anchor="w")

        btn_frame = ctk.CTkFrame(self.main_content, fg_color="transparent")
        btn_frame.pack(fill="x", pady=(0, 10))
        
        ctk.CTkButton(btn_frame, text="📂 Открыть исходник лога", command=lambda: os.startfile(log_path), fg_color=UIConfig.COLOR_BTN_GRAY, hover_color=UIConfig.COLOR_BTN_GRAY_HOVER, text_color=UIConfig.COLOR_TEXT_MAIN, corner_radius=UIConfig.CORNER_RADIUS_BTN, height=35).pack(side="right")
        ctk.CTkButton(btn_frame, text="📋 Скопировать лог", command=lambda: [self.clipboard_clear(), self.clipboard_append(log_box.get("1.0", "end")), messagebox.showinfo("Готово", "Лог скопирован в буфер обмена!")], fg_color=UIConfig.COLOR_ACCENT, hover_color=UIConfig.COLOR_ACCENT_HOVER, corner_radius=UIConfig.CORNER_RADIUS_BTN, height=35).pack(side="right", padx=10)

        log_box = ctk.CTkTextbox(self.main_content, font=UIConfig.FONT_LOG, fg_color=UIConfig.COLOR_LOG_BG, text_color=UIConfig.COLOR_TEXT_MAIN, wrap="none")
        log_box.pack(fill="both", expand=True, pady=0)

        mode_idx = 0 if self.settings.get("appearance") == "Light" else 1
        log_box.tag_config("error", foreground=UIConfig.COLOR_DANGER[mode_idx])
        log_box.tag_config("warn", foreground=UIConfig.COLOR_WARNING[mode_idx])
        log_box.tag_config("time", foreground=UIConfig.COLOR_ACCENT[mode_idx])

        # === Фильтр по уровням логов ===
        # Состояние сохраняется в self._log_filter_state
        if not hasattr(self, "_log_filter_state"):
            self._log_filter_state = {"error": True, "warn": True, "info": True}

        filter_frame = ctk.CTkFrame(self.main_content, fg_color="transparent")
        filter_frame.pack(fill="x", pady=(0, 8))
        ctk.CTkLabel(filter_frame, text="Показывать:",
                     font=("Segoe UI", 12, "bold"),
                     text_color=UIConfig.COLOR_TEXT_MUTED).pack(side="left", padx=(0, 8))

        filter_vars: Dict[str, ctk.BooleanVar] = {}
        for label, key, color in [
            ("🔴 Errors", "error", UIConfig.COLOR_DANGER),
            ("🟡 Warnings", "warn", UIConfig.COLOR_WARNING),
            ("🔵 Info", "info", UIConfig.COLOR_ACCENT),
        ]:
            v = ctk.BooleanVar(value=self._log_filter_state.get(key, True))
            filter_vars[key] = v
            ctk.CTkCheckBox(filter_frame, text=label, variable=v,
                            text_color=color, font=("Segoe UI", 12, "bold"),
                            command=lambda k=key, vv=v: self._on_log_filter_change(k, vv)
                            ).pack(side="left", padx=10)

        smart_analysis = set()
        search_query = ""

        # tail_file: вместо чтения 200 МБ лога целиком — берём последние 5 МБ
        try:
            content = tail_file(log_path, max_bytes=5 * 1024 * 1024)
            lines = content.splitlines(keepends=True)
            for line in lines[-2000:]:
                line_lower = line.lower()
                if "<ERROR>" in line:
                    if not self._log_filter_state.get("error", True):
                        continue
                    log_box.insert("end", line, "error")
                    if "dx11" in line_lower or "d3d11" in line_lower or "failed to allocate" in line_lower or "dxgi" in line_lower:
                        smart_analysis.add("🚨 Внимание: Зафиксирован критический сбой графики (DirectX 11/Память). Рекомендуется обновить драйвер видеокарты или снизить 'Масштаб' в настройках игры.")
                        search_query = "ETS2 crash dx11 d3d11 error solution"
                    elif "d3d11: failed to create texture" in line_lower:
                        smart_analysis.add("🛑 Критично: Видеокарте не хватает VRAM для загрузки текстур. Снизьте настройки графики.")
                    elif "taa" in line_lower and "error" in line_lower:
                        smart_analysis.add("🛑 Критично: Сбой нового алгоритма сглаживания TAA. Попробуйте отключить масштабирование или обновить драйвер видеокарты.")
                    elif "fs" in line_lower and "failed to open" in line_lower:
                        smart_analysis.add("⚠️ Внимание: Движок не может прочитать файлы мода или DLC. Убедитесь в их целостности и что они не заблокированы антивирусом.")
                        search_query = "ETS2 failed to open file fs error"
                    elif "unit" in line_lower and "file" in line_lower:
                        smart_analysis.add("🛑 Критично: Ошибка парсинга файлов (unit/file). Скорее всего, один из ваших модов сломан или недокачан.")
                    elif "accessory" in line_lower and "missing" in line_lower:
                        smart_analysis.add("⚠️ Внимание: Игра жалуется на отсутствующие детали (accessories). Вы продали грузовик перед удалением мода на него? Если нет — это может привести к вылету.")
                    elif "hashfs" in line_lower and "unsupported" in line_lower:
                        smart_analysis.add("🛑 Критично: Один из ваших модов не поддерживается текущей версией игры (ошибка hashfs). Проверьте версию мода.")
                    elif "out of memory" in line_lower or "bad allocation" in line_lower:
                        smart_analysis.add("🛑 Критично: Игре не хватает памяти! Срочно добавьте параметры оптимизации RAM во вкладке 'Параметры'.")
                        search_query = "ETS2 out of memory bad allocation"
                    elif "corrupt" in line_lower:
                        smart_analysis.add("⚠️ Внимание: Файл сохранения поврежден. Зайдите в 'Инструменты' -> 'Менеджер восстановления'.")
                        search_query = "ETS2 corrupted save file fix"
                    elif "physics" in line_lower:
                        smart_analysis.add("⚠️ Внимание: Конфликт физики грузовика. Вероятно, вы используете устаревший мод на физику.")
                        search_query = "ETS2 physics error crash"
                    elif "game version mismatch" in line_lower or "version mismatch" in line_lower:
                        smart_analysis.add("🛑 Критично: Вы используете сохранение или мод, созданный для другой версии игры! Убедитесь, что версия игры совпадает с требованиями модов.")
                    elif "plugin" in line_lower or "telemetry" in line_lower:
                        smart_analysis.add("🛑 Критично: Сбой стороннего плагина (Telemetry/TruckersMP). Зайдите в 'Оптимизация' и сбросьте плагины.")
                    elif "promods" in line_lower and "def" in line_lower:
                        smart_analysis.add("🛑 Критично: Отсутствует или поврежден файл 'Def' от карты ProMods. Сгенерируйте его заново на сайте разработчика мода.")
                    elif "traffic" in line_lower and "invalid" in line_lower:
                        smart_analysis.add("⚠️ Внимание: Сбой в генерации трафика. Скорее всего конфликтуют моды на плотность или модели авто.")
                    elif ("dependency" in line_lower and "missing" in line_lower) or "incompatible" in line_lower:
                        smart_analysis.add("🛑 Критично: Зафиксировано отсутствие обязательных модулей (аддонов) для ваших модов. Проверьте порядок загрузки и наличие всех файлов мода.")
                        search_query = "ETS2 mod dependency missing"
                    elif "fmod" in line_lower:
                        smart_analysis.add("⚠️ Внимание: Сбой звукового движка (FMOD). Возможен конфликт модов на звуки грузовиков.")
                    elif "model" in line_lower and "malformed" in line_lower:
                        smart_analysis.add("🛑 Критично: Повреждена 3D-модель в одном из модов. Попробуйте отключить последние установленные модификации на грузовики или карты.")
                    elif "navigation" in line_lower and "building" in line_lower:
                        smart_analysis.add("⏳ Инфо: Движок строит кэш навигации! Это нормально. При первой загрузке огромных карт (ProMods и др.) игра может 'зависнуть' на 10-15 минут. НЕ ЗАКРЫВАЙТЕ ЕЁ!")
                elif "<WARNING>" in line:
                    if not self._log_filter_state.get("warn", True):
                        continue
                    log_box.insert("end", line, "warn")
                else:
                    if not self._log_filter_state.get("info", True):
                        continue
                    if line.startswith("["):
                        parts = line.split("]", 1)
                        log_box.insert("end", parts[0] + "]", "time")
                        if len(parts) > 1:
                            log_box.insert("end", parts[1])
                    else:
                        log_box.insert("end", line)

        except Exception as e:
            log_box.insert("end", f"Сбой парсера логов: {e}", "error")

        # === Новый AI-анализ через LogKnowledge ===
        try:
            issues = LogKnowledge.analyze(content)
        except Exception as e:
            log_error("LogKnowledge.analyze", e)
            issues = []

        if not issues:
            smart_result_label.configure(
                text="✅ Критических ошибок не найдено. Движок работает стабильно.")
        else:
            # Прячем старый label, рисуем сетку карточек
            smart_result_label.pack_forget()
            self._render_log_issues(smart_frame, issues)

        log_box.configure(state="disabled")

