    def _ui_cancel_sync(self):
        """Отмена через новый UI."""
        if not self.is_syncing:
            return
        if messagebox.askyesno("Отмена", "Прервать установку?"):
            self.sync_cancel_flag = True
            self.sync_pause_flag = False

    def _ui_set_step(self, step_id: str, state: str):
        """Обновляет состояние этапа: 'active' | 'done' | 'error' | 'wait'."""
        step = self._step_frames.get(step_id)
        if not step:
            return
        mode_idx = 0 if self.settings.get("appearance") == "Light" else 1

        if state == "active":
            step["status"].configure(text="⚡", text_color=UIConfig.COLOR_WARNING)
            step["name"].configure(text_color=UIConfig.COLOR_WARNING)
            self.sync_step_lbl.configure(text=f"⚡ {step['name'].cget('text')}...")
        elif state == "done":
            step["status"].configure(text="✅", text_color=UIConfig.COLOR_SUCCESS[mode_idx])
            step["name"].configure(text_color=UIConfig.COLOR_SUCCESS[mode_idx])
        elif state == "error":
            step["status"].configure(text="❌", text_color=UIConfig.COLOR_DANGER[mode_idx])
            step["name"].configure(text_color=UIConfig.COLOR_DANGER[mode_idx])
        elif state == "wait":
            step["status"].configure(text="○", text_color=UIConfig.COLOR_TEXT_MUTED[mode_idx])
            step["name"].configure(text_color=UIConfig.COLOR_TEXT_MUTED[mode_idx])

    def _ui_update_main_progress(self, current: int, total: int, file_name: str = "", speed: float = 0):
        """Обновляет главный прогресс-бар и лейблы."""
        try:
            if not hasattr(self, '_sync_main_prog') or not self._sync_main_prog.winfo_exists():
                return
            pct = current / total if total > 0 else 0
            self._sync_main_prog.set(pct)
            self.sync_step_lbl.configure(text=f"📦 {current}/{total} файлов ( {int(pct * 100)}% )")
            self._sync_sub_lbl.configure(text=file_name if file_name else "Инициализация...")
            if speed > 0:
                self._sync_speed_lbl.configure(text=f"⬇ {speed:.1f} MB/s")
            if total > 0:
                eta_sec = int((time.time() - getattr(self, '_sync_start_time', time.time())) / max(pct, 0.01) * (1 - pct)) if pct > 0 else 0
                if eta_sec > 0:
                    mins, secs = divmod(eta_sec, 60)
                    self.sync_eta_lbl.configure(text=f"⏱ Осталось: ~{mins}м {secs}с")
        except Exception:
            pass

    def _ui_sync_done(self, success: bool, stats: dict):
        """Финализирует UI после завершения."""
        try:
            if not hasattr(self, '_sync_main_prog') or not self._sync_main_prog.winfo_exists():
                return
            self._sync_main_prog.set(1.0)
            mode_idx = 0 if self.settings.get("appearance") == "Light" else 1

            if success:
                self._sync_main_prog.configure(progress_color=UIConfig.COLOR_SUCCESS[mode_idx])
                self.sync_step_lbl.configure(text="🎉 Установка завершена!", text_color=UIConfig.COLOR_SUCCESS[mode_idx])
                self.sync_eta_lbl.configure(text="Все файлы успешно установлены!")
                self._sync_sub_lbl.configure(text="Готово к запуску игры")
                self.finish_btn.configure(text="▶ ЗАПУСТИТЬ ИГРУ", state="normal",
                                          fg_color=UIConfig.COLOR_SUCCESS[mode_idx],
                                          hover_color=UIConfig.COLOR_SUCCESS_HOVER,
                                          text_color="white", command=self.launch_game)
            else:
                self._sync_main_prog.configure(progress_color=UIConfig.COLOR_DANGER[mode_idx])
                self.sync_step_lbl.configure(text="❌ Установка прервана", text_color=UIConfig.COLOR_DANGER[mode_idx])
                self.finish_btn.configure(text="Вернуться домой", state="normal",
                                          fg_color=UIConfig.COLOR_DANGER[mode_idx],
                                          hover_color=UIConfig.COLOR_DANGER_HOVER,
                                          text_color="white", command=self.show_home)

            # Финальная сводка
            summary = f"Установлено: {stats.get('installed', 0)} | Ошибок: {stats.get('errors', 0)} | Пропущено (кэш): {stats.get('skipped', 0)}"
            self._sync_sub_lbl.configure(text=summary)
        except Exception:
            pass

    def _update_sync_ui_current(self, file_name: str, current: int, total: int):
        percent = current / total if total > 0 else 1

        if hasattr(self, 'progress_var') and self.progress.winfo_exists():
            self.progress_var.set(percent)
            self.progress_text.configure(text=f"Обработка файлов: {current} из {total} ({int(percent * 100)}%)")
            self.current_file_label.configure(text=f"Общий процесс: {file_name}")

    def _update_task_ui(self, name: str, progress: float, speed: float):
        # Обновляем нижнюю фоновую панель
        if self.active_task_panel.winfo_ismapped():
            self.task_file_lbl.configure(text=f"Загрузка: {name}")
            self.task_prog.set(progress)
