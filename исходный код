@dataclass
class SyncStats:
    total: int = 0
    current: int = 0
    installed: int = 0
    updated: int = 0
    errors: int = 0
    skipped: int = 0
    started_at: float = field(default_factory=time.time)

    @property
    def progress_ratio(self) -> float:
        return (self.current / self.total) if self.total > 0 else 0.0

    @property
    def eta_seconds(self) -> float:
        if self.current <= 0:
            return 0.0
        elapsed = time.time() - self.started_at
        return elapsed * (self.total - self.current) / self.current

    def as_dict(self) -> dict:
        """Совместимость со старым self.sync_stats — словарём."""
        return {
            "total": self.total, "current": self.current,
            "installed": self.installed, "updated": self.updated,
            "errors": self.errors, "skipped": self.skipped,
        }


