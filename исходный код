        def _safe_set_news(text: str, color):
            """Безопасное обновление news_label из любого потока.
            Проверяет существование окна через try, не падает на закрытом окне."""
            try:
                # winfo_exists может выкинуть TclError если интерпретатор уничтожен
                self.after(0, lambda: self._news_label.configure(
                    text=text, text_color=color))
            except Exception:
                pass

        def _fetch_news():
            try:
                session = self._get_gh_session()
                resp = session.get(
                    f"https://api.github.com/repos/{AppConfig.PROGRAM_REPO}/releases/latest",
                    timeout=8)
                resp.raise_for_status()
                data = resp.json()
                tag = data.get("tag_name", "?")
                date_raw = data.get("published_at", "")
                date_str = ""
                if date_raw:
                    try:
                        dt = datetime.strptime(date_raw, "%Y-%m-%dT%H:%M:%SZ")
                        date_str = f"  ·  {dt.strftime('%d.%m.%Y')}"
                    except Exception:
                        pass
                body = data.get("body", "Нет описания.") or "Нет описания."
                body_short = body[:240].strip().replace("\r\n", " ").replace("\n", " ")
                if len(body) > 240:
                    body_short += "…"
                text = f"🟢  {tag}{date_str}\n{body_short}"
                _safe_set_news(text, UIConfig.COLOR_TEXT_MAIN)
            except requests.exceptions.Timeout:
                _safe_set_news("⊘  Нет ответа от GitHub (таймаут).",
                                UIConfig.COLOR_TEXT_MUTED)
            except Exception as e:
                logging.error(f"_fetch_news: {e}")
                _safe_set_news("⊘  Не удалось загрузить информацию о релизе.",
                                UIConfig.COLOR_TEXT_MUTED)
        threading.Thread(target=_fetch_news, daemon=True).start()

