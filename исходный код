    def safe_after(self, delay_ms: int, fn, *args):
        """
        Thread-safe обёртка над self.after().
        Если интерпретатор Tk уже уничтожен (программа закрывается, а тред
        ещё не успел завершиться) — молча игнорирует вызов вместо TclError.
        Используется во всех фоновых потоках которые пишут в UI.
        """
        try:
            return self.after(delay_ms, fn, *args)
        except (RuntimeError, Exception):
            return None

    def _hide_active_page(self):
        """
        Скрывает активную страницу.
        Используется только в return_to_sync_page (уход с обычной страницы → sync).
        Для обычных переключений «страница ↔ страница» работает PageHost.
        """
        kind = getattr(self, "_active_page_kind", None)
        if kind == "sync" and getattr(self, "_sync_screen_container", None):
            try:
                self._sync_screen_container.grid_remove()
            except Exception:
                pass
        else:
            # Обычная страница — прячем front-слот PageHost
            try:
                if hasattr(self, "page_host"):
                    self.page_host.front.grid_remove()
                else:
                    for widget in self.main_content.winfo_children():
                        widget.destroy()
            except Exception:
                pass
        self._active_page_kind = None

    def clear_content(self):
        """
        Подготовка к отрисовке новой страницы через двойной буфер.

        Стратегия:
          1. Если был активен sync_screen_container — прячем его (виджеты живы,
             поток продолжает их обновлять).
          2. Запускаем PageHost.begin_transition: подменяет front↔back так,
             что self.main_content начинает указывать на ПУСТОЙ off-screen
             слот. Старый front (с предыдущей страницей) ОСТАЁТСЯ на сцене
             и виден пользователю.
          3. Дальше show_xxx() пишет виджеты в self.main_content (=новый off-screen
             слот) — пользователь не видит этой стройки.
          4. После того как Python вернёт control в mainloop и tkinter
             отрисует виджеты, PageHost.after_idle запускает _kickoff_anim,
             который поднимает новый слот наверх и плавно показывает его
             через overlay-fade.
        """
        # Прячем sync если он был активен
        kind = getattr(self, "_active_page_kind", None)
        if kind == "sync" and getattr(self, "_sync_screen_container", None):
            try:
                self._sync_screen_container.grid_remove()
            except Exception:
                pass

        # Запускаем двойной буфер
        if hasattr(self, "page_host"):
            self.page_host.begin_transition()
        else:
