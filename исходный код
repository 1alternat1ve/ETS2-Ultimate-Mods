    def _check_network_health(self, retry_count: int = 0):
        def check():
            has_token = bool(SecureConfig.get_github_token())
            try:
                session = self._get_gh_session()
                # Без токена /rate_limit ВСЁ РАВНО считается за 0 запросов
                # (это документировано в API GitHub), поэтому используем его всегда.
                # Но без токена показываем человекопонятный текст, а не цифры.
                resp = session.get("https://api.github.com/rate_limit", timeout=15)
                if resp.status_code == 200:
                    rate = resp.json().get("rate", {})
                    try:
                        remaining = int(rate.get("remaining", 0))
                    except (TypeError, ValueError):
                        remaining = 0
                    try:
                        limit = int(rate.get("limit", 0))
                    except (TypeError, ValueError):
                        limit = 0

                    if has_token:
                        # С токеном — показываем точные цифры
                        color = (UIConfig.COLOR_SUCCESS if remaining > 100
                                 else UIConfig.COLOR_WARNING)
                        text = f"🌐 API: {remaining}/{limit} запросов"
                    else:
                        # Без токена — компактный статус и предупреждение если близко к лимиту
                        if remaining < 5:
                            text = f"🌐 ⚠️ Лимит почти исчерпан ({remaining}/60)"
                            color = UIConfig.COLOR_DANGER
                        elif remaining < 15:
                            text = f"🌐 Лимит API: {remaining}/60"
                            color = UIConfig.COLOR_WARNING
                        else:
                            text = "🌐 Сеть: онлайн"
                            color = UIConfig.COLOR_SUCCESS

                    self.after(0, lambda t=text, c=color:
                               self.network_status_label.configure(text=t, text_color=c))
                else:
                    self.after(0, lambda: self.network_status_label.configure(
                        text=f"🌐 Сеть: Код {resp.status_code}",
                        text_color=UIConfig.COLOR_WARNING))
            except requests.exceptions.Timeout:
                # Повтор через 2 сек
                if retry_count < 2:
                    self.after(2000, lambda: self._check_network_health(retry_count + 1))
                else:
                    self.after(0, lambda: self.network_status_label.configure(
                        text="🌐 Сеть: Таймаут", text_color=UIConfig.COLOR_DANGER))
            except requests.exceptions.RequestException:
                # Повтор через 2 сек
                if retry_count < 2:
                    self.after(2000, lambda: self._check_network_health(retry_count + 1))
                else:
                    self.after(0, lambda: self.network_status_label.configure(
                        text="🌐 Сеть: Оффлайн", text_color=UIConfig.COLOR_DANGER))
            except Exception as e:
                logging.error(f"_check_network_health inner: {e}")
                # Повтор через 2 сек
                if retry_count < 2:
                    self.after(2000, lambda: self._check_network_health(retry_count + 1))
                else:
                    self.after(0, lambda: self.network_status_label.configure(
                        text="🌐 Сеть: Сбой", text_color=UIConfig.COLOR_DANGER))

        try:
            threading.Thread(target=check, daemon=True).start()
        except Exception as e:
            logging.error(f"_check_network_health spawn: {e}")
        # Без токена проверяем редко (раз в 5 мин) чтобы не съесть лимит на одних только проверках.
        # С токеном — раз в 1.5 мин.
        next_interval_ms = 90_000 if SecureConfig.get_github_token() else 300_000
        self.after(next_interval_ms, lambda: self._check_network_health(0))

