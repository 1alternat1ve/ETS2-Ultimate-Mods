    def _build_home_update_banner(self, parent):
        """Баннер обновления программы — показывается если есть pending_program_update.json."""
        try:
            update_file = AppConfig.APPDATA_DIR / "pending_program_update.json"
            if not update_file.exists():
                return

            data = json.loads(update_file.read_text(encoding="utf-8"))
            version = data.get('version', '')
            notes = data.get('notes', '')
            url = data.get('url', '')

            # Красивый баннер
            banner = ctk.CTkFrame(parent, corner_radius=16,
                                  fg_color=UIConfig.COLOR_ACCENT,
                                  border_width=0)
            banner.pack(fill="x", pady=(0, 12))

            content = ctk.CTkFrame(banner, fg_color="transparent")
            content.pack(fill="x", padx=20, pady=16)

            # Заголовок с иконкой
