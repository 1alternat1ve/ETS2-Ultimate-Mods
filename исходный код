    def switch_theme(self, theme_key: str):
        """
        Переключает тему в runtime.
        Перезаписывает UIConfig, обновляет цвета базовых элементов,
        перерисовывает текущую страницу.
        """
        if not ThemeManager.apply(theme_key):
            return
        self.settings["nexus_theme"] = theme_key
        self.save_settings()

        # Обновляем основные «хром»-элементы
        try:
            self.configure(fg_color=UIConfig.COLOR_BG)
        except Exception:
            pass
        try:
            if hasattr(self, "_bg_canvas_holder"):
                self._bg_canvas_holder.configure(fg_color=UIConfig.COLOR_BG)
            if hasattr(self, "animated_bg"):
                self.animated_bg.update_palette()
        except Exception:
            pass
        try:
            self.sidebar.configure(fg_color=UIConfig.COLOR_SIDEBAR_BG)
            self.status_bar.configure(fg_color=UIConfig.COLOR_STATUS_BG)
        except Exception:
            pass

        # Перерисовываем активную страницу
        try:
            if self._active_page_kind == "sync":
                # На странице синхронизации виджеты ссылаются на конкретные цвета
                # из UIConfig — пересборка займёт много кода. Для безопасности
                # делаем return_to_sync_page (он держит UI как есть)
                pass
            else:
                # Простой подход: показываем главную (она пересоберётся)
                self.show_home()
        except Exception:
            pass

        if hasattr(self, "toast"):
            theme_name = ThemeManager.THEMES[theme_key]["name"]
            self.toast.show(f"Тема применена: {theme_name}", "success")

    def toggle_theme_switch(self):
        if self.theme_switch.get():
            ctk.set_appearance_mode("Dark")
            self.settings["appearance"] = "Dark"
            self.theme_switch.configure(text="🌙 Темная тема")
        else:
