    def _on_game_event(self, kind: str, payload: dict):
        """
        Обработчик событий GameWatchdog.
        Вызывается в main thread через after().
        """
        try:
            if kind == "launched":
                self.set_status("ETS2 запущена — счастливого пути!")
                if hasattr(self, "toast"):
                    self.toast.show("🎮 ETS2 запущена", "info", duration_ms=3000)
                if self.mascot:
                    self.mascot.set_state("working")

            elif kind == "crashed":
                # Игра упала в первые 60 сек — это краш
                duration = int(payload.get("duration_s", 0))
                self.set_status(f"❌ ETS2 упала через {duration} сек после старта")
                if hasattr(self, "toast"):
                    self.toast.show(
                        f"❌  ETS2 упала через {duration} сек\n"
                        f"Открыть лог-анализатор?",
                        "error", duration_ms=8000)
                SoundFX.play("error")
                if self.mascot:
                    self.mascot.set_state("error")

                # Через 3 сек предложить открыть лог-анализатор
                def _suggest_log():
                    if messagebox.askyesno(
                            "Игра упала",
                            f"ETS2 упала через {duration} секунд после запуска.\n\n"
                            "Это похоже на краш. Открыть лог-анализатор для "
                            "поиска причины?"):
                        self.show_log_viewer()
                self.after(3000, _suggest_log)

            elif kind == "exited":
                # Нормальное закрытие после полноценной сессии
                duration = payload.get("duration_s", 0)
                hours = duration / 3600
                if self.mascot:
                    self.mascot.set_state("idle")
                if hasattr(self, "toast") and hours >= 1:
                    self.toast.show(
                        f"⏱  Сессия завершена · {hours:.1f} ч за рулём",
                        "success", duration_ms=4000)

                # === Test mode: спрашиваем оставить или откатить ===
                if getattr(self, "_test_session", None):
                    sess = self._test_session
                    def _ask_test():
                        decision = messagebox.askyesnocancel(
                            "Тестовый запуск завершён",
                            f"Игра закрылась.\n\n"
                            f"Мод: {sess['test_mod_name']}\n"
                            f"Время сессии: {hours:.1f} ч\n\n"
                            "[Да] — оставить мод в сборке\n"
                            "[Нет] — откатить (удалить)\n"
                            "[Отмена] — решить позже")
                        if decision is True:
                            self._test_keep()
                        elif decision is False:
                            self._test_rollback()
                    self.after(1500, _ask_test)

            elif kind == "long_session":
                # 2+ часа игры — первое напоминание
                if hasattr(self, "toast"):
                    self.toast.show(
                        "⏰  Вы играете уже 2 часа\n"
                        "Не забывайте делать перерывы!",
                        "warn", duration_ms=8000)
                SoundFX.play("info")

            elif kind == "break_reminder":
                # Каждые 90 мин — напоминание
                hours = payload.get("duration_s", 0) / 3600
                if hasattr(self, "toast"):
                    self.toast.show(
                        f"☕  Перерыв! Вы играете {hours:.1f} ч",
                        "info", duration_ms=5000)

            elif kind == "hung":
                # Процесс жив но CPU=0% более 30 сек
                if hasattr(self, "toast"):
                    self.toast.show(
                        "⚠  ETS2 не отвечает (CPU=0%)\n"
                        "Возможно зависла — нажмите 'Убить процесс' в сайдбаре",
                        "warn", duration_ms=10000)
                SoundFX.play("warn")
        except Exception as e:
            log_error("_on_game_event", e)

