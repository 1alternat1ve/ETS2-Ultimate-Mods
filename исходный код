            except Exception as e:
                log_error("quarantine_mods", e)
                messagebox.showerror("Ошибка", f"Не удалось изолировать моды: {e}")

    def fix_trailer_stutter(self):
        try:
            mod_dir = get_my_documents() / "Euro Truck Simulator 2" / "mod"
            mod_dir.mkdir(parents=True, exist_ok=True)
            fix_path = mod_dir / "nexus_trailer_stutter_fix.scs"
            
            with zipfile.ZipFile(fix_path, 'w', zipfile.ZIP_DEFLATED) as zf:
                manifest = 'SiiNunit\n{\nmod_package : .package_name {\n    package_version: "1.0"\n    display_name: "Nexus Trailer Stutter Fix"\n    author: "Nexus Pro"\n    icon: "mod_icon.jpg"\n}\n}'
