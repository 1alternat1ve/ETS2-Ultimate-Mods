    def compile_to_exe(self):
        if getattr(sys, 'frozen', False) or "__compiled__" in globals():
            messagebox.showinfo("Внимание", "Программа уже запущена как скомпилированный EXE файл.")
            return
        
        warn_msg = (
            "Сборка программы в .exe файл может занять длительное время (10+ минут).\n\n"
            "Убедитесь, что у вас установлен компилятор (например, MinGW или MSVC) и модуль Nuitка.\n"
            "⚠️ ВАЖНО: Закройте игру перед компиляцией!\n\n"
            "Продолжить?"
        )
        if not messagebox.askyesno("Сборка", warn_msg): 
            return
            
        self.set_status("Идет компиляция Nuitка... Пожалуйста, не закрывайте программу.")
        script_path = os.path.abspath(__file__)
        icon_path = self.exe_icon_path.get()
        
        def compile_thread():
            try:
                cmd = [
                    sys.executable, "-m", "nuitka",
                    "--onefile",
                    "--windows-disable-console",
                    "--enable-plugin=tk-inter",
                    "--include-package=customtkinter",
                    script_path
                ]
                
                if icon_path and Path(icon_path).exists():
                    cmd.append(f"--windows-icon-from-ico={icon_path}")
                
                process = subprocess.Popen(
                    cmd, 
                    cwd=AppConfig.BASE_DIR, 
                    stdout=subprocess.PIPE, 
                    stderr=subprocess.PIPE, 
                    text=True
                )
                stdout, stderr = process.communicate()
                
                if process.returncode == 0:
                    self.after(0, lambda: messagebox.showinfo("Успех", "Компиляция успешно завершена! .exe файл находится в папке с программой."))
                else:
                    log_error("compile_to_exe_stderr", Exception(stderr[-1000:]))
                    self.after(0, lambda: messagebox.showerror("Сбой", "Ошибка компилятора. Подробности записаны в crash_log.txt."))
            except Exception as e:
                log_error("compile_to_exe_exception", e)
                self.after(0, lambda: messagebox.showerror("Ошибка", str(e)))
            finally:
                self.after(0, lambda: self.set_status("Система готова"))

        threading.Thread(target=compile_thread, daemon=True).start()

