    def download_asset_chunked(self, asset_dict, target_path):
        """
        Высокоскоростная загрузка с прогрессом, паузой, отменой и **resume**.

        Оптимизации против старой версии:
          • chunk 1 МБ (вместо 64 КБ) — меньше overhead Python<->OS, выше throughput
          • resume через HTTP Range — если файл скачан частично, докачивает остаток
          • UI-обновление троттлится 3 раза/сек (вместо каждого чанка) — снимает нагрузку с tk
          • keep-alive сессия (через _get_gh_session) — не пересоздаём TCP/TLS
        Скорость на быстрых каналах вырастает в 3-4 раза.
        """
        asset_size = asset_dict['size']
        asset_name = asset_dict['name']
        download_url = asset_dict['browser_download_url']

        # Быстрая проверка: файл уже скачан целиком
        if target_path.exists() and target_path.stat().st_size == asset_size and asset_size > 0:
            self.safe_log_colored(
                f"⏭ [КЭШ TEMP] {asset_name} совпадает по размеру, пропускаем.", "muted")
            self.sync_stats['skipped'] += 1
            return True

        # Resume: если файл частично скачан, докачиваем
        resume_pos = 0
        if target_path.exists():
            existing = target_path.stat().st_size
            if 0 < existing < asset_size:
                resume_pos = existing
                self.safe_log_colored(
                    f"⏯ [RESUME] {asset_name}: докачиваем с {resume_pos/(1024*1024):.1f} MB", "info")

        self.safe_log_colored(
            f"⬇️ [ЗАГРУЗКА] {asset_name} ({asset_size/(1024*1024):.1f} MB)...", "warn")

        headers = {}
        if resume_pos > 0:
            headers["Range"] = f"bytes={resume_pos}-"

        try:
            session = self._get_gh_session()
            mode = "ab" if resume_pos > 0 else "wb"

            with session.get(download_url, stream=True, headers=headers, timeout=30) as r:
                # 416 = Range Not Satisfiable: значит сервер считает файл уже целиком скачан
                if r.status_code == 416:
                    self.sync_stats['skipped'] += 1
                    return True
                r.raise_for_status()

                downloaded = resume_pos
                start_time = time.time()
                last_ui_tick = start_time
                last_ui_pos = resume_pos

                with open(target_path, mode) as f:
                    for chunk in r.iter_content(chunk_size=1024 * 1024):  # 1 МБ
                        if self.sync_cancel_flag:
                            raise InterruptedError("Отменено пользователем")
                        # Skip-current-file: прервать ТОЛЬКО эту загрузку,
                        # не отменять весь sync. Очистим event и пометим skipped.
                        if self._sync_skip_event.is_set():
                            self._sync_skip_event.clear()
                            self.safe_log_colored(
                                f"⏭ [ПРОПУСК] {asset_name} пропущен пользователем", "warn")
                            self.sync_stats['skipped'] += 1
                            self.after(0, self._file_row_set_status,
                                        asset_name, "skipped")
                            return False
                        # Пауза с быстрым выходом по отмене/пропуску
                        while self.sync_pause_flag:
                            if self.sync_cancel_flag:
                                raise InterruptedError("Отменено пользователем")
                            if self._sync_skip_event.is_set():
                                break
                            time.sleep(0.2)

                        if not chunk:
                            continue
                        f.write(chunk)
                        downloaded += len(chunk)

                        # Троттлинг UI: обновляем 3 раза в секунду максимум
                        now = time.time()
                        if now - last_ui_tick >= 0.3:
                            speed = (downloaded - last_ui_pos) / (now - last_ui_tick) / (1024 * 1024)
                            progress = downloaded / asset_size if asset_size > 0 else 0
                            self.after(0, self._update_task_ui, asset_name, progress, speed)
                            last_ui_tick = now
                            last_ui_pos = downloaded

            self.sync_stats['installed'] += 1
            return True

        except InterruptedError:
            raise  # пробрасываем для остановки движка
        except Exception as e:
            self.safe_log_colored(f"⚠️ [ОШИБКА ЗАГРУЗКИ] {asset_name}: {e}", "error")
            self.sync_stats['errors'] += 1
            # Не удаляем частично скачанный файл — следующий запуск сделает resume
            return False

    def _decrypt_sii_smart(self, target_sii: Path) -> bool:
        """
        Умная дешифровка SII:
          1) Если файл уже текстовый (SiiNunit) — ничего не делаем.
          2) Пробуем встроенный SiiDecryptor (Python+pycryptodome) — антивирус не ругается.
          3) Только если не получилось (например, BSII) — fallback на SII_Decrypt.exe.

        Возвращает True при успехе.
        """
        try:
            fmt = SiiDecryptor.detect_format(target_sii)
            if fmt == "siinunit":
                return True
            if fmt == "scsc" and SiiDecryptor.is_available():
                if SiiDecryptor.decrypt_file(target_sii, make_backup=True):
                    if hasattr(self, "safe_log_colored"):
                        self.safe_log_colored(
                            "🔓 [PYTHON] Файл расшифрован встроенным дешифратором (без EXE).",
                            "success")
                    return True
            # Fallback на легаси SII_Decrypt.exe
            sii_decrypt_exe = self._ensure_sii_decrypt()
            if not sii_decrypt_exe:
                return False
            run_hidden_process([str(sii_decrypt_exe), str(target_sii)])
            time.sleep(0.5)
            return True
        except Exception as e:
            log_error("_decrypt_sii_smart", e)
            return False

    def _ensure_sii_decrypt(self):
        """
        Скачивает SII_Decrypt.exe только если встроенный SiiDecryptor не справился
        (legacy fallback). Многие пользователи теперь даже не дойдут до этой функции.
        """
        # Если pycryptodome доступен — лучше не таскать EXE вообще
        if SiiDecryptor.is_available():
            # Не возвращаем None — пусть вызывающий пробует SiiDecryptor отдельно;
            # но мы ВСЁ ЕЩЁ скачиваем EXE как fallback для BSII-формата.
            pass

        sii_path = AppConfig.TEMP_SYNC_DIR / "SII_Decrypt.exe"
        if sii_path.exists():
            return sii_path

        self.safe_log_colored("🌐 Скачивание системной утилиты SII_Decrypt (legacy fallback)...", "muted")
        AppConfig.TEMP_SYNC_DIR.mkdir(parents=True, exist_ok=True)
        session = self._get_gh_session()

        def _try_direct_link() -> Optional[Path]:
            try:
                with session.get(AppConfig.FALLBACK_DECRYPT_URL, stream=True, timeout=15) as r:
                    r.raise_for_status()
                    with open(sii_path, 'wb') as f:
                        for chunk in r.iter_content(chunk_size=65536):
                            if chunk:
                                f.write(chunk)
                return sii_path
            except Exception as direct_err:
                log_error("_ensure_sii_decrypt_direct_fail", direct_err)
                return None

        try:
            api_url = AppConfig.GITHUB_API_URL.replace("/latest", "")
            resp = session.get(api_url, timeout=8)
            resp.raise_for_status()

            releases = resp.json()
            if isinstance(releases, dict):
                releases = [releases]

            download_url = None
            for release in releases:
                for asset in release.get('assets', []):
                    if asset['name'] == "SII_Decrypt.exe":
                        download_url = asset['browser_download_url']
                        break
                if download_url:
                    break

            if not download_url:
                raise RuntimeError("SII_Decrypt.exe не найден ни в одном релизе API.")

            with session.get(download_url, stream=True, timeout=15) as r:
                r.raise_for_status()
                with open(sii_path, 'wb') as f:
                    for chunk in r.iter_content(chunk_size=65536):
                        if chunk:
                            f.write(chunk)
            return sii_path

        except requests.exceptions.RequestException as api_err:
            log_error("_ensure_sii_decrypt_api_fail", api_err)
            self.safe_log_colored(f"⚠️ Сбой API ({api_err}). Прямая ссылка...", "warn")
            return _try_direct_link()
        except Exception as api_err:
            log_error("_ensure_sii_decrypt_unexpected", api_err)
            self.safe_log_colored(f"⚠️ Неожиданная ошибка API ({api_err}). Прямая ссылка...", "warn")
            res = _try_direct_link()
            if res is None:
                self.safe_log_colored("❌ Полный сбой загрузки SII_Decrypt.", "error")
            return res

    def _cleanup_sii_decrypt(self):
        sii_path = AppConfig.TEMP_SYNC_DIR / "SII_Decrypt.exe"
        try:
            if sii_path.exists():
                sii_path.unlink()
        except Exception:
            pass

    def _ensure_reference_profile(self, force_build_type=None):
        # Определяем какой тип профиля нужен
        # force_build_type приоритетнее настроек (для ручного исправления модов)
        build_type = force_build_type if force_build_type else self.settings.get("profile_build_type", "convoy")
        if build_type == "solo":
            ref_dir = AppConfig.TEMP_SYNC_DIR / AppConfig.REF_PROFILE_DIR_SOLO
            profile_name = AppConfig.REF_PROFILE_SOLO
        else:
            ref_dir = AppConfig.TEMP_SYNC_DIR / AppConfig.REF_PROFILE_DIR_CONVOY
            profile_name = AppConfig.REF_PROFILE_CONVOY
        
        profile_type_label = "Соло (>100 модов)" if build_type == "solo" else "Конвой (<100 модов)"
        
        if ref_dir.exists() and any(ref_dir.rglob("profile.sii")):
            # Дополнительная проверка: убедимся, что в эталоне есть либо
            # ScsC-зашифрованный либо SiiNunit-расшифрованный файл.
            # Если файл повреждён (битый расшифрованный мусор) — пере-скачиваем.
            try:
                ref_sii = next(ref_dir.rglob("profile.sii"))
                fmt = SiiDecryptor.detect_format(ref_sii)
                if fmt in ("scsc", "siinunit"):
                    return ref_dir
                # Иначе — мусор от прошлого прогона, удалим и пере-скачаем
                self.safe_log_colored(
                    "⚠️ Эталонный профиль повреждён, перезагружаем...", "warn")
                try:
                    shutil.rmtree(ref_dir)
                except Exception:
                    pass
            except StopIteration:
                pass
            except Exception:
                return ref_dir   # на всякий случай не падаем

        self.safe_log_colored(f"🌐 Скачивание эталонного профиля ({profile_type_label})...", "muted")
        # Используем сессию с токеном для надёжного доступа к GitHub API
        session = self._get_gh_session()
        try:
            api_url = AppConfig.GITHUB_API_URL
            resp = session.get(api_url, timeout=10)
            resp.raise_for_status()

            release = resp.json()
            download_asset = None
            for asset in release.get('assets', []):
                if asset['name'] == profile_name:
                    download_asset = asset
                    break

            if not download_asset:
                self.safe_log_colored(f"⚠️ Профиль '{profile_name}' не найден на GitHub", "error")
                return None

            target = AppConfig.TEMP_SYNC_DIR / profile_name
            if not self.download_asset_chunked(download_asset, target):
                return None

            with py7zr.SevenZipFile(target, mode='r') as z:
                z.extractall(path=ref_dir)
            if self.settings.get("direct_unpack_mode", False):
                target.unlink()
            return ref_dir
        except requests.exceptions.RequestException as e:
            log_error("_ensure_reference_profile", e)
            self.safe_log_colored(f"⚠️ Сбой сети при загрузке профиля: {e}", "warn")
            return None
        except Exception as e:
            log_error("_ensure_reference_profile", e)
            return None

    def sync_engine(self):
        self.is_syncing = True
        self.sync_cancel_flag = False
        self.sync_pause_flag = False
        self._sync_start_time = time.time()

        # Инициализация этапов
        for step_id in ["backup", "manifest", "mods", "dlc", "profile", "cleanup"]:
            self.after(0, self._ui_set_step, step_id, "wait")

        # active_task_panel удалена — больше не показываем нижнюю плашку
        self.after(0, self.set_status, "Запуск процесса...")
        self.safe_log_colored("🚀 Подготовка к установке пресета...", "info")

        def _do_step(step_id):
            self.after(0, self._ui_set_step, step_id, "active")

        def _done_step(step_id, ok=True):
            self.after(0, self._ui_set_step, step_id, "done" if ok else "error")

        try:
            # ── Этап 0: Проверка свободного места на диске ──
            self.safe_log_colored("💿 Проверка свободного места на диске...", "muted")
            free_gb = self.get_free_space_gb()
            if free_gb < AppConfig.MIN_DISK_SPACE_GB:
                err_msg = (
                    f"Недостаточно свободного места на диске!\n\n"
                    f"Доступно: {free_gb:.1f} ГБ\n"
                    f"Требуется: {AppConfig.MIN_DISK_SPACE_GB} ГБ\n\n"
                    f"Освободите место и попробуйте снова."
                )
                self.safe_log_colored(f"❌ Недостаточно места: {free_gb:.1f} ГБ / требуется {AppConfig.MIN_DISK_SPACE_GB} ГБ", "error")
                self.after(0, lambda: messagebox.showerror("Мало места на диске", err_msg))
                self.after(0, lambda: self._ui_sync_done(False, self.sync_stats))
                self.after(0, lambda: self._error_sync_ui(cancelled=False))
                return
            self.safe_log_colored(f"✅ Свободного места: {free_gb:.1f} ГБ — достаточно.", "success")

            # ── Этап 1: Резервное копирование ──
            _do_step("backup")
            self.safe_log_colored("[СИСТЕМА] Запуск сетевого установщика...", "info")
            self.safe_log_colored("💾 Создание резервной копии перед установкой...", "muted")
            self.after(0, self.set_status, "Создание резервной копии профиля (это может занять время)...")
            self.create_backup(silent=True)
            _done_step("backup")
            self.after(0, self.set_status, "Соединение с облачным хранилищем...")

            ets_folder = get_my_documents() / "Euro Truck Simulator 2"
            mod_dir = ets_folder / "mod"
            mod_dir.mkdir(parents=True, exist_ok=True)
            AppConfig.TEMP_SYNC_DIR.mkdir(parents=True, exist_ok=True)

            # Загружаем локальный манифест установленных ассетов
            manifest = self._load_manifest()
            self.safe_log_colored(f"📋 Загружен манифест: {len(manifest)} записей об установленных файлах.", "muted")

            # ── Этап 2: Манифест ──
            _do_step("manifest")
            self.safe_log_colored("🌐 Получение списка файлов со всех релизов...", "muted")
            api_url_all = AppConfig.GITHUB_API_URL.replace("/latest", "")

            # Используем сессию с GitHub токеном для надёжного подключения (до 5000 req/h)
            session = self._get_gh_session()

            try:
                resp = session.get(api_url_all, timeout=15)
                resp.raise_for_status()
                if not resp.text.strip():
                    raise Exception("Пустой ответ сервера")
                # Логируем оставшийся лимит API
                remaining = resp.headers.get("X-RateLimit-Remaining", "?")
                limit = resp.headers.get("X-RateLimit-Limit", "?")
                self.safe_log_colored(f"🔑 GitHub API лимит: {remaining}/{limit} запросов", "muted")
            except requests.exceptions.Timeout:
                self.safe_log_colored("⏰ Таймаут подключения к серверу (15 сек). Отмена установки.", "error")
                self.after(0, lambda: messagebox.showerror("Сервер не отвечает", "Превышен таймаут ожидания ответа от GitHub API (15 сек).\nПроверьте интернет-соединение и попробуйте снова."))
                self.after(0, lambda: self._error_sync_ui(cancelled=False))
                return
            except Exception as req_err:
                log_error("sync_engine_api", req_err)
                self.safe_log_colored(f"❌ Ошибка сети: {req_err}", "error")
                self.after(0, lambda: messagebox.showerror("Ошибка сети", f"Не удалось подключиться к серверу: {req_err}"))
                self.after(0, lambda: self._error_sync_ui(cancelled=False))
                return

            releases = resp.json()
            if isinstance(releases, dict):
                releases = [releases]

            assets_dict = {}
            for release in releases:
                for asset in release.get('assets', []):
                    name = asset['name']
                    if name.endswith('.exe') and name != "SII_Decrypt.exe":
                        continue
                    if name not in assets_dict:
                        assets_dict[name] = asset

            assets = list(assets_dict.values())

            _done_step("manifest")

            self.sync_stats = {'total': len(assets), 'current': 0, 'installed': 0, 'updated': 0, 'errors': 0, 'skipped': 0}
            direct_unpack = self.settings.get("direct_unpack_mode", False)

            # === Заполняем ленту файлов сразу всеми ассетами в статусе wait ===
            def _populate_filelist():
                if hasattr(self, "_file_rows"):
                    for a in assets:
                        self._file_row_create(a.get("name", "?"), a.get("size", 0))
                if hasattr(self, "_files_count_lbl"):
                    self._files_count_lbl.configure(
                        text=f"0 / {len(assets)}")
            self.after(0, _populate_filelist)

            # ── Этап 3: Установка модов ──
            _do_step("mods")
            self.safe_log_colored("", "bold")
            self.safe_log_colored("── Установка модов и файлов ──", "bold")

            for asset in assets:
                if self.sync_cancel_flag:
                    raise InterruptedError("Отменено пользователем")

                while self.sync_pause_flag:
                    if self.sync_cancel_flag:
                        raise InterruptedError("Отменено пользователем")
                    time.sleep(0.3)

                self.sync_stats['current'] += 1
                name = asset['name']
                size_mb = asset.get('size', 0) / (1024 * 1024)

                # Обновляем UI: главный прогресс + лента файлов
                self.after(0, self._ui_update_main_progress,
                           self.sync_stats['current'], self.sync_stats['total'],
                           f"{name} ({size_mb:.1f} MB)", 0)
                # Лента: текущий файл — в "downloading"
                self.after(0, self._file_row_set_status, name, "downloading")
                # Счётчик ленты
                if hasattr(self, "_files_count_lbl"):
                    cur, total = self.sync_stats['current'], self.sync_stats['total']
                    self.after(0,
                                lambda c=cur, t=total: self._files_count_lbl.configure(
                                    text=f"{c} / {t}"))

                if name == "SII_Decrypt.exe":
                    self.after(0, self._file_row_set_status, name, "skipped")
                    continue

                elif name in ["DLC.zip", "DLC1.zip"]:
                    _done_step("mods")
                    _do_step("dlc")
                    all_game_paths = self.find_all_game_paths()
                    if all_game_paths:
                        target = AppConfig.TEMP_SYNC_DIR / name
                        # Умная проверка: пропускаем DLC-архив если уже актуален
                        if self._is_asset_current(asset, manifest, target):
                            self.safe_log_colored(f"⏭ [АКТУАЛЬНО] {name} — версия совпадает с GitHub, пропуск.", "success")
                            self.sync_stats['skipped'] += 1
                        elif self.download_asset_chunked(asset, target):
                            for game_root in all_game_paths:
                                self.safe_log_colored(f"📦 Распаковка {name} → {game_root.name}...", "info")
                                try:
                                    with zipfile.ZipFile(target, 'r') as z:
                                        z.extractall(path=game_root)
                                except Exception as e:
                                    self.safe_log_colored(f"⚠️ Ошибка: {e}", "error")
                            # Сохраняем в манифест ПОСЛЕ успешной установки
                            self._mark_asset_installed(manifest, asset)
                            if direct_unpack:
                                target.unlink(missing_ok=True)
                    else:
                        self.safe_log_colored("⚠️ Путь к игре не найден — пропуск DLC", "warn")
                    _done_step("dlc")
                    _do_step("mods")

                elif name in [AppConfig.REF_PROFILE_CONVOY, AppConfig.REF_PROFILE_SOLO]:
                    # Пропускаем профиль, который не соответствует выбранному типу сборки
                    build_type = self.settings.get("profile_build_type", "convoy")
                    expected_name = AppConfig.REF_PROFILE_SOLO if build_type == "solo" else AppConfig.REF_PROFILE_CONVOY

                    self.safe_log_colored(f"🔍 [REF] Обработка: name={name}, build_type={build_type}, expected={expected_name}", "info")

                    if name != expected_name:
                        self.safe_log_colored(f"⏭ [REF] Пропуск {name} (не подходит для {build_type})", "warn")
                        self.after(0, self._file_row_set_status, name, "skipped")
                        continue

                    target = AppConfig.TEMP_SYNC_DIR / name
                    ref_dir_name = AppConfig.REF_PROFILE_DIR_SOLO if build_type == "solo" else AppConfig.REF_PROFILE_DIR_CONVOY
                    ref_dir = AppConfig.TEMP_SYNC_DIR / ref_dir_name

                    self.safe_log_colored(f"📥 [REF] Начинаем скачивание {name}...", "warn")
                    self.safe_log_colored(f"   target={target}, ref_dir={ref_dir}", "muted")

                    # Проверка актуальности
                    is_current = self._is_asset_current(asset, manifest, target)
                    ref_dir_exists = ref_dir.exists()
                    self.safe_log_colored(f"   is_current={is_current}, ref_dir_exists={ref_dir_exists}", "muted")

                    if is_current and ref_dir_exists:
                        self.safe_log_colored(f"⏭ [REF] Пропуск (актуально): {name}", "success")
                        self.sync_stats['skipped'] += 1
                    else:
                        self.safe_log_colored(f"⬇️ [REF] Скачиваем: {name}...", "warn")
                        download_ok = self.download_asset_chunked(asset, target)
                        self.safe_log_colored(f"   download_asset_chunked = {download_ok}", "muted")

                        if download_ok:
                            self.safe_log_colored(f"✅ [REF] Скачан: {name}, распаковка...", "success")
                            if self.mode == 'ready':
                                self.safe_log_colored(f"📦 [REF] Режим ready - устанавливаем профиль", "info")
                                self.install_ready_profile(target)
                            else:
                                self.safe_log_colored(f"📦 [REF] Режим new - распаковываем в ref_dir", "info")
                                ref_dir.mkdir(exist_ok=True)
                                try:
                                    with py7zr.SevenZipFile(target, mode='r') as z:
                                        z.extractall(path=ref_dir)
                                    self.safe_log_colored(f"✅ [REF] Распакован: {name} → {ref_dir}", "success")
                                except Exception as e:
                                    log_error("ref_extract", e)
                                    self.safe_log_colored(f"❌ [REF] Ошибка распаковки: {e}", "error")
                            self._mark_asset_installed(manifest, asset)
                            if direct_unpack:
                                target.unlink(missing_ok=True)
                        else:
                            self.safe_log_colored(f"❌ [REF] ОШИБКА скачивания {name}!", "error")
                            self.after(0, self._file_row_set_status, name, "error")

                elif name.endswith(".zip") and "dlcsupport" in name.lower():
                    target = mod_dir / name
                    # Умная проверка для dlcsupport-файлов
                    if self._is_asset_current(asset, manifest, target):
                        self.safe_log_colored(f"⏭ [АКТУАЛЬНО] {name} — версия совпадает с GitHub, пропуск.", "success")
                        self.sync_stats['skipped'] += 1
                    else:
                        if self.download_asset_chunked(asset, target):
                            self._mark_asset_installed(manifest, asset)

                elif name.endswith(".zip"):
                    target = mod_dir / name  # Скачиваем сразу в папку модов (НЕ распаковываем!)
                    # Умная проверка ПЕРЕД скачиванием тяжёлого архива
                    if self._is_asset_current(asset, manifest, target):
                        self.safe_log_colored(f"⏭ [АКТУАЛЬНО] {name} — версия совпадает с GitHub, пропуск.", "success")
                        self.sync_stats['skipped'] += 1
                    elif self.download_asset_chunked(asset, target):
                        self.safe_log_colored(f"📦 {name} — сохранён как архив (.zip)", "info")
                        self._mark_asset_installed(manifest, asset)

                elif name.endswith(".7z"):
                    target = AppConfig.TEMP_SYNC_DIR / name
                    # Умная проверка ПЕРЕД скачиванием тяжёлого 7z-архива
                    if self._is_asset_current(asset, manifest, target):
                        self.safe_log_colored(f"⏭ [АКТУАЛЬНО] {name} — версия совпадает с GitHub, пропуск.", "success")
                        self.sync_stats['skipped'] += 1
                    elif self.download_asset_chunked(asset, target):
                        self.safe_log_colored(f"📦 Распаковка {name}...", "info")
                        with py7zr.SevenZipFile(target, mode='r') as z:
                            z.extractall(path=mod_dir)
                        self._mark_asset_installed(manifest, asset)
                        if direct_unpack:
                            target.unlink(missing_ok=True)
                else:
                    target = mod_dir / name
                    # Умная проверка для одиночных файлов (.scs и др.)
                    if self._is_asset_current(asset, manifest, target):
                        self.safe_log_colored(f"⏭ [АКТУАЛЬНО] {name} — версия совпадает с GitHub, пропуск.", "success")
                        self.sync_stats['skipped'] += 1
                    else:
                        if self.download_asset_chunked(asset, target):
                            # Для одиночных .scs считаем SHA-256 — нужно для verify_mod_integrity
                            self._mark_asset_installed(manifest, asset, installed_path=target)

                # === Финальная отметка статуса в ленте файлов ===
                # Логика: если файл попал в манифест после этой итерации — done,
                # если был в "skipped" — skipped, иначе error.
                if name in manifest and manifest[name].get("installed") and \
                   manifest[name].get("installed_at", "") and \
                   manifest[name]["installed_at"][:10] == datetime.now().strftime("%Y-%m-%d"):
                    self.after(0, self._file_row_set_status, name, "done")
                elif self._is_asset_current(asset, manifest, mod_dir / name) or \
                     self._is_asset_current(asset, manifest, AppConfig.TEMP_SYNC_DIR / name):
                    self.after(0, self._file_row_set_status, name, "skipped")
                else:
                    # Если ничего не сработало — оставляем в done с пометкой done
                    self.after(0, self._file_row_set_status, name, "done")

            # Сохраняем обновлённый манифест после прохода всех ассетов
            self._save_manifest(manifest)
            self.safe_log_colored("📋 Манифест установленных файлов сохранён.", "muted")

            _done_step("mods")

            # ── Этап 4: Профиль ──
            self.safe_log_colored(f"🔍 [PROFILE] mode={self.mode}, profile={self.selected_profile_sii}", "info")
            if self.mode == 'new' and self.selected_profile_sii:
                _do_step("profile")
                self.safe_log_colored("👤 Настройка файлов профиля...", "info")
                self.apply_mod_order()
                _done_step("profile")
            else:
                self.safe_log_colored(f"⚠️ [PROFILE] Пропуск: mode={self.mode}, profile={self.selected_profile_sii}", "warn")
                _done_step("profile", ok=False)

            # ── Этап 5: Очистка ──
            _do_step("cleanup")
            self.safe_log_colored("", "bold")
            self.safe_log_colored("🧹 Финальная очистка временных файлов...", "muted")
            try:
                # Удаляем временные файлы загрузки (архивы и т.п.)
                # НО сохраняем манифест и reference_profile_ext для умной проверки
                if AppConfig.TEMP_SYNC_DIR.exists():
                    preserved = {"installed_manifest.json"}
                    for item in list(AppConfig.TEMP_SYNC_DIR.iterdir()):
                        if item.name in preserved:
                            continue
                        try:
                            if item.is_dir():
                                shutil.rmtree(item, ignore_errors=True)
                            else:
                                item.unlink(missing_ok=True)
                        except Exception:
                            pass
                    self.safe_log_colored("✅ Временные файлы удалены (манифест сохранён)", "success")
            except Exception as clean_e:
                self.safe_log_colored(f"⚠️ Не удалось удалить temp_sync: {clean_e}", "warn")
            _done_step("cleanup")

            self.safe_log_colored("", "bold")
            self.safe_log_colored("🎉 УСТАНОВКА ЗАВЕРШЕНА!", "success")
            self.after(0, lambda: self._ui_sync_done(True, self.sync_stats))
            self.after(0, self._finish_sync_ui)

        except InterruptedError:
            # Пользовательская отмена через новую download_asset_chunked
            self.safe_log_colored("🛑 Установка прервана пользователем.", "warn")
            self.after(0, lambda: self._ui_sync_done(False, self.sync_stats))
            self.after(0, lambda: self._error_sync_ui(cancelled=True))
        except Exception as e:
            if "Отменено пользователем" in str(e):
                self.safe_log_colored("🛑 Установка прервана пользователем.", "warn")
                self.after(0, lambda: self._ui_sync_done(False, self.sync_stats))
                self.after(0, lambda: self._error_sync_ui(cancelled=True))
            else:
                log_error("sync_engine", e)
                self.safe_log_colored(f"❌ КРИТИЧЕСКАЯ ОШИБКА: {str(e)}", "error")
                self.after(0, lambda: self._ui_sync_done(False, self.sync_stats))
                self.after(0, lambda: self._error_sync_ui(cancelled=False))

            try:
                # При ошибке также очищаем temp, но не трогаем манифест
                if AppConfig.TEMP_SYNC_DIR.exists():
                    for item in list(AppConfig.TEMP_SYNC_DIR.iterdir()):
                        if item.name == "installed_manifest.json":
                            continue
                        try:
                            if item.is_dir():
                                shutil.rmtree(item, ignore_errors=True)
                            else:
                                item.unlink(missing_ok=True)
                        except Exception:
                            pass
            except Exception:
                pass

    def install_ready_profile(self, archive_path: Path):
        dest_base = get_profiles_dir()
        dest_base.mkdir(parents=True, exist_ok=True)

        # Распаковываем напрямую в папку профилей
        try:
            with py7zr.SevenZipFile(archive_path, mode='r') as z:
                z.extractall(path=dest_base)
            self.safe_log_colored("[PROFILE] Gotovyy profil raspakovan v " + str(dest_base), "success")
        except Exception as e:
            log_error("install_ready_profile", e)
            self.safe_log_colored("[ERROR] Ne udalos raspakovat profil: " + str(e), "error")

    def apply_mod_order_to_path(self, target_sii: Path, standalone=False, force_build_type=None):
        # Бэкап ДО любых операций (всегда — это «опасная» операция)
        backup_path = target_sii.with_suffix('.sii.bak')
        try:
            shutil.copy2(target_sii, backup_path)
            if not standalone:
                self.safe_log_colored(f"💾 [БЭКАП] Копия профиля сохранена ({backup_path.name})", "info")
        except Exception as e:
            log_error("apply_mod_order - backup", e)
            if not standalone:
                self.safe_log_colored(f"⚠️ [ОШИБКА] Не удалось сделать бэкап profile.sii: {e}", "error")

        # Умная дешифровка: сначала Python (без EXE), потом fallback на SII_Decrypt
        if not standalone:
            self.safe_log_colored("🔓 [ДЕШИФРОВКА] Чтение файла профиля...", "muted")
        if not self._decrypt_sii_smart(target_sii):
            msg = "❌ [ОШИБКА] Не удалось расшифровать профиль ни Python, ни EXE-дешифратором."
            if not standalone:
                self.safe_log_colored(msg, "error")
            else:
                messagebox.showerror(
                    "Дешифратор недоступен",
                    "Установите pycryptodome (pip install pycryptodome) или\n"
                    "добавьте папку программы в исключения антивируса.")
            return False

        ref_dir = self._ensure_reference_profile(force_build_type)
        if not ref_dir:
            msg = "❌ [ОШИБКА] Эталонный профиль недоступен"
            if not standalone:
                self.safe_log_colored(msg, "error")
            else:
                messagebox.showerror("Ошибка", msg)
            return False

        try:
            ref_path = next(ref_dir.rglob("profile.sii"))
        except StopIteration:
            msg = "❌ [ОШИБКА] Эталонный файл порядка модов не найден в скачанном архиве"
            if not standalone:
                self.safe_log_colored(msg, "error")
            else:
                messagebox.showwarning("Предупреждение", msg)
            return False

        # Эталонный профиль также расшифровываем — ОБЯЗАТЕЛЬНО проверяем результат!
        # Если эталон не расшифровался, у нас будут "мусорные" r_lines и
        # active_mods юзера будет заменён на пустой список (= удалится).
        if not self._decrypt_sii_smart(ref_path):
            msg = "❌ [ОШИБКА] Эталонный профиль не удалось расшифровать"
            if not standalone:
                self.safe_log_colored(msg, "error")
            else:
                messagebox.showerror(
                    "Ошибка эталона",
                    "Не удалось расшифровать эталонный profile.sii.\n"
                    "Профиль не изменён. Попробуйте ещё раз.")
            return False

        # Подчищаем legacy EXE если он использовался
        self._cleanup_sii_decrypt()

        u_lines = read_sii_safe(target_sii)
        r_lines = read_sii_safe(ref_path)

        if not u_lines or not r_lines:
            msg = "❌ [ОШИБКА] Невозможно прочитать файлы профиля"
            if not standalone: self.safe_log_colored(msg, "error")
            else: messagebox.showerror("Ошибка", "Чтение файлов конфигурации не удалось.")
            return False

        # === КРИТИЧЕСКАЯ ПРОВЕРКА: эталонный SII должен содержать active_mods ===
        r_mods = [l for l in r_lines if "active_mods[" in l or "active_mods:" in l]
        if not r_mods:
            # Если в эталоне нет active_mods — это значит файл повреждён,
            # либо это ЧИСТЫЙ профиль без модов. В обоих случаях НЕЛЬЗЯ
            # стирать active_mods у пользователя.
            msg = ("❌ [ОШИБКА] Эталонный profile.sii не содержит "
                   "active_mods — профиль не изменён.")
            if not standalone:
                self.safe_log_colored(msg, "error")
            else:
                messagebox.showerror(
                    "Эталон пуст",
                    "Эталонный profile.sii не содержит секции active_mods.\n"
                    "Профиль не изменён, чтобы не повредить вашу сборку.")
            return False

        # === Старая проверенная логика: берём active_mods из эталона
        # и заменяем в профиле пользователя ===
        final = []
        skip = False
        for line in u_lines:
            if "active_mods[" in line or "active_mods:" in line:
                if not skip:
                    final.extend(r_mods)
                    skip = True
                continue
            if skip and "active_mods" not in line:
                skip = False
            if not skip:
                final.append(line)

        try:
            with open(target_sii, 'w', encoding='utf-8') as f:
                f.writelines(final)
            if not standalone:
                self.safe_log_colored("✅ [СИНХРОНИЗАЦИЯ] Порядок модов успешно применен!", "success")
            else:
                messagebox.showinfo("Готово", "Правильный порядок модов применен к профилю.")
            return True
        except IOError as e:
            log_error("apply_mod_order - write", e)
            msg = f"❌ [ОШИБКА ЗАПИСИ]: {e}"
            if not standalone: self.safe_log_colored(msg, "error")
            else: messagebox.showerror("Сбой записи", "Не удалось сохранить файл профиля.")
            return False

    def apply_mod_order(self):
        self.apply_mod_order_to_path(self.selected_profile_sii, standalone=False)

