    def open_or_create_dir(self, path: Path):
        path.mkdir(parents=True, exist_ok=True)
        os.startfile(path)
        
    def clean_crash_dumps(self):
        doc_dir = get_my_documents() / "Euro Truck Simulator 2"
        files_to_remove = ["game.crash.txt", "game.log.bak"]
        removed = 0
        
        for f in files_to_remove:
            target = doc_dir / f
            if target.exists():
                try:
                    os.remove(target)
                    removed += 1
                except Exception as e:
                    log_error("clean_crash_dumps", e)
        
        if removed > 0:
            messagebox.showinfo("Готово", f"Успешно удалено {removed} файлов старых логов/дампов.")
        else:
            messagebox.showinfo("Чисто", "Критических дампов памяти не найдено. Удалять нечего.")

    def clean_screenshots(self):
        screen_dir = get_my_documents() / "Euro Truck Simulator 2" / "screenshot"
        if not screen_dir.exists() or not any(screen_dir.iterdir()):
            messagebox.showinfo("Чисто", "Папка со скриншотами уже пуста!")
            return
            
        if messagebox.askyesno("Очистка", "Вы уверены, что хотите удалить ВСЕ скриншоты? Это действие нельзя отменить."):
            try:
                shutil.rmtree(screen_dir)
                screen_dir.mkdir(parents=True, exist_ok=True)
                messagebox.showinfo("Готово", "Все скриншоты успешно удалены.")
            except Exception as e:
                log_error("clean_screenshots", e)
                messagebox.showerror("Ошибка", f"Не удалось очистить папку: {e}")

    def clean_plugins(self):
        if not self.game_path:
            messagebox.showerror("Ошибка", "Путь к игре не найден. Укажите его в левом нижнем углу меню.")
            return
            
        plugins_dir = self.game_path / "bin" / "win_x64" / "plugins"
        if not plugins_dir.exists() or not any(plugins_dir.iterdir()):
            messagebox.showinfo("Чисто", "У вас не установлены сторонние плагины. Очистка не требуется.")
            return
            
        if messagebox.askyesno("Удаление плагинов", "Это удалит все сторонние .dll файлы (например, телеметрию или TruckersMP) из игры.\nВы уверены?"):
            try:
                desktop = Path(os.path.expanduser("~")) / "Desktop"
                backup_dir = desktop / "ETS2_Plugins_Backup"
                shutil.copytree(plugins_dir, backup_dir, dirs_exist_ok=True)
                
                shutil.rmtree(plugins_dir)
                messagebox.showinfo("Готово", f"Плагины успешно удалены.\n\nКопия удаленных файлов сохранена на рабочем столе в папке 'ETS2_Plugins_Backup'.")
            except Exception as e:
                log_error("clean_plugins", e)
                messagebox.showerror("Ошибка", f"Не удалось удалить папку plugins: {e}")

