    def _save_all_settings(self):
        """Сохраняет все настройки со страницы Параметров."""
        final_args = []
        if getattr(self, 'arg_nointro', ctk.BooleanVar()).get(): final_args.append("-nointro")
        if getattr(self, 'arg_unlimitedlog', ctk.BooleanVar()).get(): final_args.append("-unlimitedlog")
        if getattr(self, 'arg_64bit', ctk.BooleanVar()).get(): final_args.append("-64bit")
        if hasattr(self, '_args_entry') and self._args_entry.get().strip():
            final_args.append(self._args_entry.get().strip())
        self.settings["launch_args"] = " ".join(final_args)
        if hasattr(self, 'direct_unpack_var'):
            self.settings["direct_unpack_mode"] = self.direct_unpack_var.get()
        if hasattr(self, '_max_backups_var'):
            self.settings["max_backups"] = int(self._max_backups_var.get())
            AppConfig.MAX_BACKUPS = self.settings["max_backups"]
        if hasattr(self, '_settings_theme_var'):
            self.settings["appearance"] = self._settings_theme_var.get()
            ctk.set_appearance_mode(self._settings_theme_var.get())
        if hasattr(self, '_settings_game_path') and self._settings_game_path.get():
            self.game_path = Path(self._settings_game_path.get())
            self.settings["game_path"] = str(self.game_path)
        self.save_settings()
        self.set_status("✅ Все параметры сохранены")
        messagebox.showinfo("Сохранено", "Все параметры успешно сохранены.")

