    def export_build(self):
        """Сохраняет JSON-файл со сборкой (моды + настройки) для друга."""
        path = filedialog.asksaveasfilename(
            defaultextension=".json",
            filetypes=[("Nexus Build", "*.json")],
            initialfile=f"nexus_build_{datetime.now():%Y%m%d}.json")
        if not path:
            return
        try:
            manifest = ManifestCache.get()
            # Извлекаем только полезные поля + имена файлов (без хешей)
            mods = []
            for name, entry in manifest.items():
                if not entry.get("installed", False):
                    continue
                mods.append({
                    "name": name,
                    "size": entry.get("size", 0),
                    "updated_at": entry.get("updated_at", ""),
                })

            # Текущий пресет графики (из config.cfg)
            game_cfg = {}
            try:
                game_cfg = self.read_game_config()
            except Exception:
                pass
            # Берём только релевантные ключи
            preset_keys = ["r_mode_width", "r_mode_height", "r_fullscreen",
                           "r_vsync", "r_mirror_view_distance",
                           "r_buffer_page_size", "g_traffic", "g_minicon",
                           "g_fps", "g_developer", "g_console"]
            graphics_preset = {k: v for k, v in game_cfg.items()
                                if k in preset_keys}

            bundle = {
                "format_version": 1,
                "exported_at": datetime.now().isoformat(),
                "exported_from": "Nexus",
                "nexus_version": AppConfig.PROGRAM_VERSION,
                "ets2_version_required": AppConfig.REQUIRED_VERSION,
                "settings": {
                    "launch_args": self.settings.get("launch_args", ""),
                    "nexus_theme": self.settings.get("nexus_theme",
                                                     "premium-dark"),
                },
                "mods": mods,
                "graphics_preset": graphics_preset,
            }
            Path(path).write_text(
                json.dumps(bundle, indent=2, ensure_ascii=False),
                encoding="utf-8")
            if hasattr(self, "toast"):
                self.toast.show(
                    f"Сборка экспортирована: {len(mods)} модов",
                    "success")
            SoundFX.play("success")
        except Exception as e:
            log_error("export_build", e)
            messagebox.showerror("Ошибка экспорта", str(e))

    def import_build(self):
        """Открывает файл сборки и предлагает применить."""
        path = filedialog.askopenfilename(
            filetypes=[("Nexus Build", "*.json"),
                       ("Все файлы", "*.*")])
        if not path:
            return
        try:
            data = json.loads(Path(path).read_text(encoding="utf-8"))
        except Exception as e:
            messagebox.showerror("Ошибка чтения",
                                  f"Не удалось прочитать файл: {e}")
            return

        if data.get("format_version") != 1:
            messagebox.showwarning(
                "Неизвестный формат",
                "Этот файл создан другой версией Nexus или повреждён.")
            return

        self._show_import_build_dialog(data, path)

