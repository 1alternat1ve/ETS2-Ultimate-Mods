    def _extract_profile_stats(self, sii_path: Path) -> Tuple[Optional[int], Optional[int]]:
        """Быстрая попытка достать money/xp из profile.sii. Не падает на ошибках."""
        try:
            text = sii_path.read_text(encoding="utf-8", errors="ignore")
            money_match = re.search(r"money_account:\s*(\d+)", text)
            xp_match = re.search(r"experience_points:\s*(\d+)", text)
            money = int(money_match.group(1)) if money_match else None
            xp = int(xp_match.group(1)) if xp_match else None
            return money, xp
        except Exception:
            return None, None

    def _extract_profile_full_stats(self, sii_path: Path) -> dict:
        """
        Полный набор статистики из profile.sii для Smart Save preview.
        Возвращает {money, xp, distance_truck_km, owned_trucks, etc}.
        """
        result = {
            "money": None,
            "xp": None,
            "distance_km": None,
            "trucks_owned": None,
            "garages": None,
            "drivers": None,
        }
        try:
            text = sii_path.read_text(encoding="utf-8", errors="ignore")
            # Деньги, опыт
            m = re.search(r"money_account:\s*(\d+)", text)
            if m: result["money"] = int(m.group(1))
            m = re.search(r"experience_points:\s*(\d+)", text)
            if m: result["xp"] = int(m.group(1))
            # Километраж — сумма distance_offroad/highway/local
            total_dist = 0
            for fld in ["truck_odometer", "distance_truck",
                          "distance_truck_total", "distance"]:
                m = re.search(rf"{fld}:\s*(\d+)", text)
                if m:
                    total_dist = max(total_dist, int(m.group(1)))
            if total_dist > 0:
                # Heuristic: значение в метрах → переводим в км
                result["distance_km"] = total_dist / 1000.0
            # Грузовики (по количеству строк vehicle:)
            trucks = re.findall(r"vehicle\s*:\s*[a-z0-9_.]+\s*\{", text)
            if trucks:
                result["trucks_owned"] = len(trucks)
            # Гаражи
            garages = re.findall(r"garage\s*:\s*[a-z0-9_.]+\s*\{", text)
            if garages:
                result["garages"] = len(garages)
        except Exception:
            pass
        return result

    def _get_profile_screenshots(self, profile_path: Path,
                                   max_count: int = 4) -> List[Path]:
        """
        Возвращает последние N скриншотов из ETS2 screenshot/ директории.
        Это общая папка для всех профилей — выбираем по mtime.
        """
        screen_dir = get_my_documents() / "Euro Truck Simulator 2" / "screenshot"
        if not screen_dir.exists():
            return []
        try:
            screenshots = sorted(
                screen_dir.glob("*.jpg"),
                key=lambda p: p.stat().st_mtime, reverse=True)
            screenshots.extend(sorted(
                screen_dir.glob("*.png"),
                key=lambda p: p.stat().st_mtime, reverse=True))
            return screenshots[:max_count]
        except Exception:
            return []

