@dataclass
class GitHubAsset:
    """Один файл из релиза GitHub."""
    name: str
    size: int
    updated_at: str
    download_url: str
    sha256: Optional[str] = None

    @classmethod
    def from_api(cls, raw: dict) -> "GitHubAsset":
        return cls(
            name=raw.get("name", ""),
            size=int(raw.get("size", 0) or 0),
            updated_at=raw.get("updated_at", ""),
            download_url=raw.get("browser_download_url", ""),
        )

    def to_legacy_dict(self) -> dict:
        """Совместимость со старым кодом, который ожидает 'browser_download_url'."""
        return {
            "name": self.name,
            "size": self.size,
            "updated_at": self.updated_at,
            "browser_download_url": self.download_url,
        }


